---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import CabeceraFicha from '../../components/CabeceraFicha.astro';
import IndicatorChart from '../../components/IndicatorChart.astro';
import PanelIndicador from '../../components/PanelIndicador.astro';
import Newsletter from '../../components/Newsletter.astro';

import { indicators, byCategory, categoryName, ETIQUETA, higherIsBetter, type Indicator } from '../../lib/indicators';
import { longDate, num, periodoCorto, periodoRef } from '../../lib/format';
import { withBase } from '../../lib/url';
import { site } from '../../site.config';

export const getStaticPaths: GetStaticPaths = () =>
  indicators.map((ind) => ({ params: { id: ind.id }, props: { ind } }));

const { ind } = Astro.props as { ind: Indicator };

const related = byCategory(ind.category)
  .filter((i) => i.id !== ind.id)
  .slice(0, 4);

const suffix = ind.unit === '%' || ind.unit === '% PIB' ? '%' : '';
const prefix = ind.unit === 'Bs' ? 'Bs ' : '';

const clase = ind.kind === 'oficial' ? 'Fuente oficial' : ETIQUETA[ind.kind];
const inicio = ind.history[0]?.d ?? ind.date;
const conUnidadAparte = suffix === '' && prefix === '';
const cifra = (v: number): string => `${prefix}${num(v, ind.decimals)}${suffix}`;

const publicacion = ind.related
  ? (await getCollection('publicaciones')).find((p) => p.id === ind.related)
  : undefined;

const periodoDe = (iso: string): string => periodoCorto(iso, ind.frequency);
const llevaEl = (p: string): boolean => /^(I{1,3}|IV)\s/.test(p) || /^\d{1,2}[\s/]/.test(p);
const aP = (p: string): string => `${llevaEl(p) ? 'al' : 'a'} ${p}`;

const anterior = ind.history.at(-2);
const delta = anterior ? ind.value - anterior.v : 0;
const plano = Math.abs(delta) < 0.5 / 10 ** ind.decimals;
const sube = delta >= 0;
const tono: 'es-plano' | 'es-bueno' | 'es-malo' = plano ? 'es-plano' : sube === higherIsBetter(ind.id) ? 'es-bueno' : 'es-malo';
const flecha = plano ? '—' : sube ? '▲' : '▼';
const cambio = plano ? 'sin cambio' : `${num(Math.abs(delta), ind.decimals)} ${ind.changeUnit}`;
const contra = anterior ? `respecto ${aP(periodoDe(anterior.d))}` : '';

const aMedioDia = (iso: string): number => Date.parse(`${iso.slice(0, 10)}T12:00:00Z`);
const objetivo = new Date(aMedioDia(ind.date));
objetivo.setUTCMonth(objetivo.getUTCMonth() - 12);
const holgura = 12 * 30 * 86_400_000 * 0.4;
const haceUnAnio = ind.history
  .filter((p) => p.d < ind.date && Math.abs(aMedioDia(p.d) - objetivo.getTime()) <= holgura)
  .sort((a, b) => Math.abs(aMedioDia(a.d) - objetivo.getTime()) - Math.abs(aMedioDia(b.d) - objetivo.getTime()))[0];

const maximo = ind.history.reduce((a, p) => (p.v > a.v ? p : a), ind.history[0] ?? { d: ind.date, v: ind.value });
const minimo = ind.history.reduce((a, p) => (p.v < a.v ? p : a), ind.history[0] ?? { d: ind.date, v: ind.value });

const unidadAparte = conUnidadAparte ? ind.unit : undefined;

const dato = {
  rotulo: `Último dato · ${periodoRef(ind.date, ind.frequency)}`,
  valor: cifra(ind.value),
  unidad: unidadAparte,
  cambio: anterior ? { texto: `${flecha} ${cambio}`, tono, contra } : undefined,
  nota:
    ind.ciLow !== undefined && ind.ciHigh !== undefined
      ? `Intervalo de confianza: ${num(ind.ciLow, ind.decimals)} a ${num(ind.ciHigh, ind.decimals)}`
      : undefined,
};

const cifras = [
  { rotulo: 'Máximo', valor: cifra(maximo.v), unidad: unidadAparte, nota: periodoDe(maximo.d) },
  { rotulo: 'Mínimo', valor: cifra(minimo.v), unidad: unidadAparte, nota: periodoDe(minimo.d) },
  ...(haceUnAnio
    ? [{ rotulo: 'Hace un año', valor: cifra(haceUnAnio.v), unidad: unidadAparte, nota: periodoDe(haceUnAnio.d) }]
    : []),
  { rotulo: 'Observaciones', valor: num(ind.history.length, 0), nota: ind.frequency },
  { rotulo: 'Cobertura', valor: periodoDe(inicio), nota: `a ${periodoDe(ind.date)}`, texto: true },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: ind.name,
  description: ind.description,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  creator: { '@type': 'Organization', name: site.legalName },
  temporalCoverage: `${ind.history[0]?.d ?? ''}/${ind.date}`,
  variableMeasured: { '@type': 'PropertyValue', name: ind.name, unitText: ind.unit },
  isAccessibleForFree: true,
};
---

<BaseLayout
  title={ind.name}
  description={ind.description}
  jsonLd={jsonLd}
>
  <CabeceraFicha
    parent={{ label: 'Atlas Económico', href: '/atlas' }}
    etiquetas={[
      { texto: categoryName(ind.category), tono: 'tipo' },
      { texto: clase, tono: ind.own ? 'oro' : 'apagada' },
    ]}
    title={ind.name}
    linea={`${ind.source} · actualizado el ${longDate(ind.updated)}`}
    dato={dato}
    cifras={cifras}
  >
    {publicacion && (
      <p class="ind-pub">
        <span class="ind-pub-rotulo">Publicación asociada</span>
        <a href={withBase(`/publicaciones/${publicacion.id}`)} class="ind-pub-enlace">
          <span class="link-underline">{publicacion.data.title}</span>
          <svg class="arw" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M2 8h11M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </p>
    )}
  </CabeceraFicha>

  <!-- GRÁFICO -------------------------------------------------------------- -->
  <section class="surface-light section" aria-labelledby="serie">
    <div class="wrap">
      <h2 id="serie" class="eyebrow eyebrow-gold block-h" data-reveal>Serie histórica</h2>

      <div data-reveal>
        <IndicatorChart
          id={ind.id}
          name={ind.name}
          unit={ind.unit}
          decimals={ind.decimals}
          history={ind.history}
          own={ind.own}
          source={ind.source}
          height={420}
        />
      </div>
    </div>
  </section>

  <!-- RELACIONADOS ---------------------------------------------------------- -->
  {
    related.length > 0 && (
      <section class="surface-mist section rel-seccion edge-tr" aria-labelledby="relacionados">
        <div class="wrap">
          <div class="rel-cabeza">
            <p class="eyebrow eyebrow-gold" data-reveal>Atlas Económico</p>
            <h2 id="relacionados" class="display-3 rel-title" data-reveal>
              Más de {categoryName(ind.category).toLowerCase()}
            </h2>
          </div>
          <div class="rel-grid" data-reveal-group data-reveal-stagger="0.06">
            {related.map((item) => <PanelIndicador item={item} size="tercio" />)}
          </div>
        </div>
      </section>
    )
  }

  <Newsletter />
</BaseLayout>

<style>
  .ind-pub {
    display: grid;
    justify-items: center;
    gap: 8px;
    margin: 26px auto 0;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    max-width: 46ch;
    text-align: center;
  }
  .ind-pub-rotulo {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-teal-300);
  }
  .ind-pub-enlace {
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-paper);
  }
  .ind-pub-enlace .arw {
    display: inline-block;
    margin-left: 8px;
    vertical-align: -1px;
    color: var(--color-gold);
    transition: transform 240ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .ind-pub-enlace:hover .arw { transform: translateX(5px); }

  .block-h { display: block; margin-bottom: 16px; }

  .rel-seccion { padding-block: clamp(56px, 7vw, 96px); }
  .rel-cabeza {
    display: grid;
    justify-items: center;
    gap: 12px;
    margin-bottom: clamp(28px, 3.4vw, 44px);
    text-align: center;
  }
  .rel-title { font-size: clamp(1.7rem, 2.8vw, 2.4rem); }
  .rel-grid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }
</style>
