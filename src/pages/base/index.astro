---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Newsletter from '../../components/Newsletter.astro';
import MapaSectores from '../../components/MapaSectores.astro';
import { covers } from '../../site.config';

/**
 * Base de Datos Profesional — la portada.
 *
 * Aquí empieza la capa profesional del Atlas, y es solo la puerta: qué
 * sectores hay y qué contesta cada uno. El catálogo no se vuelca entero en
 * esta página; cada tarjeta lleva a la del sector, donde están sus series con
 * su buscador, y desde cada fila se baja a la ficha con el histórico. Tres
 * escalones, uno por decisión: qué materia, qué serie, qué dato.
 *
 * Abre con portada a sangre como el resto de las secciones. Las cifras de
 * cabecera y el aviso de acceso que iban aquí se retiraron: contaban el
 * inventario antes de que nadie hubiera preguntado nada.
 */---

{/* `bleed`: la cabecera lleva imagen a sangre, así que el header arranca
    transparente sobre ella y el contenido no reserva sitio para él. */}
<BaseLayout
  title="Base de Datos Profesional"
  description="El catálogo completo de series económicas del CIDEF, sector por sector: oficiales, estimaciones propias y proyecciones, con su frecuencia, su fuente y su último dato."
  noindex
  bleed
>
  <PageHero
    eyebrow="Base de Datos Profesional"
    title="Toda la serie, no solo el último dato"
    lede="El tablero del Atlas enseña una selección de cada sector. Aquí está el catálogo entero: qué series existen, qué mide cada una, cada cuánto se publica y hasta dónde llega."
    parent={{ label: 'Atlas Económico', href: '/atlas' }}
    cover={covers.atlas}
  />

  <!-- EL MAPA DE SECTORES ---------------------------------------------------- -->
  <section class="surface-light section" aria-labelledby="mapa">
    <div class="wrap">
      <MapaSectores titulo="Todas las series, sector por sector" />
    </div>
  </section>

  <Newsletter />
</BaseLayout>
