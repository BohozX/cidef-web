---
import TarjetaSector from './TarjetaSector.astro';
import { sectores } from '../lib/indicators';

/**
 * El mapa de la base: qué sectores hay y por dónde se entra a cada uno.
 *
 * Cada sector entra por su imagen. Antes la tarjeta lo contaba todo —nombre,
 * pregunta, descripción y la lista entera de materias— y diez tarjetas así
 * son diez párrafos: se leían como un índice, no como una puerta. Ahora la
 * imagen ocupa la tarjeta y encima solo va el sector; lo demás espera dentro,
 * en su página, que es donde sirve.
 *
 * Las imágenes no llevan texto: las genera `tools/sectores.mjs` a partir de
 * una fotografía dejada en `.design/sectores/<id>.jpg` o, mientras no la haya,
 * de un dibujo con el icono y el color del sector.
 */

export interface Props {
  titulo?: string;
}

const { titulo } = Astro.props;

const lista = sectores();

/* En un titular, un número de dos cifras se lee como dato y no como parte de
   la frase. */
const LETRAS = ['cero', 'uno', 'dos', 'tres', 'cuatro', 'cinco', 'seis', 'siete', 'ocho', 'nueve', 'diez', 'once', 'doce'];
const enLetra = (n: number): string => LETRAS[n] ?? String(n);

const encabezado = titulo ?? `La economía boliviana, repartida en ${enLetra(lista.length)} sectores`;

/* La de cierre ocupa la fila entera; las demás, un tercio largo. */
const MEDIDAS = '(min-width: 1100px) 34vw, (min-width: 680px) 50vw, 94vw';
const MEDIDAS_ANCHA = '100vw';
---

<div class="mapa-head">
  <h2 id="mapa" class="display-3 mapa-title" data-reveal>{encabezado}</h2>
</div>

<ul class="mapa-grid" data-reveal-group data-reveal-stagger="0.05">
  {
    lista.map((s, i) => {
      /* La ultima se ensancha solo cuando le tocaria abrir fila ella sola.
         Con un numero de sectores multiplo de la rejilla, ensancharla dejaba
         un hueco en la fila anterior en vez de cerrar nada. */
      const cierre = i === lista.length - 1 && (lista.length - 1) % 3 === 0;
      return (
        <li class:list={[cierre && 'es-cierre']} data-reveal>
          <TarjetaSector
            sector={s}
            numero={String(i + 1).padStart(2, '0')}
            medidas={cierre ? MEDIDAS_ANCHA : MEDIDAS}
          />
        </li>
      );
    })
  }
</ul>

<style>
  /* Solo el título, centrado y a todo el ancho. Iba en una rejilla de dos
     columnas con un párrafo de entrada al lado, y encerrado en veinte
     caracteres: se partía en dos renglones cortos dentro de un tercio de la
     pantalla mientras el resto quedaba vacío. */
  .mapa-head {
    padding-bottom: clamp(30px, 3.6vw, 48px);
    text-align: center;
  }
  .mapa-title {
    max-width: none;
    margin-inline: auto;
  }

  /* --- las tarjetas ------------------------------------------------------ */
  .mapa-grid {
    display: grid;
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
    grid-template-columns: 1fr;
  }
  @media (min-width: 680px) { .mapa-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .mapa-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  /* La última tarjeta cierra la fila en vez de quedarse sola: los
     indicadores del centro no son un sector más de la economía, son lo que
     produce el CIDEF, y ocupar el ancho entero lo dice sin decirlo. */
  .mapa-grid > .es-cierre { grid-column: 1 / -1; }
  @media (min-width: 900px) {
    .mapa-grid > .es-cierre :global(.tsec) { min-height: 240px; }
  }
</style>
