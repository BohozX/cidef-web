---
import PanelIndicador from './PanelIndicador.astro';
import PanelDona from './PanelDona.astro';
import IconoSector from './IconoSector.astro';
import { byId, categories, SECTORES, type Indicator } from '../lib/indicators';

/**
 * Los tableros del Atlas: el panorama y uno por sector.
 *
 * Cada tablero está compuesto a mano, no repartido por una regla automática.
 * Un sector no es una lista de series: tiene una que abre —la que contesta la
 * pregunta del sector— dos que la matizan, y, donde el dato es un reparto y
 * no una serie en el tiempo, una dona de composición que cierra el rectángulo.
 *
 * Todos se generan al compilar y se alternan ocultando y mostrando: cambiar
 * de sector no recarga la página ni pide datos.
 */

type Tamano = 'grande' | 'medio' | 'chico' | 'ancho' | 'tercio' | 'cifra';
type Pieza = { id: string; size: Tamano };

type Tablero = {
  id: string;
  nombre: string;
  descripcion?: string;
  piezas: Pieza[];
  /** Serie cuya composición se muestra en dona, si la tiene. */
  dona?: string;
};

const TABLEROS: Tablero[] = [
  {
    id: 'panorama',
    nombre: 'Panorama',
    piezas: [
      { id: 'pib-trimestral', size: 'grande' },
      { id: 'inflacion-interanual', size: 'medio' },
      { id: 'tipo-cambio', size: 'medio' },
      { id: 'reservas-internacionales', size: 'chico' },
      { id: 'credito-privado', size: 'chico' },
      { id: 'desocupacion', size: 'chico' },
      { id: 'saldo-comercial', size: 'ancho' },
      { id: 'nowcast-pib', size: 'tercio' },
      { id: 'indice-incertidumbre', size: 'tercio' },
      { id: 'inflacion-esperada', size: 'tercio' },
    ],
  },
  {
    id: 'actividad',
    nombre: 'Actividad económica',
    piezas: [
      { id: 'imae', size: 'grande' },
      { id: 'pib-trimestral', size: 'medio' },
      { id: 'industria', size: 'medio' },
    ],
    dona: 'imae',
  },
  {
    id: 'precios',
    nombre: 'Precios e inflación',
    piezas: [
      { id: 'inflacion-interanual', size: 'grande' },
      { id: 'inflacion-nucleo', size: 'medio' },
      { id: 'inflacion-alimentos', size: 'medio' },
    ],
    dona: 'inflacion-interanual',
  },
  {
    id: 'monetario',
    nombre: 'Monetario y financiero',
    piezas: [
      { id: 'credito-privado', size: 'grande' },
      { id: 'depositos', size: 'medio' },
      { id: 'tasa-activa', size: 'medio' },
    ],
    dona: 'credito-privado',
  },
  {
    /* El mercado cambiario abre con el paralelo y no con el oficial: es la
       cotización a la que efectivamente se opera, y la que explica la brecha
       que va debajo. */
    id: 'cambiario',
    nombre: 'Mercado cambiario',
    piezas: [
      { id: 'tipo-cambio-paralelo', size: 'grande' },
      { id: 'tipo-cambio', size: 'medio' },
      { id: 'brecha-cambiaria', size: 'medio' },
    ],
    dona: 'volumen-p2p',
  },
  {
    id: 'externo',
    nombre: 'Sector externo',
    piezas: [
      { id: 'reservas-internacionales', size: 'grande' },
      { id: 'saldo-comercial', size: 'medio' },
      { id: 'exportaciones', size: 'medio' },
    ],
    dona: 'exportaciones',
  },
  {
    id: 'fiscal',
    nombre: 'Sector fiscal',
    piezas: [
      { id: 'resultado-fiscal', size: 'grande' },
      { id: 'recaudacion', size: 'medio' },
      { id: 'deuda-publica', size: 'medio' },
    ],
    dona: 'resultado-fiscal',
  },
  {
    /* Empleo y pobreza en un solo tablero. El trabajo abre —es la variable
       que se mueve cada trimestre— y las condiciones de vida cierran, que se
       miden una vez al año y se leen mirando atrás.

       Sin dona: las seis series llenan tres filas exactas y la composición
       habría abierto una cuarta a medias. */
    id: 'laboral',
    nombre: 'Estadísticas sociales',
    piezas: [
      { id: 'desocupacion', size: 'grande' },
      { id: 'informalidad', size: 'medio' },
      { id: 'salario-minimo', size: 'medio' },
      { id: 'pobreza', size: 'medio' },
      { id: 'pobreza-extrema', size: 'medio' },
      { id: 'gini', size: 'ancho' },
    ],
  },
  {
    id: 'internacional',
    nombre: 'Economía internacional',
    piezas: [
      { id: 'petroleo-brent', size: 'grande' },
      { id: 'oro', size: 'medio' },
      { id: 'dxy', size: 'medio' },
    ],
    dona: 'dxy',
  },
  {
    id: 'centro',
    nombre: 'Indicadores del Centro',
    piezas: [
      { id: 'nowcast-pib', size: 'grande' },
      { id: 'indice-incertidumbre', size: 'medio' },
      { id: 'inflacion-esperada', size: 'medio' },
    ],
    dona: 'indice-incertidumbre',
  },
];

/* El orden del tablero es el del mapa de sectores: la barra de pestañas y el
   menú tienen que recorrerse igual. */
const orden = (id: string): number => {
  const i = (SECTORES as readonly string[]).indexOf(id);
  return i === -1 ? 99 : i;
};

const descripcion = (id: string): string | undefined =>
  categories.find((c) => c.id === id)?.description;

export interface Props {
  solo?: string;
}

const { solo } = Astro.props;

const tableros = [...TABLEROS]
  .filter((t) => !solo || t.id === solo)
  .sort((a, b) => orden(a.id) - orden(b.id))
  .map((t) => ({
    ...t,
    descripcion: t.id === 'panorama' ? undefined : descripcion(t.id),
    piezas: t.piezas
      .map((p) => ({ ...p, item: byId(p.id) }))
      .filter((p): p is Pieza & { item: Indicator } => Boolean(p.item)),
  }));

/* --- como se reparte la barra de sectores -------------------------------
   Los once sectores no caben en un renglon. Antes la barra se desplazaba en
   horizontal y los ultimos quedaban fuera de la vista: habia que arrastrar
   para descubrir que existian, y el borde cortado hacia parecer que la barra
   estaba mal cuadrada.

   Ahora se parte en dos renglones y se ven todos a la vez. El corte no cae
   donde quepa: se reparte a la mitad --seis arriba, cinco abajo-- y cada
   renglon se justifica de extremo a extremo repartiendo un mismo numero de
   columnas entre sus pestanas. Por eso la rejilla lleva el minimo comun
   multiplo de las dos cuentas: es el unico ancho de columna con el que las
   dos filas terminan exactamente en el mismo punto. */
const n = tableros.length;
const fila1 = Math.ceil(n / 2);
const fila2 = n - fila1;
const mcd = (a: number, b: number): number => (b === 0 ? a : mcd(b, a % b));
const columnas = fila2 > 0 ? (fila1 * fila2) / mcd(fila1, fila2) : fila1;
const columnasDe = (i: number): number => (i < fila1 ? columnas / fila1 : columnas / fila2);

---

{!solo && (
<>
<div id="tableros" class="sector-rail no-print">
  {/* Entran una tras otra, en el orden en que se recorren: el carril
      completo apareciendo de golpe no decía que fueran once cosas. */}
  <div
    class="tab-sectores"
    role="tablist"
    aria-label="Sectores del Atlas"
    style={`--cols:${columnas}`}
    data-reveal-group
    data-reveal-stagger="0.035"
  >
    {
      tableros.map((t, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${t.id}`}
          class:list={['tab-sector', i === 0 && 'is-on']}
          data-tablero={t.id}
          data-sector={t.id}
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`panel-${t.id}`}
          tabindex={i === 0 ? 0 : -1}
          style={`--span:${columnasDe(i)}`}
          data-reveal
        >
          <IconoSector id={t.id} class="tab-ico" />
          <span class="tab-nombre">{t.nombre}</span>
        </button>
      ))
    }
  </div>
</div>

{/* Una sola fila de controles encima de los tableros, no uno por tarjeta:
    lo que se elige aquí vale para todas las piezas, y así las cifras de un
    mismo tablero siempre se leen a la misma distancia. */}
<div class="tablero-barra no-print" data-reveal-group data-reveal-stagger="0.05">
  <div class="tb-mando">
    {/* Sin rótulo delante: las cuatro opciones se leen solas —«un mes», «un
        año»— y el nombre del control solo repetía en mayúsculas lo que la
        propia tarjeta ya escribe debajo de cada cifra. Para quien navega con
        lector de pantalla el grupo sigue teniendo nombre. */}
    {/* Los nombres de la frecuencia con que se mide la variación, que es
        como se la nombra en cualquier informe: la variación mensual, la
        trimestral y la interanual. «Un mes» describía una distancia en el
        calendario, no la medida. */}
    <div class="tb-grupo" role="group" aria-label="Frecuencia con la que se mide la variación">
      <button type="button" class="tb-op is-on" data-horizonte="mes" aria-pressed="true" data-reveal>
        Mensual
      </button>
      <button type="button" class="tb-op" data-horizonte="trimestre" aria-pressed="false" data-reveal>
        Trimestral
      </button>
      <button type="button" class="tb-op" data-horizonte="anio" aria-pressed="false" data-reveal>
        Anual
      </button>
    </div>
  </div>
</div>
</>
)}

{
  tableros.map((t, i) => (
    <div
      class="tab-panel"
      role={solo ? undefined : 'tabpanel'}
      id={`panel-${t.id}`}
      aria-labelledby={solo ? undefined : `tab-${t.id}`}
      tabindex={solo ? undefined : '0'}
      data-panel={t.id}
      hidden={i !== 0}
    >
      {t.descripcion && <p class="tab-desc muted">{t.descripcion}</p>}

      <div class="tablero">
        {t.piezas.map((p) => (
          <PanelIndicador item={p.item} size={p.size} />
        ))}
        {t.dona && <PanelDona id={t.dona} size="medio" />}
      </div>
    </div>
  ))
}

<script>
  /* Cambiar de sector es mostrar y ocultar: los tableros ya vienen armados
     desde el servidor, así que el cambio es inmediato. */
  const botones = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tablero]'));
  const paneles = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));

  const abrir = (destino: string): boolean => {
    const boton = botones.find((b) => b.dataset.tablero === destino);
    if (!boton) return false;
    paneles.forEach((p) => {
      p.hidden = p.dataset.panel !== destino;
    });
    botones.forEach((otro) => {
      const activo = otro === boton;
      otro.classList.toggle('is-on', activo);
      otro.setAttribute('aria-selected', String(activo));
      /* Una sola parada de tabulador en toda la barra: dentro se recorre con
         las flechas, como cualquier control de pestañas. */
      otro.tabIndex = activo ? 0 : -1;
    });
    /* La barra de pestañas se desplaza en horizontal: si el sector elegido
       queda fuera de la vista, el usuario no ve cuál quedó activo. */
    boton.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
    return true;
  };

  botones.forEach((b) => b.addEventListener('click', () => abrir(b.dataset.tablero!)));

  /* Flechas para moverse entre sectores, inicio y fin para ir a los extremos. */
  const PASOS: Record<string, number> = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 };
  botones.forEach((b) =>
    b.addEventListener('keydown', (e) => {
      const actual = botones.indexOf(b);
      let destino = -1;
      if (e.key in PASOS) destino = (actual + PASOS[e.key]! + botones.length) % botones.length;
      else if (e.key === 'Home') destino = 0;
      else if (e.key === 'End') destino = botones.length - 1;
      if (destino === -1) return;
      e.preventDefault();
      abrir(botones[destino]!.dataset.tablero!);
      botones[destino]!.focus();
    }),
  );

  /* Los enlaces del mapa de sectores abren su tablero y bajan hasta él. */
  document.querySelectorAll<HTMLElement>('[data-ir-sector]').forEach((enlace) =>
    enlace.addEventListener('click', (e) => {
      const destino = enlace.dataset.irSector!;
      if (!abrir(destino)) return;
      e.preventDefault();
      history.replaceState(null, '', `#sector-${destino}`);
      document.getElementById('tableros')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }),
  );

  /* --- con qué frecuencia se mide la variación ---------------------------
     Las tres lecturas ya vienen escritas en cada tarjeta: elegir una es leer
     otro atributo, no recalcular ni pedir nada. */
  const opciones = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-horizonte]'));
  const variaciones = Array.from(document.querySelectorAll<HTMLElement>('[data-pi-var]'));
  const SIGNOS = ['es-bueno', 'es-malo', 'es-plano'];
  const clave = (h: string) => `h${h.charAt(0).toUpperCase()}${h.slice(1)}`;

  type Lectura = { flecha: string; texto: string; contra: string; clase: string };

  const escribir = (v: HTMLElement, l: Lectura) => {
    const puesto = (sel: string, txt: string | undefined) => {
      const el = v.querySelector(sel);
      if (el && txt !== undefined) el.textContent = txt;
    };
    puesto('.pi-flecha', l.flecha);
    puesto('.pi-delta', l.texto);
    puesto('.pi-contra', l.contra);
    v.classList.remove(...SIGNOS);
    if (l.clase) v.classList.add(l.clase);
  };

  const marcar = (horizonte: string) => {
    opciones.forEach((o) => {
      const activo = o.dataset.horizonte === horizonte;
      o.classList.toggle('is-on', activo);
      o.setAttribute('aria-pressed', String(activo));
    });
  };

  const medirDesde = (horizonte: string) => {
    variaciones.forEach((v) => {
      /* Si la serie no llega a ese horizonte se cae a la comparación con la
         observación anterior: la tarjeta siempre dice contra qué compara, así
         que nunca queda una cifra sin explicar. */
      const crudo = v.dataset[clave(horizonte)] ?? v.dataset.hDef;
      if (!crudo) return;
      const [flecha, texto, contra, clase] = crudo.split('|');
      escribir(v, {
        flecha: flecha ?? '',
        texto: texto ?? '',
        contra: contra ?? '',
        clase: clase ?? '',
      });
    });
    marcar(horizonte);
  };

  opciones.forEach((o) => o.addEventListener('click', () => medirDesde(o.dataset.horizonte!)));

  /* Un enlace externo puede apuntar a un sector concreto: /atlas#sector-fiscal. */
  const desdeElHash = () => {
    const m = location.hash.match(/^#sector-([a-z-]+)$/);
    if (m) abrir(m[1]);
  };
  desdeElHash();
  window.addEventListener('hashchange', desdeElHash);
</script>

<style>
  /* --- navegación por sector --------------------------------------------
     Una barra de pestañas, no once botones sueltos. Las píldoras flotaban
     sobre el fondo y no se veía a qué pertenecían; ahora se apoyan sobre una
     línea continua que las ata al tablero de abajo, y la pestaña abierta se
     marca subrayándose con el color de su propio sector. El punto de color
     repite ese código en las cerradas: al recorrer la barra ya se sabe de qué
     color va a venir cada tablero.

     Ninguna superficie se tiñe —ni la pestaña ni la tarjeta—: el color vive
     en el trazo y en la línea, que es donde significa algo. */
  .sector-rail {
    position: relative;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--line, var(--line-light));
    scroll-margin-top: 96px;
  }

  /* Las once pestañas se ven todas a la vez, repartidas en dos renglones.
     Antes la barra se desplazaba en horizontal: los últimos sectores queda-
     ban fuera de la vista y el corte a media palabra en el borde derecho
     hacía parecer que la barra estaba mal cuadrada. El componente reparte
     las columnas para que los dos renglones terminen en el mismo punto. */
  .tab-sectores {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0;
    /* El subrayado de la activa se monta sobre la línea del carril. */
    margin-bottom: -1px;
  }

  .tab-sector {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    flex: 0 1 auto;
    min-width: 0;
    padding: 10px 13px 11px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 12.5px;
    font-weight: 500;
    line-height: 1.25;
    white-space: nowrap;
    cursor: pointer;
    transition: color 200ms ease, border-color 200ms ease, background-color 200ms ease;
  }
  .tab-nombre { overflow: hidden; text-overflow: ellipsis; }

  /* Desde que caben seis en un renglón, la barra se cuadra: dos filas
     justificadas de extremo a extremo con el reparto que calcula el
     componente. Por debajo de ese ancho se envuelve centrada, que es lo que
     mejor aguanta tres o cuatro renglones. */
  @media (min-width: 1180px) {
    .tab-sectores {
      display: grid;
      grid-template-columns: repeat(var(--cols, 30), minmax(0, 1fr));
    }
    .tab-sector { grid-column: span var(--span, 5); }
  }

  .tab-sector:hover {
    color: inherit;
    background: color-mix(in srgb, var(--color-ink) 4%, transparent);
  }
  .tab-sector:focus-visible {
    outline: 2px solid var(--serie);
    outline-offset: -3px;
    color: inherit;
  }
  .tab-sector.is-on { color: inherit; font-weight: 600; }

  /* El icono lleva el color del sector y dibuja su materia: encendido en la
     pestaña abierta, atenuado en las demás. El nombre sigue al lado, así que
     ni el color ni el dibujo son nunca el único canal. */
  .tab-sector :global(.tab-ico) {
    color: var(--serie);
    opacity: 0.5;
    transition: opacity 200ms ease, transform 260ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .tab-sector:hover :global(.tab-ico) { opacity: 0.82; transform: translateY(-1px) scale(1.09); }
  .tab-sector.is-on :global(.tab-ico) { opacity: 1; }

  @media (max-width: 560px) {
    .tab-sector { padding: 9px 10px 10px; font-size: 12px; gap: 6px; }
  }

  .tab-panel:focus-visible { outline: none; }

  /* Cambiar de sector no recarga nada: los tableros ya están armados y solo
     se muestran y se ocultan. Sin transición el cambio era un salto seco de
     una cuadrícula a otra; con esta entrada se entiende que llegó un tablero
     nuevo. La animación se reinicia sola cada vez que el panel pasa de
     oculto a visible, sin una línea de JavaScript. */
  @keyframes tab-entra {
    from { opacity: 0; transform: translateY(9px); }
    to { opacity: 1; transform: none; }
  }
  .tab-panel:not([hidden]) {
    animation: tab-entra 400ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }

  /* El subrayado de la pestaña abierta crece desde el centro en vez de
     encenderse de golpe. */
  .tab-sector::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--serie);
    opacity: 0;
    transform: scaleX(0.3);
    transition: transform 280ms cubic-bezier(0.22, 0.61, 0.36, 1), opacity 220ms ease;
  }
  /* Al pasar por encima el subrayado se insinúa en el color del sector: se
     ve de antemano de qué color va a venir el tablero antes de abrirlo. */
  .tab-sector:hover::after { opacity: 0.4; transform: scaleX(1); }
  .tab-sector.is-on::after { opacity: 1; transform: scaleX(1); }

  @media (prefers-reduced-motion: reduce) {
    .tab-panel:not([hidden]) { animation: none; }
    .tab-sector::after,
    .tb-op::after,
    .tab-sector :global(.tab-ico) { transition: none; }
    .tab-sector:hover :global(.tab-ico) { transform: none; }
  }

  /* --- la barra de herramientas del tablero ------------------------------
     Neutra a propósito: el color de esta página es de las series, y un
     control que se pintara de un sector diría algo que no es cierto. */
  /* El mando es el segundo piso de la misma barra. Iba en una pastilla con
     su marco y su relleno, y se leía como un control de otro sitio pegado
     debajo del tablero; ahora usa la letra, el tamaño y el subrayado de las
     pestañas de arriba, centrado bajo el carril. Se distingue de ellas por
     el cuerpo, más pequeño, y por el color del subrayado: el dorado de la
     casa en vez del tono del sector, porque esto no elige sector. */
  .tablero-barra {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin-bottom: 22px;
  }
  .tb-mando {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 14px;
  }

  .tb-grupo { display: inline-flex; align-items: center; gap: 2px; }
  .tb-op {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 13px 10px;
    border: 0;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 11.5px;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition: color 180ms ease, border-color 180ms ease;
  }
  .tb-op:hover { color: inherit; }
  .tb-op:focus-visible { outline: 2px solid var(--color-gold); outline-offset: -3px; color: inherit; }
  .tb-op.is-on { color: inherit; font-weight: 600; }
  /* El subrayado se insinúa al pasar por encima y se afirma al elegir: el
     mismo gesto que las pestañas de arriba, con el dorado de la casa. */
  .tb-op::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-gold);
    opacity: 0;
    transform: scaleX(0.3);
    transition: transform 260ms cubic-bezier(0.22, 0.61, 0.36, 1), opacity 200ms ease;
  }
  .tb-op:hover::after { opacity: 0.4; transform: scaleX(1); }
  .tb-op.is-on::after { opacity: 1; transform: scaleX(1); }

  .tab-desc {
    margin-bottom: 20px;
    font-size: 13.5px;
    max-width: 68ch;
  }

  /* --- el tablero -------------------------------------------------------
     Doce columnas, y cada fila las cierra: seis y seis arriba, tres piezas de
     cuatro, o una banda entera. Sin huecos sueltos a la derecha. */
  .tablero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }

  @media (min-width: 720px) {
    .tablero { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .tablero > :global(.is-grande) { grid-column: span 6; }
    .tablero > :global(.is-medio) { grid-column: span 3; }
    .tablero > :global(.is-chico) { grid-column: span 2; }
    .tablero > :global(.is-ancho) { grid-column: span 6; }
    .tablero > :global(.is-tercio) { grid-column: span 3; }
    .tablero > :global(.is-cifra) { grid-column: span 2; }
    .tablero > :global(.panel-dona) { grid-column: span 6; }
  }

  @media (min-width: 1100px) {
    .tablero { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .tablero > :global(.is-grande) { grid-column: span 6; grid-row: span 2; }
    .tablero > :global(.is-medio) { grid-column: span 3; }
    .tablero > :global(.is-chico) { grid-column: span 2; }
    .tablero > :global(.is-ancho) { grid-column: span 12; }
    .tablero > :global(.is-tercio) { grid-column: span 4; }
    .tablero > :global(.is-cifra) { grid-column: span 2; }
    /* La dona ocupa el hueco de la segunda fila, bajo las dos medianas: así
       el tablero cierra un rectángulo y no queda media fila vacía. */
    .tablero > :global(.panel-dona) { grid-column: span 6; }
  }
