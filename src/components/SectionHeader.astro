---
/**
 * Cabecera de sección.
 *
 * Solo el título y, a la derecha, el botón que lleva a la sección completa.
 * Sin numeración, sin antetítulo y sin párrafo introductorio: lo que hay
 * debajo ya explica de qué va, y esos elementos solo añadían altura.
 */

export interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
  as?: 'h2' | 'h3';
}

const { title, href, linkLabel = 'Ver todo', as: Tag = 'h2' } = Astro.props;
---

<header class="sec-head">
  <div class="sec-head-inner">
    <Tag class="display-2 sec-title" data-reveal>{title}</Tag>

    {
      href && (
        <a href={href} class="btn btn-outline sec-btn" data-reveal>
          {linkLabel}
          <svg class="arw" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M2 8h11M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      )
    }
  </div>
</header>

<style>
  /* Centrada y sin regla: el cambio de color entre secciones ya marca el
     corte, y la línea solo añadía ruido. */
  .sec-head {
    margin-bottom: clamp(22px, 2.6vw, 34px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .sec-head-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .sec-title { max-width: 24ch; }

  .sec-btn { flex-shrink: 0; }
</style>
