---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { covers } from '../../site.config';
import ProgramCard from '../../components/ProgramCard.astro';
import Newsletter from '../../components/Newsletter.astro';

const programas = (await getCollection('formacion')).sort((a, b) => a.data.order - b.data.order);

const totalDocentes = new Set(programas.flatMap((p) => p.data.faculty.map((f) => f.name))).size;
const totalModulos = programas.reduce((acc, p) => acc + p.data.modules.length, 0);

const facts = [
  { label: 'Programas', value: String(programas.length) },
  { label: 'Módulos', value: String(totalModulos) },
  { label: 'Docentes', value: String(totalDocentes) },
  { label: 'Modalidad', value: 'Virtual en vivo' },
];

/* Las clases de programa, de más larga a más corta. Solo se ofrecen como
   viñeta las que tienen algo detrás. */
const CLASES = ['Diplomado', 'Curso de experto', 'Curso', 'Curso rápido', 'Taller'] as const;

const PLURAL: Record<(typeof CLASES)[number], string> = {
  Diplomado: 'Diplomados',
  'Curso de experto': 'Cursos de experto',
  Curso: 'Cursos',
  'Curso rápido': 'Cursos rápidos',
  Taller: 'Talleres',
};

const clases = CLASES.filter((c) => programas.some((p) => p.data.kind === c)).map((c) => ({
  tipo: c,
  label: PLURAL[c],
}));

---

<BaseLayout
  title="Formación"
  description="Diplomados, cursos de experto, cursos rápidos y talleres en economía aplicada, econometría y datos, dictados por especialistas en ejercicio."
  bleed
>
  <PageHero
    eyebrow="Formación"
    title="Formación de expertos, para expertos"
    lede="Diplomados, cursos de experto, cursos rápidos y talleres dictados por especialistas en ejercicio —banca central, regulación y academia—, con clases en vivo y casos bolivianos."
    facts={facts}
    cover={covers.formacion}
  />

  <section class="surface-light section" aria-labelledby="programas">
    <div class="wrap">
      <h2 id="programas" class="eyebrow eyebrow-gold form-h" data-reveal>Oferta vigente</h2>

      <div class="form-clases no-print" role="group" aria-label="Clase de programa" data-reveal>
        <button type="button" class="form-clase is-on" data-clase="" aria-pressed="true">Todas</button>
        {
          clases.map((c) => (
            <button type="button" class="form-clase" data-clase={c.tipo} aria-pressed="false">
              {c.label}
            </button>
          ))
        }
      </div>

      {/* Sin cifra a la vista: la rejilla ya muestra cuánto hay. Se conserva
          para lectores de pantalla, que necesitan saber qué quedó al filtrar. */}
      <p class="sr-only" data-form-count aria-live="polite">
        {programas.length} programas
      </p>

      <div class="prog-grid" data-reveal-group data-reveal-stagger="0.08">
        {programas.map((item) => (
          <div class="form-item" data-reveal data-clase={item.data.kind}>
            <ProgramCard item={item} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <Newsletter />
</BaseLayout>

<script>
  /* Filtro por clase de programa. Mismo gesto que en publicaciones. */
  const botones = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-clase]:not(.form-item)'));
  const items = Array.from(document.querySelectorAll<HTMLElement>('.form-item'));
  const cuenta = document.querySelector<HTMLElement>('[data-form-count]');

  if (items.length > 0) {
    botones.forEach((b) =>
      b.addEventListener('click', () => {
        const clase = b.dataset.clase ?? '';
        let visibles = 0;

        for (const el of items) {
          const ok = clase === '' || el.dataset.clase === clase;
          el.hidden = !ok;
          if (ok) visibles += 1;
        }

        botones.forEach((otro) => {
          const activo = otro === b;
          otro.classList.toggle('is-on', activo);
          otro.setAttribute('aria-pressed', String(activo));
        });

        if (cuenta) {
          cuenta.textContent = visibles === 1 ? '1 programa' : `${visibles} programas`;
        }
      }),
    );
  }
</script>

<style>
  /* Viñetas de clase: mismas que las de publicaciones, en un renglón y de
     margen a margen. */
  .form-clases {
    display: flex;
    flex-wrap: nowrap;
    justify-content: space-between;
    gap: 6px;
    margin-top: 18px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 6px 2px 10px;
    margin-inline: -2px;
  }
  .form-clases::-webkit-scrollbar { width: 0; height: 0; }

  .form-clase {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    padding: 7px 16px;
    border: 1px solid var(--line, var(--line-light));
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition: transform 260ms cubic-bezier(0.22, 0.61, 0.36, 1),
      border-color 220ms ease, background-color 220ms ease, color 220ms ease,
      box-shadow 260ms ease;
  }
  .form-clase:hover,
  .form-clase:focus-visible {
    transform: translateY(-2px);
    border-color: var(--color-gold);
    box-shadow: 0 10px 20px -12px rgb(3 26 36 / 0.4);
  }
  .form-clase:active { transform: translateY(0); }
  .form-clase.is-on {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }
  @media (prefers-reduced-motion: reduce) {
    .form-clase:hover, .form-clase:focus-visible { transform: none; }
  }

  .form-h { display: block; margin-bottom: 26px; }

  .prog-grid { display: grid; gap: 16px; }
  @media (min-width: 760px) { .prog-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1140px) { .prog-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .cert-grid {
    display: grid;
    gap: 40px;
    padding-top: 32px;
  }
  @media (min-width: 960px) {
    .cert-grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: 68px; }
  }
  .cert-title { margin-top: 16px; max-width: 17ch; }
  .cert-text { margin-top: 18px; font-size: 14.5px; line-height: 1.7; max-width: 54ch; }

  .req-h { display: block; margin-bottom: 12px; }
  .req-list { list-style: none; margin: 0; padding: 0; }
  .req-list li {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    gap: 12px;
    padding-block: 13px;
    border-top: 1px solid var(--line-dark);
    font-size: 13.5px;
    line-height: 1.5;
  }
  .req-list li:last-child { border-bottom: 1px solid var(--line-dark); }
  .req-note { margin-top: 18px; font-size: 12.5px; line-height: 1.6; }

  .contact-grid {
    display: grid;
    gap: 28px;
    padding-top: 30px;
  }
  @media (min-width: 900px) {
    .contact-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; align-items: center; }
  }
  .contact-title { margin-top: 14px; max-width: 18ch; }
  .contact-body { display: grid; gap: 18px; }
  .contact-line { display: grid; gap: 6px; font-size: 14px; line-height: 1.6; }
  .contact-phones { font-size: 15px; letter-spacing: 0.02em; }
</style>
