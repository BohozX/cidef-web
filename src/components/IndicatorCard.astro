---
import Sparkline from './Sparkline.astro';
import type { Indicator } from '../lib/indicators';
import { tail } from '../lib/sparkline';
import { deltaLabel, direction, monthYear, num } from '../lib/format';

export interface Props {
  indicator: Indicator;
  /** Variante compacta para carriles y listados densos. */
  compact?: boolean;
}

const { indicator: ind, compact = false } = Astro.props;

const dir = direction(ind.change);
const values = tail(ind.history, 40);
const prefix = ind.unit === 'Bs' ? 'Bs ' : '';
const suffix = ind.unit === '%' ? '%' : ind.unit === '% PIB' ? '%' : '';
const strokeColor = ind.own ? '#d29a28' : '#008c85';
---

<a
  href={`/radar/${ind.id}`}
  class:list={['ind-card', 'panel', 'panel-hover', compact && 'is-compact']}
  data-reveal
>
  <div class="ind-top">
    <h3 class="ind-name">{ind.name}</h3>
    <span class="ind-go" aria-hidden="true">
      <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.7">
        <path d="M4 12L12 4M6 4h6v6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </div>

  <p class="ind-value metric">
    <span
      data-count={ind.value}
      data-count-decimals={ind.decimals}
      data-count-prefix={prefix}
      data-count-suffix={suffix}
    >{prefix}{num(ind.value, ind.decimals)}{suffix}</span>
    {
      ind.unit !== '%' && ind.unit !== 'Bs' && ind.unit !== '% PIB' && (
        <span class="ind-unit">{ind.unit}</span>
      )
    }
  </p>

  <p class:list={['ind-delta', 'tnum', `delta-${dir}`]}>
    {deltaLabel(ind.change, ind.changeUnit, ind.decimals)}
    <span class="ind-date muted">· {monthYear(ind.date)}</span>
  </p>

  <div class="ind-spark">
    <Sparkline values={values} stroke={strokeColor} height={compact ? 36 : 46} />
  </div>

  <div class="ind-foot">
    <span class="muted">{ind.source}</span>
    <span class="ind-tags">
      {ind.own && <span class="chip chip-gold">Centro</span>}
      {ind.demo && <span class="chip chip-demo">Demo</span>}
    </span>
  </div>
</a>

<style>
  .ind-card {
    display: flex;
    flex-direction: column;
    padding: 20px 20px 16px;
    min-height: 100%;
  }
  .ind-card.is-compact { padding: 16px 16px 13px; }

  .ind-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    min-height: 34px;
  }

  .ind-name {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    line-height: 1.35;
    max-width: 24ch;
  }

  .ind-go {
    opacity: 0;
    transform: translate(-3px, 3px);
    transition: opacity 220ms ease, transform 220ms cubic-bezier(0.22, 0.61, 0.36, 1);
    color: var(--color-gold);
    flex-shrink: 0;
  }
  .ind-card:hover .ind-go,
  .ind-card:focus-visible .ind-go {
    opacity: 1;
    transform: none;
  }

  .ind-value {
    margin-top: 16px;
    font-size: clamp(2.2rem, 3.1vw, 2.9rem);
    display: flex;
    align-items: baseline;
    gap: 7px;
  }
  .is-compact .ind-value { font-size: 2rem; margin-top: 12px; }

  .ind-unit {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .ind-delta {
    margin-top: 8px;
    font-size: 12.5px;
    font-weight: 500;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .ind-date { font-weight: 400; }

  .ind-spark {
    margin-top: auto;
    padding-top: 18px;
    opacity: 0.92;
    transition: opacity 220ms ease;
  }
  .ind-card:hover .ind-spark { opacity: 1; }

  .ind-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 12px;
    padding-top: 11px;
    border-top: 1px solid var(--line, var(--line-light));
    font-size: 11px;
    letter-spacing: 0.04em;
  }
  .ind-tags { display: flex; gap: 6px; }
</style>
