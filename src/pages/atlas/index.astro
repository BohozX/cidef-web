---
import { withBase, withBaseSrcset } from '../../lib/url';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Newsletter from '../../components/Newsletter.astro';
import { indicators } from '../../lib/indicators';
import { num, periodoCorto } from '../../lib/format';
import Tableros from '../../components/Tableros.astro';
import IconoSector from '../../components/IconoSector.astro';
import MapaBolivia from '../../components/MapaBolivia.astro';
import { linea } from '../../lib/graficos';
import {
  atajos,
  byId,
  ETIQUETA,
  categories as todasCategorias,
  ownIndicators,
  SECTORES,
  higherIsBetter,
} from '../../lib/indicators';

/* La tira de la cabecera: lo que se mira cada mañana. Cada atajo dice qué
   mide y de cuándo es el dato: «inflación» a secas no informa de nada si no
   se sabe si es mensual o interanual, ni de qué mes. */
const MESES = [
  'enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio',
  'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre',
];
const ROMANOS = ['I', 'II', 'III', 'IV'];

const periodo = (iso: string, frecuencia: string): string => {
  const f = new Date(iso);
  const mes = f.getUTCMonth();
  const anio = f.getUTCFullYear();
  if (frecuencia === 'Trimestral') return `${ROMANOS[Math.floor(mes / 3)]} trimestre ${anio}`;
  if (frecuencia === 'Diaria') return `${f.getUTCDate()} de ${MESES[mes]} de ${anio}`;
  return `${MESES[mes]} de ${anio}`;
};

const tira = atajos().map((i) => ({ i, periodo: periodo(i.date, i.frequency) }));

/* Los sectores, en el orden en que se recorren. */
const sectores = SECTORES.map((id) => todasCategorias.find((c) => c.id === id)).filter(
  (c): c is NonNullable<typeof c> => Boolean(c),
);

/* --- la vista de la derecha --------------------------------------------
   Dos piezas y ninguna inventada: las dos salen del mismo catálogo que el
   tablero de arriba. Se eligen las dos que el Centro calcula por su cuenta,
   que es exactamente lo que la sección dice que se lleva quien entra.

   El gráfico es el nowcast del PIB: la lectura propia sobre el producto,
   semana a semana, que es el argumento de la sección —un dato que ninguna
   fuente publica— sin salirse de lo que hay en el catálogo. Debajo, dos
   cifras: una proyección y una estimación, las dos familias de dato propio.

   No se usa la brecha del producto porque el catálogo no la tiene: habría
   que estimarla y publicarla como serie propia antes de poder enseñarla, y
   dibujarla aquí sería inventar el dato. */
const grafica = byId('nowcast-pib')!;
const vistaSerie = grafica.history.map((h) => h.v);
const vistaG = linea(vistaSerie, 600, 150, true);
const vistaMin = Math.min(...vistaSerie);
const vistaMax = Math.max(...vistaSerie);
const vistaDesde = periodoCorto(grafica.history[0]!.d, grafica.frequency);
const vistaHasta = periodoCorto(grafica.date, grafica.frequency);
const cifraVista = byId('inflacion-esperada')!;

/* Dónde cae la lectura de hoy dentro de su propia historia.

   Es un histograma de las observaciones del índice de incertidumbre, con la
   columna del dato actual encendida. No repite lo que hace la ficha de
   arriba —allí se ve la trayectoria, aquí la frecuencia— y contesta algo que
   una serie en el tiempo no contesta de un vistazo: si el valor de hoy es
   corriente o excepcional para esa serie.

   No hay ningún número inventado: los tramos y las alturas se cuentan de la
   propia serie al compilar. */
const inc = byId('indice-incertidumbre')!;
const valoresInc = inc.history.map((h) => h.v);
const TRAMOS = 18;
const incMin = Math.min(...valoresInc);
const incMax = Math.max(...valoresInc);
const paso = (incMax - incMin) / TRAMOS || 1;
const tramoDe = (v: number) => Math.min(TRAMOS - 1, Math.max(0, Math.floor((v - incMin) / paso)));

const cuenta = new Array(TRAMOS).fill(0) as number[];
for (const v of valoresInc) cuenta[tramoDe(v)] += 1;
const cuentaMax = Math.max(...cuenta) || 1;
const tramoHoy = tramoDe(inc.value);

/* Cuántas observaciones quedan por debajo del dato de hoy: el percentil, que
   es la lectura que el histograma deja ver pero no dice. */
const percentilHoy = Math.round(
  (valoresInc.filter((v) => v < inc.value).length / valoresInc.length) * 100,
);

/* Los nombres de las series propias, en prosa y en el orden del catálogo.
   El volumen P2P queda fuera de esta enumeración por decisión editorial: no
   se nombra en esta sección. */
const nombresPropios = ownIndicators()
  .filter((i) => i.id !== 'volumen-p2p')
  .map((i) => i.shortName);
const listaPropios =
  nombresPropios.slice(0, -1).join(', ') + ' y ' + nombresPropios.at(-1);
import { covers } from '../../site.config';

---

<BaseLayout
  title="Atlas Económico"
  description="Plataforma de indicadores de la economía boliviana: actividad, precios, monetario y financiero, mercado cambiario, sector externo, fiscal, empleo, indicadores sociales, economía internacional y estimaciones propias del CIDEF."
  bleed
>
  <PageHero
    eyebrow="Atlas Económico"
    title="La economía boliviana, en un tablero"
    lede="Explora los principales indicadores macroeconómicos, financieros y sectoriales de Bolivia, junto con las estimaciones, índices y proyecciones que elabora el centro."
    cover={covers.atlas}
  >
    <div slot="actions" class="atlas-acciones" data-hero-item>
      {/* Atajos: qué mide, cuánto y de cuándo. Sin cinta de bolsa: seis
          series, y cada una dice su período de referencia. */}
      <ul class="atlas-tira">
        {tira.map(({ i, periodo: p }) => {
          const sube = i.change >= 0;
          const bueno = sube === higherIsBetter(i.id);
          return (
            <li>
              <a href={withBase(`/atlas/${i.id}`)}>
                <span class="tira-nombre">{i.name}</span>
                <span class="tira-linea">
                  <span class="tira-valor tnum">{num(i.value, i.decimals)}</span>
                  <span class="tira-unidad">{i.unit}</span>
                  <span class:list={['tira-var', 'tnum', bueno ? 'es-bueno' : 'es-malo']}>
                    {sube ? '▲' : '▼'} {num(Math.abs(i.change), i.decimals)} {i.changeUnit}
                  </span>
                </span>
                <span class="tira-periodo">{p}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </PageHero>

  <!-- LOS TABLEROS ---------------------------------------------------------- -->
  <section class="surface-light section" aria-labelledby="panorama">
    <div class="wrap">
      {/* La sección abre con la pregunta, sin antetítulo ni nota al lado:
          el tablero que viene debajo es la respuesta y no necesita que se lo
          presenten dos veces. */}
      <div class="atlas-sec-head">
        <h2 id="panorama" class="display-3 atlas-sec-title" data-reveal>
          ¿Qué está pasando en la economía boliviana?
        </h2>
      </div>

      <Tableros />
    </div>
  </section>

  <!-- LA BASE DE DATOS PROFESIONAL ----------------------------------------
       El Atlas es la puerta; esto es el producto. La sección se leía como un
       folleto: dos párrafos largos, una tarjeta con otros tres dentro y un
       cierre que repetía el titular. El mensaje —hay dos niveles, y el de
       pago trae lo que nadie más publica— no llegaba hasta el quinto
       renglón. Ahora llega en el primero, tres cifras del propio catálogo lo
       sostienen y los dos niveles son la llamada a la acción, en vez de un
       botón suelto debajo de todo. -->
  <section class="surface-mist section edge-tr" aria-labelledby="base-titulo">
    <div class="wrap">
      <div class="bp">
        <div class="bp-panel">
          {/* Lo que se dice, a la izquierda. */}
          <div class="bp-dicho" data-reveal-group data-reveal-stagger="0.07">
            <p class="eyebrow bp-eyebrow" data-reveal>
              Base de datos económica<span class="bp-regla" aria-hidden="true" />
            </p>
            <h2 id="base-titulo" class="bp-titulo" data-reveal>
              Más allá del <em>dato</em> visible
            </h2>
            {/* Tres apartados en el orden del argumento: lo que cualquiera
                consigue en otra parte, lo que solo está aquí, y con qué se
                mira. Sin cajas: en esta sección ya hay dos, y la lista no
                necesita marco para leerse como lista. */}
            <ul class="bp-puntos">
              <li data-reveal>
                <span class="bp-punto-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <ellipse cx="12" cy="5.6" rx="8" ry="3" />
                    <path d="M4 5.6v6.2c0 1.7 3.6 3 8 3s8-1.3 8-3V5.6" />
                    <path d="M4 11.8V18c0 1.7 3.6 3 8 3s8-1.3 8-3v-6.2" />
                  </svg></span>
                <div>
                  <p class="bp-punto-etq">Todas las fuentes</p>
                  <p class="bp-punto-txt">
                    INE, BCB, ministerios y organismos internacionales, ordenados
                    por sector y con el histórico completo de cada serie.
                  </p>
                </div>
              </li>

              <li class="es-propia" data-reveal>
                <span class="bp-punto-ico" aria-hidden="true">
                  <IconoSector id="centro" size={19} />
                </span>
                <div>
                  <p class="bp-punto-etq">Lo que calcula el Centro</p>
                  <p class="bp-punto-txt">
                    {listaPropios}. Estimaciones y proyecciones con metodología
                    propia y su historial de revisiones.
                  </p>
                </div>
              </li>

              <li class="es-mirar" data-reveal>
                <span class="bp-punto-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3.2 3v15.4A2.4 2.4 0 0 0 5.6 20.8H21" />
                    <path d="M7 16.2l3.9-4.7 3.1 2.6 4.6-6" />
                    <path d="M18.6 8.1h-3.2m3.2 0v3.2" />
                  </svg></span>
                <div>
                  <p class="bp-punto-etq">Una herramienta para verlos</p>
                  <p class="bp-punto-txt">
                    Grafica cualquier serie, compárala con otra o entre fuentes,
                    transfórmala y descarga el resultado.
                  </p>
                </div>
              </li>
            </ul>

          </div>

          {/* Lo que se enseña, a la derecha: el país de fondo y encima dos
              piezas reales del catálogo, las dos del propio Centro. */}
          <div class="bp-vista" data-reveal-group data-reveal-stagger="0.12">
            <MapaBolivia class="bp-mapa" />

            <figure class="bp-ficha es-grafico" data-reveal>
              <figcaption class="bp-ficha-head">
                <span class="bp-ficha-tit">{grafica.name}</span>
                {/* El sello lo dicta el dato, no la plantilla: una proyección
                    no puede presentarse nunca como estimación. */}
                <span class:list={['bp-ficha-sello', `es-${grafica.kind}`]}>
                  {ETIQUETA[grafica.kind]}
                </span>
              </figcaption>

              <p class="bp-ficha-valor">
                <span class="bp-ficha-cifra tnum">{num(grafica.value, grafica.decimals)}</span>
                <span class="bp-ficha-unidad">{grafica.unit}</span>
              </p>

              <div class="bp-ficha-lienzo">
                <svg viewBox="0 0 600 150" preserveAspectRatio="none" width="100%" height="88" aria-hidden="true">
                  <defs>
                    <linearGradient id="bp-relleno" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0" stop-color="currentColor" stop-opacity="0.26" />
                      <stop offset="1" stop-color="currentColor" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                  <path d={vistaG.area} fill="url(#bp-relleno)" />
                  {/* `spark-path` es el trazo progresivo que ya usa el sitio:
                      lo dibuja al entrar en pantalla y se desactiva solo con
                      `prefers-reduced-motion`. */}
                  <path
                    class="spark-path"
                    d={vistaG.linea}
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    vector-effect="non-scaling-stroke"
                  />
                  <circle cx={vistaG.ultimoX} cy={vistaG.ultimoY} r="4" fill="currentColor" />
                </svg>
              </div>

              <div class="bp-ficha-pie">
                <span>{vistaDesde}</span>
                <span class="tnum">
                  {num(vistaMin, grafica.decimals)} – {num(vistaMax, grafica.decimals)} {grafica.unit}
                </span>
                <span>{vistaHasta}</span>
              </div>
            </figure>

            {/* Debajo, de qué está hecho el índice —la pregunta que sigue
                siempre a «lo calcula el Centro»— y una cifra propia más. */}
            <div class="bp-datos">
              <figure class="bp-ficha es-hist" data-reveal>
                <figcaption class="bp-ficha-head">
                  <span class="bp-ficha-tit">{inc.shortName}</span>
                  <span class:list={['bp-ficha-sello', `es-${inc.kind}`]}>
                    {ETIQUETA[inc.kind]}
                  </span>
                </figcaption>

                <p class="bp-ficha-valor">
                  <span class="bp-ficha-cifra tnum">{num(inc.value, inc.decimals)}</span>
                  <span class="bp-ficha-unidad">{inc.unit}</span>
                </p>

                {/* Cada columna es un tramo del índice y su alto, cuántos días
                    cayeron ahí. La encendida es la de hoy. */}
                <div class="bp-hist" aria-hidden="true">
                  {cuenta.map((c, i) => (
                    <span
                      class:list={['bp-hist-col', i === tramoHoy && 'es-hoy']}
                      style={`height:${Math.max(6, (c / cuentaMax) * 100)}%`}
                    />
                  ))}
                </div>

                <p class="bp-hist-pie">
                  Hoy por encima del <strong class="tnum">{percentilHoy}%</strong> de las
                  {' '}{valoresInc.length} lecturas diarias
                </p>
              </figure>

              <div class="bp-ficha es-dato" data-reveal>
                <span class="bp-ficha-tit">{cifraVista.shortName}</span>
                <p class="bp-ficha-valor">
                  <span class="bp-ficha-cifra tnum">{num(cifraVista.value, cifraVista.decimals)}</span>
                  <span class="bp-ficha-unidad">{cifraVista.unit}</span>
                </p>
                <span class:list={['bp-ficha-sello', `es-${cifraVista.kind}`]}>
                  {ETIQUETA[cifraVista.kind]} · {cifraVista.frequency}
                </span>
              </div>
            </div>
          </div>

          {/* El botón cierra la sección centrado bajo las dos columnas: es lo
              único que se pide hacer y no pertenece a ninguna de las dos. */}
          <div class="bp-cierre" data-reveal>
            <a href={withBase('/base')} class="btn btn-solid bp-boton">
              <span class="bp-boton-txt">Explorar la Base de Datos</span>
              <svg class="arw" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M2 8h11M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Newsletter />
</BaseLayout>

<style>
  /* --- la base profesional ----------------------------------------------
     Dos mitades: lo que se dice y lo que se enseña. A la izquierda el
     argumento; a la derecha el país de fondo y encima dos piezas reales del
     catálogo, no un decorado. Dos fichas y ninguna más: la sección ya se
     había llenado antes de tarjetas dentro de tarjetas.

     El dorado es el acento de la sección y el turquesa el del dato propio.
     Sobre papel el dorado de marca se aclara demasiado para un cuerpo
     pequeño, así que se hunde hacia la tinta lo justo para leerse sin dejar
     de ser dorado. */
  .bp { --oro: color-mix(in srgb, var(--color-gold) 74%, var(--color-ink)); }

  .bp-panel { display: grid; gap: clamp(34px, 4vw, 60px); }
  @media (min-width: 1040px) {
    .bp-panel {
      grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
      align-items: center;
      /* Ancho entre columnas, corto entre filas: el botón va en una fila
         propia y con el mismo hueco a los lados quedaba descolgado medio
         palmo por debajo de todo. */
      gap: clamp(18px, 2vw, 26px) clamp(36px, 4.2vw, 68px);
    }
  }

  /* --- lo que se dice --- */
  .bp-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--oro);
    text-align: left;
  }
  .bp-regla { flex: 0 0 40px; height: 1px; background: currentColor; opacity: 0.5; }

  /* El titular se deja correr: acotado a once caracteres se partía en dos
     renglones cortos aunque hubiera sitio de sobra a la derecha. */
  .bp-titulo {
    margin-top: 14px;
    font-family: var(--font-display);
    font-size: clamp(30px, 3.6vw, 50px);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.042em;
    text-wrap: balance;
  }
  /* Una sola palabra en color: la que nombra lo que la sección promete. */
  .bp-titulo em { font-style: normal; color: var(--color-teal-600); }

  /* --- los tres apartados --- */
  .bp-puntos {
    display: grid;
    gap: 18px;
    margin: clamp(26px, 3vw, 36px) 0 0;
    padding: 0;
    list-style: none;
  }
  .bp-puntos li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 14px;
    align-items: start;
    color: var(--color-teal-600);
  }
  .bp-puntos li.es-propia { color: var(--oro); }

  .bp-punto-ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: color-mix(in srgb, currentColor 12%, transparent);
  }
  /* Un punto por encima de lo que eran: al lado de un titular de cincuenta
     píxeles, un rótulo de nueve y medio y un cuerpo de doce y medio se leían
     como el pie de una tabla, y son el argumento de la sección. */
  .bp-punto-etq {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: currentColor;
    text-align: left;
  }
  .bp-punto-txt {
    margin-top: 7px;
    font-size: 13.5px;
    line-height: 1.62;
    color: var(--muted);
    text-align: left;
    max-width: 52ch;
  }

  /* --- el cierre --- */
  .bp-cierre {
    display: flex;
    justify-content: center;
    margin-top: clamp(28px, 3.4vw, 44px);
  }
  @media (min-width: 1040px) { .bp-cierre { grid-column: 1 / -1; margin-top: 0; } }

  /* El botón era un rectángulo de esquinas casi rectas, del mismo negro que
     todo lo demás y sin nada que invitara a pulsarlo. Ahora es una cápsula, y
     al pasar por encima el dorado de la casa lo recorre de lado a lado y la
     tinta se invierte: el color del acento entra por donde hay que entrar. */
  .bp-boton {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: 14px 30px;
    border-radius: 999px;
    box-shadow: 0 12px 26px -16px rgb(3 26 36 / 0.7);
    transition: transform 300ms cubic-bezier(0.22, 0.61, 0.36, 1),
      box-shadow 300ms ease, color 240ms ease;
  }
  .bp-boton::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-gold);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 420ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .bp-boton:hover,
  .bp-boton:focus-visible {
    color: var(--color-ink);
    transform: translateY(-2px);
    box-shadow: 0 18px 32px -18px color-mix(in srgb, var(--color-gold) 70%, transparent);
  }
  .bp-boton:hover::before,
  .bp-boton:focus-visible::before { transform: scaleX(1); }
  /* El relleno de `.btn-solid` no puede cambiar al pasar por encima: encima
     va la mancha dorada y el negro tiene que quedarse quieto detrás. */
  .bp-boton:hover { background: var(--color-ink); }

  /* --- lo que se enseña --------------------------------------------------
     El país va detrás, muy por lo bajo y sin rótulo: sitúa la sección sin
     pedir que se lea. Las fichas no se colocan en absoluto sino en flujo, una
     pegada a la derecha y otra a la izquierda: así el escalón se mantiene a
     cualquier ancho sin una sola media query de posición. */
  .bp-vista {
    position: relative;
    display: grid;
    gap: 16px;
    padding-block: clamp(10px, 2vw, 26px);
  }
  /* El SVG lo pinta otro componente, así que su clase no entra en el ámbito
     de esta hoja: hay que alcanzarla con :global, acotada por el contenedor
     para que siga siendo local a esta sección. */
  .bp-vista :global(.bp-mapa) {
    position: absolute;
    /* Sin desbordes: con márgenes negativos la silueta se salía por arriba
       de la sección y se metía en el filo redondeado de la de al lado. Dentro
       de la caja, `preserveAspectRatio` la escala sola. */
    inset: 0 14% 0 0;
    z-index: 0;
    color: color-mix(in srgb, var(--color-teal) 16%, transparent);
    pointer-events: none;
  }

  .bp-ficha {
    position: relative;
    z-index: 1;
    margin: 0;
    padding: 16px 18px 14px;
    border: 1px solid var(--line, var(--line-light));
    border-radius: 12px;
    /* Traslúcidas: el país tiene que verse pasar por debajo, que es lo que
       las ata al fondo en vez de dejarlas flotando sobre él. El desenfoque
       mantiene el texto legible por encima de la silueta. */
    background: color-mix(in srgb, var(--color-paper) 76%, transparent);
    backdrop-filter: blur(9px);
    box-shadow: 0 22px 44px -32px rgb(3 26 36 / 0.6);
    /* El mismo gesto que las piezas del tablero de arriba: en una misma
       página, dos tarjetas vecinas no pueden responder distinto al ratón. */
    transition: transform 320ms cubic-bezier(0.22, 0.61, 0.36, 1),
      box-shadow 320ms ease, border-color 240ms ease;
  }
  .bp-ficha:hover,
  .bp-ficha:focus-within {
    transform: translateY(-4px);
