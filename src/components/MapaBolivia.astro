---
/**
 * La silueta de Bolivia.
 *
 * El contorno no está dibujado a mano ni calcado de una imagen: sale de
 * Natural Earth 1:50m (`ne_50m_admin_0_countries`, dominio público), que es
 * la escala de referencia para un país entero —la 1:110m redondea la
 * frontera hasta deformarla y la 1:10m pesa diez veces más sin que se note a
 * este tamaño—. Del archivo se toma el polígono de `ADM0_A3 = BOL`, se
 * proyecta en equirectangular con el paralelo estándar en el centro del país
 * —a esta latitud y para una sola silueta, la distorsión es inapreciable— y
 * se reduce con Douglas-Peucker de 418 vértices a 111, que es donde el
 * contorno deja de cambiar a la vista.
 *
 * Es un elemento decorativo: va sin título y oculto a los lectores de
 * pantalla, porque no aporta ningún dato que no esté escrito al lado.
 *
 * Fuente: Natural Earth — naturalearthdata.com (dominio público).
 */
export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
