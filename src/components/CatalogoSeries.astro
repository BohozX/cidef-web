---
import { withBase } from '../lib/url';
import { indicators, categories, SECTORES, ETIQUETA } from '../lib/indicators';
import { num, periodoRef, shortDate } from '../lib/format';

/**
 * El catálogo de la base profesional: todas las series disponibles, agrupadas
 * por sector.
 *
 * No es el tablero. El tablero enseña una selección y la enseña dibujada; esto
 * es el índice completo, en filas, con lo que hace falta para decidir si una
 * serie sirve: qué es el dato, cada cuánto se publica, cuántas observaciones
 * tiene, cuál es la última y de qué período. El gráfico está a un clic, en la
 * ficha de cada serie.
 */

const FRECUENCIAS = [...new Set(indicators.map((i) => i.frequency))].sort();

const grupos = SECTORES.filter((id) => id !== 'panorama')
  .map((id) => {
    const cat = categories.find((c) => c.id === id);
    const series = indicators
      .filter((i) => i.category === id)
      .sort((a, b) => a.name.localeCompare(b.name, 'es'));
    return { id, cat, series };
  })
  .filter((g) => g.cat && g.series.length > 0);

const total = grupos.reduce((s, g) => s + g.series.length, 0);
---

<div class="cat-filtros no-print" data-reveal>
  <div class="cat-buscar">
    <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
      <circle cx="9" cy="9" r="6" />
      <path d="M13.5 13.5 17 17" stroke-linecap="round" />
    </svg>
    <input
      type="search"
      class="cat-input"
      placeholder="Buscar una serie, una fuente, un sector"
      aria-label="Buscar en el catálogo"
      data-cat-buscar
    />
  </div>

  <div class="cat-selects">
    <label class="sr-only" for="cat-tipo">Tipo de dato</label>
    <select id="cat-tipo" class="field" data-cat-tipo>
      <option value="">Todo tipo de dato</option>
      <option value="oficial">Oficial</option>
      <option value="estimacion">Estimación del Centro</option>
      <option value="proyeccion">Proyección del Centro</option>
    </select>

    <label class="sr-only" for="cat-frecuencia">Frecuencia</label>
    <select id="cat-frecuencia" class="field" data-cat-frecuencia>
      <option value="">Cualquier frecuencia</option>
      {FRECUENCIAS.map((f) => <option value={f}>{f}</option>)}
    </select>
  </div>
</div>

<p class="sr-only" role="status" data-cat-cuenta>{total} series disponibles</p>

<div class="cat-grupos">
  {
    grupos.map((g) => (
      <section class="cat-grupo" id={`seccion-${g.id}`} data-grupo aria-labelledby={`t-${g.id}`}>
        <header class="cat-grupo-head">
          <h3 id={`t-${g.id}`} class="cat-grupo-nombre">{g.cat!.name}</h3>
          <p class="cat-grupo-desc muted">{g.cat!.description}</p>
        </header>

        <div class="cat-tabla">
          <div class="cat-fila cat-cabecera" aria-hidden="true">
            <span>Serie</span>
            <span>Tipo de dato</span>
            <span>Frecuencia</span>
            <span class="cat-der">Obs.</span>
            <span class="cat-der">Último dato</span>
            <span>Período</span>
            <span />
          </div>

          {g.series.map((i) => (
            <a
              class="cat-fila cat-serie"
              href={withBase(`/radar/${i.id}`)}
              data-serie
              data-tipo={i.kind}
              data-frecuencia={i.frequency}
              data-texto={`${i.name} ${i.shortName} ${i.source} ${g.cat!.name}`.toLowerCase()}
            >
              <span class="cat-nombre">
                {i.name}
                <span class="cat-fuente muted">{i.source} · actualizado el {shortDate(i.updated)}</span>
              </span>
              <span class:list={['cat-sello', `sello-${i.kind}`]}>{ETIQUETA[i.kind]}</span>
              <span class="cat-frec muted">{i.frequency}</span>
              <span class="cat-der cat-obs tnum muted">{i.history.length}</span>
              <span class="cat-der cat-valor tnum">
                {num(i.value, i.decimals)}
                <span class="cat-unidad muted"> {i.unit}</span>
              </span>
              <span class="cat-periodo muted">{periodoRef(i.date, i.frequency)}</span>
              <span class="cat-arw" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M2 8h11M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </a>
          ))}
        </div>
      </section>
    ))
  }
</div>

<p class="cat-vacio" data-cat-vacio hidden>
  Ninguna serie coincide con esa búsqueda. Prueba con el nombre del indicador,
  la fuente que lo publica o el sector.
</p>

<script>
  /* Filtrado en el navegador: el catálogo entero viene en el HTML, así que
     buscar no pide nada al servidor. Un sector cuyas series se han filtrado
     todas se oculta entero: dejar el encabezado suelto hace creer que el
     sector está vacío. */
  const buscar = document.querySelector<HTMLInputElement>('[data-cat-buscar]');
  const selTipo = document.querySelector<HTMLSelectElement>('[data-cat-tipo]');
  const selFrec = document.querySelector<HTMLSelectElement>('[data-cat-frecuencia]');
  const cuenta = document.querySelector<HTMLElement>('[data-cat-cuenta]');
  const vacio = document.querySelector<HTMLElement>('[data-cat-vacio]');
  const grupos = Array.from(document.querySelectorAll<HTMLElement>('[data-grupo]'));

  const normal = (t: string): string =>
    t.toLowerCase().normalize('NFD').replace(/\p{Diacritic}/gu, '');

  const filtrar = () => {
    const q = normal(buscar?.value.trim() ?? '');
    const tipo = selTipo?.value ?? '';
    const frec = selFrec?.value ?? '';
    let visibles = 0;

    grupos.forEach((g) => {
      let enGrupo = 0;
      g.querySelectorAll<HTMLElement>('[data-serie]').forEach((fila) => {
        const ok =
          (!q || normal(fila.dataset.texto ?? '').includes(q)) &&
          (!tipo || fila.dataset.tipo === tipo) &&
          (!frec || fila.dataset.frecuencia === frec);
        fila.hidden = !ok;
        if (ok) enGrupo += 1;
      });
      g.hidden = enGrupo === 0;
      visibles += enGrupo;
    });

    if (cuenta) cuenta.textContent = `${visibles} ${visibles === 1 ? 'serie' : 'series'} a la vista`;
    if (vacio) vacio.hidden = visibles > 0;
  };

  buscar?.addEventListener('input', filtrar);
  selTipo?.addEventListener('change', filtrar);
  selFrec?.addEventListener('change', filtrar);
</script>

<style>
  /* --- filtros ----------------------------------------------------------- */
  .cat-filtros {
    display: grid;
    gap: 16px;
    padding-bottom: clamp(26px, 3vw, 38px);
  }
  @media (min-width: 900px) {
    .cat-filtros { grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 28px; }
  }

  /* La búsqueda, discreta: una línea, no una caja. */
  .cat-buscar {
    display: flex;
    align-items: center;
    gap: 11px;
    border-bottom: 1px solid var(--line, var(--line-light));
    padding-bottom: 9px;
    color: var(--muted);
  }
  .cat-input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    color: inherit;
    font-family: inherit;
    font-size: 14px;
    padding: 0;
  }
  .cat-input:focus { outline: none; }
  .cat-input::-webkit-search-cancel-button { display: none; }

  .cat-selects { display: flex; flex-wrap: wrap; gap: 10px; }
  .cat-selects .field { width: auto; min-width: 190px; font-size: 13px; padding: 9px 12px; }

  /* --- grupos ------------------------------------------------------------ */
  .cat-grupo { scroll-margin-top: 96px; }
  .cat-grupo + .cat-grupo { margin-top: clamp(34px, 4vw, 56px); }

  .cat-grupo-head {
    display: grid;
    gap: 6px;
    padding-bottom: 14px;
  }
  @media (min-width: 900px) {
    .cat-grupo-head {
      grid-template-columns: minmax(0, auto) minmax(0, 1fr);
      align-items: baseline;
      gap: 26px;
    }
  }
  .cat-grupo-nombre {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .cat-grupo-desc { font-size: 12.5px; text-align: left; }

  /* --- filas ------------------------------------------------------------- */
  .cat-fila {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4px 18px;
    padding: 13px 10px 13px 12px;
    border-top: 1px solid var(--line, var(--line-light));
    align-items: center;
  }
  @media (min-width: 900px) {
    .cat-fila {
      grid-template-columns:
        minmax(0, 1fr) 148px 96px 58px 152px 138px 16px;
    }
  }

  .cat-cabecera {
    display: none;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    border-top: 0;
    padding-bottom: 8px;
  }
  @media (min-width: 900px) { .cat-cabecera { display: grid; } }

  /* La fila entera es el enlace: el nombre no basta como blanco cuando hay
     treinta filas seguidas. */
  .cat-serie {
    transition: background-color 200ms ease, padding-left 240ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .cat-serie:hover,
  .cat-serie:focus-visible {
    background: color-mix(in srgb, currentColor 4%, transparent);
    padding-left: 18px;
  }
  .cat-serie:last-child { border-bottom: 1px solid var(--line, var(--line-light)); }

  .cat-nombre {
    display: grid;
    gap: 3px;
    font-size: 13.5px;
    font-weight: 500;
    min-width: 0;
  }
  .cat-fuente {
    font-size: 10.5px;
    font-weight: 400;
  }

  .cat-sello {
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  .sello-oficial { color: var(--muted); }
  .sello-estimacion { color: var(--color-teal-600); }
  .sello-proyeccion { color: var(--color-gold); }

  .cat-frec, .cat-periodo { font-size: 11.5px; }
  .cat-obs { font-size: 11.5px; }
  .cat-der { text-align: right; }
  .cat-valor { font-size: 14px; font-weight: 600; letter-spacing: -0.01em; }
  .cat-unidad { font-size: 10px; font-weight: 400; }

  .cat-arw { color: var(--color-teal-600); opacity: 0; transition: opacity 200ms ease, transform 220ms cubic-bezier(0.22, 0.61, 0.36, 1); }
  .cat-serie:hover .cat-arw, .cat-serie:focus-visible .cat-arw { opacity: 1; transform: translateX(3px); }

  /* En pantalla estrecha la fila se vuelve ficha: el nombre arriba y el resto
     en una línea de datos, sin barra de desplazamiento horizontal. */
  @media (max-width: 899px) {
    .cat-sello, .cat-frec, .cat-obs, .cat-periodo { font-size: 10.5px; }
    .cat-valor { text-align: left; margin-top: 4px; }
    .cat-der { text-align: left; }
    .cat-obs { display: none; }
    .cat-arw { display: none; }
  }

  .cat-vacio {
    padding-block: 42px;
    font-size: 13.5px;
    max-width: 52ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .cat-serie:hover, .cat-serie:focus-visible { padding-left: 12px; }
    .cat-serie:hover .cat-arw { transform: none; }
  }
</style>
