---
import { byCategory, categoryName, type Indicator } from '../lib/indicators';
import { num, periodoCorto, shortDate } from '../lib/format';
import { linea } from '../lib/graficos';

/**
 * Vista previa de la Base de Datos Profesional.
 *
 * No es un dibujo de una herramienta: es la herramienta, en pequeño y con una
 * sola sección. Las pestañas cambian de serie y el selector recorta el
 * histórico de verdad, contra los mismos datos que alimentan el Atlas. Un
 * mockup pintado prometería algo que no existe; esto enseña lo que hay.
 *
 * Se eligió el sector externo porque sus cuatro series tienen la misma unidad
 * y la misma frecuencia: al saltar de una a otra se compara algo, en vez de
 * cambiar de escala y de idioma a la vez.
 */

const SECTOR = 'externo';
const ANCHO = 720;
const ALTO = 250;

/* Los rangos que la serie puede sostener. Ofrecer «10 años» sobre cinco años
   de histórico no es una promesa, es una pantalla vacía. */
const RANGOS = [
  { id: '1', etiqueta: '1A', meses: 12 },
  { id: '3', etiqueta: '3A', meses: 36 },
  { id: '5', etiqueta: '5A', meses: 60 },
  { id: '10', etiqueta: '10A', meses: 120 },
  { id: 'max', etiqueta: 'Máx.', meses: 0 },
];

const series: Indicator[] = byCategory(SECTOR).slice(0, 4);

const mesesDe = (i: Indicator): number => {
  const a = new Date(`${i.history[0]!.d}T12:00:00Z`).getTime();
  const b = new Date(`${i.date}T12:00:00Z`).getTime();
  return (b - a) / (30.44 * 86_400_000);
};

/* Un rango se ofrece si alguna de las series llega hasta ahí. La que no
   llegue enseñará su histórico entero, que es lo que tiene. */
const masLargo = Math.max(...series.map(mesesDe));
const rangos = RANGOS.filter((r) => r.meses === 0 || r.meses < masLargo);

/* El payload del navegador: lo mínimo para poder redibujar. Las curvas no
   viajan hechas —se calculan al vuelo con la misma función que usa el
   servidor— porque un `path` de sesenta puntos pesa más que sus sesenta
   valores. */
const datos = series.map((i) => ({
  id: i.id,
  nombre: i.name,
  unidad: i.unit,
  decimales: i.decimals,
  fuente: i.source,
  frecuencia: i.frequency,
  actualizado: shortDate(i.updated),
  valor: num(i.value, i.decimals),
  periodo: periodoCorto(i.date, i.frequency),
  v: i.history.map((p) => p.v),
  /* Solo la etiqueta: el navegador no vuelve a formatear fechas. */
  p: i.history.map((p) => periodoCorto(p.d, i.frequency)),
}));

/* El primer dibujo sale del servidor, para que la pieza no aparezca vacía
   mientras carga el script ni dé un salto al montarse. */
const inicial = series[0]!;
const g = linea(inicial.history.map((p) => p.v), ANCHO, ALTO, true);
const valores0 = inicial.history.map((p) => p.v);
const max0 = Math.max(...valores0);
const min0 = Math.min(...valores0);
---

<figure class="vp" data-sector={SECTOR} data-vp data-ancho={ANCHO} data-alto={ALTO} data-reveal>
  <figcaption class="vp-barra">
    <span class="vp-sector">
      <span class="vp-punto" aria-hidden="true"></span>
      {categoryName(SECTOR)}
    </span>
    <span class="vp-aviso">Vista previa · series de demostración</span>
  </figcaption>

  <div class="vp-tabs" role="tablist" aria-label="Series del sector">
    {series.map((s, i) => (
      <button
        type="button"
        role="tab"
        class:list={['vp-tab', i === 0 && 'is-on']}
        data-vp-serie={s.id}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
      >
        {s.shortName}
      </button>
    ))}
  </div>

  <div class="vp-cuerpo">
    <div class="vp-cabeza">
      <div>
        <p class="vp-nombre" data-vp-nombre>{inicial.name}</p>
        <p class="vp-valor">
          <span class="vp-cifra tnum" data-vp-valor>{num(inicial.value, inicial.decimals)}</span>
          <span class="vp-unidad" data-vp-unidad>{inicial.unit}</span>
        </p>
        <p class="vp-periodo muted">
          Último dato: <span data-vp-periodo>{periodoCorto(inicial.date, inicial.frequency)}</span>
        </p>
      </div>

      <div class="vp-rangos" role="group" aria-label="Rango del histórico">
        {rangos.map((r, i) => (
          <button
            type="button"
            class:list={['vp-rango', i === rangos.length - 1 && 'is-on']}
            data-vp-rango={r.id}
            data-meses={r.meses}
            aria-pressed={i === rangos.length - 1 ? 'true' : 'false'}
          >
            {r.etiqueta}
          </button>
        ))}
      </div>
    </div>

    <div class="vp-grafico">
      <span class="vp-eje vp-eje-max tnum" data-vp-max>{num(max0, inicial.decimals)}</span>
      <span class="vp-eje vp-eje-min tnum" data-vp-min>{num(min0, inicial.decimals)}</span>

      <div class="vp-lienzo" data-vp-lienzo>
        <svg viewBox={`0 0 ${ANCHO} ${ALTO}`} preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="vp-relleno" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="currentColor" stop-opacity="0.22" />
              <stop offset="1" stop-color="currentColor" stop-opacity="0" />
            </linearGradient>
          </defs>
          <path data-vp-area d={g.area} fill="url(#vp-relleno)" />
          <path
            data-vp-linea
            d={g.linea}
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            vector-effect="non-scaling-stroke"
          />
        </svg>

        <span class="vp-cruz" aria-hidden="true"></span>
        <span class="vp-marca" aria-hidden="true"></span>
        <div class="vp-tip" aria-hidden="true">
          <span class="vp-tip-val tnum"></span>
          <span class="vp-tip-per"></span>
        </div>
      </div>
    </div>

    <div class="vp-fechas">
      <span data-vp-desde>{periodoCorto(inicial.history[0]!.d, inicial.frequency)}</span>
      <span data-vp-hasta>{periodoCorto(inicial.date, inicial.frequency)}</span>
    </div>

    <div class="vp-pie">
      <span data-vp-fuente>{inicial.source}</span>
      <span class="vp-sep" aria-hidden="true">·</span>
      <span data-vp-frecuencia>frecuencia {inicial.frequency.toLowerCase()}</span>
      <span class="vp-sep" aria-hidden="true">·</span>
      <span>Actualizado <span data-vp-actualizado>{shortDate(inicial.updated)}</span></span>
    </div>
  </div>

  <script type="application/json" data-vp-datos set:html={JSON.stringify(datos)} />
</figure>

<script>
  /**
   * La vista previa, viva.
   *
   * Reutiliza `linea()` del sitio en vez de reimplementar la curva aquí: el
   * trazo del navegador y el del servidor salen de la misma función, así que
   * al cambiar de pestaña el gráfico no cambia de carácter.
   */
  import { linea } from '../lib/graficos';

  const raiz = document.querySelector<HTMLElement>('[data-vp]');
  if (raiz) {
    type Serie = {
      id: string;
      nombre: string;
      unidad: string;
      decimales: number;
      fuente: string;
      frecuencia: string;
      actualizado: string;
      valor: string;
      periodo: string;
      v: number[];
      p: string[];
    };

    const guion = raiz.querySelector<HTMLScriptElement>('[data-vp-datos]');
    const series: Serie[] = JSON.parse(guion?.textContent ?? '[]');
    const ANCHO = Number(raiz.dataset.ancho) || 720;
    const ALTO = Number(raiz.dataset.alto) || 250;

    const cifra = (n: number, d: number) =>
      new Intl.NumberFormat('es-BO', {
        minimumFractionDigits: d,
        maximumFractionDigits: d,
      }).format(n);

    const q = <T extends Element>(sel: string) => raiz.querySelector<T>(sel);
    const area = q<SVGPathElement>('[data-vp-area]');
    const trazo = q<SVGPathElement>('[data-vp-linea]');
    const lienzo = q<HTMLElement>('[data-vp-lienzo]');
    const cruz = q<HTMLElement>('.vp-cruz');
    const marca = q<HTMLElement>('.vp-marca');
    const tip = q<HTMLElement>('.vp-tip');
    const tipVal = q<HTMLElement>('.vp-tip-val');
    const tipPer = q<HTMLElement>('.vp-tip-per');

    const pestanas = Array.from(raiz.querySelectorAll<HTMLButtonElement>('[data-vp-serie]'));
    const botonesRango = Array.from(raiz.querySelectorAll<HTMLButtonElement>('[data-vp-rango]'));

    let serie = series[0]!;
    let meses = Number(botonesRango[botonesRango.length - 1]?.dataset.meses ?? 0);
    let puntos: [number, number][] = [];
    let recorte: { v: number[]; p: string[] } = { v: [], p: [] };

    const texto = (sel: string, valor: string) => {
      const el = q<HTMLElement>(sel);
      if (el) el.textContent = valor;
    };

    /** Cuántas observaciones entran en el rango, según la frecuencia. */
    const cuantas = (s: Serie): number => {
      if (meses === 0) return s.v.length;
      const porMes =
        s.frecuencia === 'Diaria' ? 21 : s.frecuencia === 'Semanal' ? 4.3 : s.frecuencia === 'Trimestral' ? 1 / 3 : 1;
      return Math.max(2, Math.min(s.v.length, Math.round(meses * porMes)));
    };

    const dibujar = () => {
      const n = cuantas(serie);
      recorte = { v: serie.v.slice(-n), p: serie.p.slice(-n) };
      const g = linea(recorte.v, ANCHO, ALTO, true);
      puntos = g.puntos;
      area?.setAttribute('d', g.area);
      trazo?.setAttribute('d', g.linea);

      texto('[data-vp-max]', cifra(Math.max(...recorte.v), serie.decimales));
      texto('[data-vp-min]', cifra(Math.min(...recorte.v), serie.decimales));
      texto('[data-vp-desde]', recorte.p[0] ?? '');
      texto('[data-vp-hasta]', recorte.p[recorte.p.length - 1] ?? '');
    };

    const mostrarSerie = () => {
      texto('[data-vp-nombre]', serie.nombre);
      texto('[data-vp-valor]', serie.valor);
      texto('[data-vp-unidad]', serie.unidad);
      texto('[data-vp-periodo]', serie.periodo);
      texto('[data-vp-fuente]', serie.fuente);
      texto('[data-vp-frecuencia]', `frecuencia ${serie.frecuencia.toLowerCase()}`);
      texto('[data-vp-actualizado]', serie.actualizado);
      dibujar();
    };

    pestanas.forEach((b) =>
      b.addEventListener('click', () => {
        const encontrada = series.find((s) => s.id === b.dataset.vpSerie);
        if (!encontrada) return;
        serie = encontrada;
        pestanas.forEach((o) => {
          const activo = o === b;
          o.classList.toggle('is-on', activo);
          o.setAttribute('aria-selected', String(activo));
          o.tabIndex = activo ? 0 : -1;
        });
        mostrarSerie();
      }),
    );

    botonesRango.forEach((b) =>
      b.addEventListener('click', () => {
        meses = Number(b.dataset.meses ?? 0);
        botonesRango.forEach((o) => {
          const activo = o === b;
          o.classList.toggle('is-on', activo);
          o.setAttribute('aria-pressed', String(activo));
        });
        dibujar();
      }),
    );

    /* El mismo hover que en el tablero: el puntero se ancla a la observación
       más cercana, no al píxel que haya debajo. */
    let ultimo = -1;
    lienzo?.addEventListener('mouseenter', () => lienzo.classList.add('es-hover'));
    lienzo?.addEventListener('mouseleave', () => {
      lienzo.classList.remove('es-hover');
      ultimo = -1;
    });
    lienzo?.addEventListener('mousemove', (e) => {
      const caja = lienzo.getBoundingClientRect();
      if (caja.width === 0 || puntos.length === 0) return;
      const x = ((e.clientX - caja.left) / caja.width) * ANCHO;
      let i = 0;
      for (let k = 1; k < puntos.length; k += 1) {
        if (Math.abs(puntos[k]![0] - x) < Math.abs(puntos[i]![0] - x)) i = k;
      }
      if (i === ultimo) return;
      ultimo = i;

      const izq = (puntos[i]![0] / ANCHO) * 100;
      const arriba = (puntos[i]![1] / ALTO) * 100;
      if (cruz) cruz.style.left = `${izq}%`;
      if (marca) {
        marca.style.left = `${izq}%`;
        marca.style.top = `${arriba}%`;
      }
      if (tipVal) tipVal.textContent = `${cifra(recorte.v[i]!, serie.decimales)} ${serie.unidad}`;
      if (tipPer) tipPer.textContent = recorte.p[i] ?? '';
      if (tip) {
        const mitad = tip.offsetWidth / 2;
        const centro = (puntos[i]![0] / ANCHO) * caja.width;
        tip.style.left = `${Math.min(Math.max(centro, mitad + 2), caja.width - mitad - 2)}px`;
        tip.style.top = `${arriba}%`;
      }
    });

    dibujar();
  }
</script>

<style>
  /* La pieza imita la ventana de una aplicación: barra de título, pestañas y
     cuerpo. Es el único sitio del Atlas donde eso está justificado, porque lo
     que se enseña es, literalmente, una aplicación. */
  .vp {
    margin: 0;
    border: 1px solid var(--line, var(--line-light));
    border-radius: 14px;
    overflow: hidden;
    background: var(--color-paper);
    color: var(--serie, var(--color-teal-600));
    box-shadow: 0 30px 60px -46px rgb(3 26 36 / 0.55);
  }

  .vp-barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 16px;
    border-bottom: 1px solid var(--line, var(--line-light));
    background: color-mix(in srgb, var(--color-ink) 4%, transparent);
  }
  .vp-sector {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-ink);
  }
  .vp-punto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--serie);
  }
  .vp-aviso {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .vp-tabs {
    display: flex;
    gap: 2px;
    padding: 0 10px;
    border-bottom: 1px solid var(--line, var(--line-light));
    overflow-x: auto;
    scrollbar-width: none;
  }
  .vp-tabs::-webkit-scrollbar { width: 0; height: 0; }
  .vp-tab {
    flex: 0 0 auto;
    padding: 10px 12px 11px;
    margin-bottom: -1px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 12px;
    white-space: nowrap;
    cursor: pointer;
    transition: color 180ms ease, border-color 180ms ease;
  }
  .vp-tab:hover { color: var(--color-ink); }
  .vp-tab.is-on {
    color: var(--color-ink);
    font-weight: 600;
    border-bottom-color: var(--serie);
  }
  .vp-tab:focus-visible { outline: 2px solid var(--serie); outline-offset: -4px; }

  .vp-cuerpo { padding: 18px 18px 14px; }

  .vp-cabeza {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
  }
  .vp-nombre { font-size: 12.5px; font-weight: 600; color: var(--color-ink); }
  .vp-valor { display: flex; align-items: baseline; gap: 6px; margin-top: 8px; color: var(--color-ink); }
  .vp-cifra {
    font-family: var(--font-display);
    font-size: 2.1rem;
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .vp-unidad { font-size: 12px; color: var(--muted); }
  .vp-periodo { margin-top: 5px; font-size: 11px; }

  .vp-rangos {
    display: inline-flex;
    border: 1px solid var(--line, var(--line-light));
    border-radius: 6px;
    overflow: hidden;
  }
  .vp-rango {
    padding: 5px 11px;
    border: 0;
    border-left: 1px solid var(--line, var(--line-light));
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 11.5px;
    cursor: pointer;
    transition: color 160ms ease, background-color 160ms ease;
  }
  .vp-rango:first-child { border-left: 0; }
  .vp-rango:hover { color: var(--color-ink); }
  .vp-rango.is-on { background: var(--color-ink); color: var(--color-paper); font-weight: 600; }

  /* --- el gráfico --- */
  .vp-grafico { position: relative; margin-top: 16px; padding-left: 52px; }
  .vp-eje {
    position: absolute;
    left: 0;
    width: 46px;
    text-align: right;
    font-size: 10px;
    color: var(--muted);
  }
  .vp-eje-max { top: -4px; }
  .vp-eje-min { bottom: -4px; }

  .vp-lienzo { position: relative; }
  .vp-lienzo svg { display: block; width: 100%; height: 250px; }

  .vp-cruz,
  .vp-marca,
  .vp-tip {
    position: absolute;
    pointer-events: none;
    visibility: hidden;
  }
  .es-hover .vp-cruz,
  .es-hover .vp-marca,
  .es-hover .vp-tip { visibility: visible; }

  .vp-cruz {
    top: 0;
    bottom: 0;
    width: 1px;
    background: currentColor;
    opacity: 0.32;
    transform: translateX(-0.5px);
  }
  .vp-marca {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 2px var(--color-paper);
    transform: translate(-50%, -50%);
  }
  .vp-tip {
    z-index: 3;
    transform: translate(-50%, calc(-100% - 12px));
    display: grid;
    gap: 1px;
    padding: 6px 9px;
    border-radius: 7px;
    background: var(--color-ink);
    color: var(--color-paper);
    white-space: nowrap;
    box-shadow: 0 12px 26px -14px rgb(3 26 36 / 0.7);
  }
  .vp-tip-val { font-size: 13px; font-weight: 600; }
  .vp-tip-per { font-size: 10px; opacity: 0.66; }

  .vp-fechas {
    display: flex;
    justify-content: space-between;
    margin: 8px 0 0 52px;
    font-size: 10px;
    color: var(--muted);
  }

  .vp-pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--line, var(--line-light));
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .vp-sep { opacity: 0.5; }

  @media (max-width: 620px) {
    .vp-grafico { padding-left: 0; }
    .vp-eje { display: none; }
    .vp-fechas { margin-left: 0; }
    .vp-lienzo svg { height: 200px; }
  }
</style>
