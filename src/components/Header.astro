---
import { nav, site } from '../site.config';
import { stripBase, withBase } from '../lib/url';
import Logo from './Logo.astro';
import SearchOverlay from './SearchOverlay.astro';

export interface Props {
  /** En la portada el header arranca transparente sobre la fotografía. */
  transparentAtTop?: boolean;
}

const { transparentAtTop = false } = Astro.props;
// `nav` declara las rutas sin prefijo, así que la ruta del navegador se compara
// una vez quitado el `base`.
const path = stripBase(Astro.url.pathname).replace(/\/$/, '') || '/';

const isActive = (href: string): boolean =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);

const mainNav = nav.filter((item) => item.href !== '/');
---

<header
  data-header
  class:list={['site-header no-print', transparentAtTop && 'is-over-hero']}
>
  <div class="wrap header-inner">
    <a href={withBase('/')} class="brand" aria-label={`${site.name} — inicio`}>
      <Logo variant="light" layout="horizontal" height={40} eager class="brand-logo" />
      <span class="brand-tag">Centro de Inteligencia en Desarrollo<br />Económico y Financiero</span>
    </a>

    <nav class="main-nav" aria-label="Navegación principal">
      <ul>
        {
          mainNav.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                class="link-underline"
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <button
        type="button"
        data-search-toggle
        class="icon-btn"
        aria-label="Buscar en el sitio"
        aria-expanded="false"
        aria-controls="buscador"
      >
        <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
          <circle cx="8.6" cy="8.6" r="5.4" />
          <path d="M12.6 12.6 17 17" stroke-linecap="round" />
        </svg>
      </button>

      <button
        type="button"
        data-menu-toggle
        class="icon-btn menu-btn"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-movil"
      >
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- Menú móvil ------------------------------------------------------------ -->
<div id="menu-movil" class="overlay" data-menu-panel data-open="false" aria-hidden="true">
  <div class="overlay-head wrap">
    <span class="eyebrow eyebrow-gold">Navegación</span>
    <button type="button" data-close class="icon-btn" aria-label="Cerrar menú">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M5 5l10 10M15 5L5 15" stroke-linecap="round" />
      </svg>
    </button>
  </div>
  <nav class="wrap overlay-nav" aria-label="Navegación móvil">
    <ul>
      {
        nav.map((item, i) => (
          <li>
            <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
              <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="overlay-label">{item.label}</span>
              {item.description && <span class="overlay-desc">{item.description}</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<SearchOverlay />

<style>
  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 60;
    background: var(--color-ink);
    color: var(--color-paper);
    --line: var(--line-dark);
    border-bottom: 1px solid var(--line-dark);
    transition: background-color 280ms ease, border-color 280ms ease,
      backdrop-filter 280ms ease, box-shadow 280ms ease;
  }

  .site-header.is-over-hero {
    background: transparent;
    border-bottom-color: transparent;
  }

  .site-header.is-compact {
    background: color-mix(in srgb, #031a24 88%, transparent);
    -webkit-backdrop-filter: blur(6px) saturate(1.1);
    backdrop-filter: blur(6px) saturate(1.1);
    border-bottom-color: var(--line-dark);
    box-shadow: 0 1px 24px rgb(0 0 0 / 0.22);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 96px;
    transition: height 280ms ease;
  }
  .site-header.is-compact .header-inner {
    height: 68px;
  }

  /* --- marca --- */
  .brand {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }
  .brand-logo {
    width: auto;
    transition: height 280ms ease;
  }
  /* `Logo.astro` fija la altura en línea; aquí se ajusta al estado compacto. */
  .site-header.is-compact .brand-logo {
    height: 32px !important;
  }
  .brand-tag {
    display: none;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.6;
    text-transform: uppercase;
    color: color-mix(in srgb, #f5f3ed 58%, transparent);
    border-left: 1px solid var(--line-dark);
    padding-left: 16px;
    transition: opacity 240ms ease;
  }
  @media (min-width: 1240px) {
    .brand-tag { display: inline-block; }
  }
  .site-header.is-compact .brand-tag { opacity: 0; }

  /* --- navegación --- */
  .main-nav { display: none; }
  @media (min-width: 1024px) {
    .main-nav { display: block; }
  }
  .main-nav ul {
    display: flex;
    align-items: center;
    gap: 26px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .main-nav a {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.01em;
    padding-block: 4px;
    white-space: nowrap;
  }
  .main-nav a[aria-current='page'] { color: var(--color-gold); }

  /* --- acciones --- */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line-dark);
    border-radius: var(--radius-sm);
    color: inherit;
    background: transparent;
    cursor: pointer;
    transition: border-color 200ms ease, background-color 200ms ease;
  }
  .icon-btn:hover {
    border-color: color-mix(in srgb, #f5f3ed 45%, transparent);
    background: color-mix(in srgb, #f5f3ed 8%, transparent);
  }

  .menu-btn { flex-direction: column; gap: 5px; }
  @media (min-width: 1024px) { .menu-btn { display: none; } }
  .menu-btn span {
    display: block;
    width: 15px;
    height: 1.5px;
    background: currentColor;
  }

  .explore-btn {
    display: none;
    align-items: center;
    gap: 8px;
    padding: 8px 15px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid color-mix(in srgb, #d29a28 55%, transparent);
    border-radius: var(--radius-sm);
    color: var(--color-gold);
    transition: background-color 200ms ease, color 200ms ease;
  }
  @media (min-width: 620px) { .explore-btn { display: inline-flex; } }
  .explore-btn:hover { background: var(--color-gold); color: var(--color-ink); }
  .explore-btn .arw { transition: transform 220ms cubic-bezier(0.22, 0.61, 0.36, 1); }
  .explore-btn:hover .arw { transform: translateX(3px); }

  /* --- overlay --- */
  .overlay {
    position: fixed;
    inset: 0;
    z-index: 70;
    background: var(--color-ink);
    color: var(--color-paper);
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 260ms ease, transform 320ms cubic-bezier(0.22, 0.61, 0.36, 1),
      visibility 260ms;
  }
  .overlay[data-open='true'] {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .overlay-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 96px;
    flex-shrink: 0;
    border-bottom: 1px solid var(--line-dark);
  }
  .overlay-nav {
    flex: 1;
    overflow-y: auto;
    padding-block: 20px 40px;
  }
  .overlay-nav ul { list-style: none; margin: 0; padding: 0; }
  .overlay-nav li + li { border-top: 1px solid var(--line-dark); }
  .overlay-nav a {
    display: grid;
    grid-template-columns: 34px 1fr;
    align-items: baseline;
    gap: 4px 8px;
    padding-block: 20px;
  }
  .overlay-label {
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1.1;
  }
  .overlay-desc {
    grid-column: 2;
    font-size: 12.5px;
    color: color-mix(in srgb, #f5f3ed 55%, transparent);
  }
  .overlay-nav a[aria-current='page'] .overlay-label { color: var(--color-gold); }
</style>
