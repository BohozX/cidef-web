---
import { withBase, withBaseSrcset } from '../../lib/url';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Newsletter from '../../components/Newsletter.astro';
import { categories, featured, indicators, lastUpdated } from '../../lib/indicators';
import { shortDate, num } from '../../lib/format';
import Tableros from '../../components/Tableros.astro';
import LeyendaSellos from '../../components/LeyendaSellos.astro';
import { atajos, categories as todasCategorias, SECTORES, higherIsBetter } from '../../lib/indicators';

/* La tira de la cabecera: lo que se mira cada mañana. Cada atajo dice qué
   mide y de cuándo es el dato: «inflación» a secas no informa de nada si no
   se sabe si es mensual o interanual, ni de qué mes. */
const MESES = [
  'enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio',
  'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre',
];
const ROMANOS = ['I', 'II', 'III', 'IV'];

const periodo = (iso: string, frecuencia: string): string => {
  const f = new Date(iso);
  const mes = f.getUTCMonth();
  const anio = f.getUTCFullYear();
  if (frecuencia === 'Trimestral') return `${ROMANOS[Math.floor(mes / 3)]} trimestre ${anio}`;
  if (frecuencia === 'Diaria') return `${f.getUTCDate()} de ${MESES[mes]} de ${anio}`;
  return `${MESES[mes]} de ${anio}`;
};

const tira = atajos().map((i) => ({ i, periodo: periodo(i.date, i.frequency) }));

/* Los sectores, en el orden en que se recorren. */
const sectores = SECTORES.map((id) => todasCategorias.find((c) => c.id === id)).filter(
  (c): c is NonNullable<typeof c> => Boolean(c),
);
import { covers } from '../../site.config';

const panorama = featured();
const updated = shortDate(lastUpdated());

const sections = categories
  .filter((c) => c.id !== 'panorama')
  .map((c) => ({ ...c, items: indicators.filter((i) => i.category === c.id) }))
  .filter((c) => c.items.length > 0);

const frequencies = [...new Set(indicators.map((i) => i.frequency))].sort();
const sources = [...new Set(indicators.map((i) => i.source))].sort();

const facts = [
  { label: 'Indicadores', value: String(indicators.length) },
  { label: 'Categorías', value: String(sections.length) },
  { label: 'Propios del centro', value: String(indicators.filter((i) => i.own).length) },
  { label: 'Actualizado', value: updated },
];
---

<BaseLayout
  title="Radar Económico"
  description="Plataforma de indicadores de la economía boliviana: actividad, precios, monetario y financiero, mercado cambiario, sector externo, fiscal, empleo, indicadores sociales, economía internacional y estimaciones propias del CIDEF."
  bleed
>
  <PageHero
    eyebrow="Radar Económico"
    title="La economía boliviana, en un tablero"
    lede="Explora los principales indicadores macroeconómicos, financieros y sectoriales de Bolivia, junto con las estimaciones, índices y proyecciones que elabora el centro."
    cover={covers.radar}
  >
    <div slot="actions" class="radar-acciones" data-hero-item>
      {/* Atajos: qué mide, cuánto y de cuándo. Sin cinta de bolsa: seis
          series, y cada una dice su período de referencia. */}
      <ul class="radar-tira">
        {tira.map(({ i, periodo: p }) => {
          const sube = i.change >= 0;
          const bueno = sube === higherIsBetter(i.id);
          return (
            <li>
              <a href={withBase(`/radar/${i.id}`)}>
                <span class="tira-nombre">{i.name}</span>
                <span class="tira-linea">
                  <span class="tira-valor tnum">{num(i.value, i.decimals)}</span>
                  <span class="tira-unidad">{i.unit}</span>
                  <span class:list={['tira-var', 'tnum', bueno ? 'es-bueno' : 'es-malo']}>
                    {sube ? '▲' : '▼'} {num(Math.abs(i.change), i.decimals)} {i.changeUnit}
                  </span>
                </span>
                <span class="tira-periodo">{p}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </PageHero>

  <!-- LOS TABLEROS ---------------------------------------------------------- -->
  <section class="surface-light section" aria-labelledby="panorama">
    <div class="wrap">
      <div class="radar-sec-head">
        <div>
          <p class="eyebrow eyebrow-gold" data-reveal>Panorama económico</p>
          <h2 id="panorama" class="display-3 radar-sec-title" data-reveal>
            Qué está pasando en la economía boliviana
          </h2>
        </div>
        <p class="radar-sec-note muted" data-reveal>
          Cada pieza usa el gráfico que su dato pide: el crecimiento en barras,
          el tipo de cambio en línea, las reservas en área y el saldo comercial
          a ambos lados del cero. Series de demostración.
        </p>
      </div>

      <Tableros />

      <LeyendaSellos />

      <div class="radar-mas" data-reveal>
        <p class="radar-mas-texto">
          Cada tablero muestra una selección de su sector. El catálogo completo
          —todas las series, con su frecuencia, su fuente y su histórico— está en
          la Base de Datos Profesional.
        </p>
        <a href={withBase('/base')} class="btn btn-solid">
          Ver más datos
          <svg class="arw" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M2 8h11M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- HACIA LA BASE DE DATOS ------------------------------------------------ -->
  <section class="surface-mist section edge-tr" aria-labelledby="mas-alla">
    <div class="wrap">
      <div class="base-grid">
        <div>
          <p class="eyebrow base-eyebrow" data-reveal>Base de Datos Profesional</p>
          <h2 id="mas-alla" class="display-2 base-title" data-reveal>Más allá del dato visible</h2>
          <p class="base-text" data-reveal>
            El centro desarrolla y mantiene una base de datos económica que integra
            estadísticas oficiales, series históricas, indicadores derivados,
            estimaciones propias, proyecciones y resultados construidos a partir de
            nuestras investigaciones.
          </p>

          <div class="base-acciones no-print" data-reveal>
            <a href={withBase('/base')} class="btn btn-solid">
              Explorar la Base de Datos
              <svg class="arw" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M2 8h11M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <a href={withBase('/base#proximo')} class="btn btn-outline">Qué abre la cuenta</a>
          </div>
        </div>

        <div>
          <h3 class="eyebrow muted base-h" data-reveal>Qué incluye</h3>
          <ul class="base-lista" data-reveal-group data-reveal-stagger="0.04">
            {
              [
                'Histórico completo y series armonizadas',
                'Mayor frecuencia, hasta datos diarios',
                'Indicadores propios y variables no observables',
                'Proyecciones con intervalos de confianza',
                'Historial de versiones de cada estimación',
                'Descarga en CSV y XLSX, y acceso por API',
                'Comparación y transformación entre series',
                'Metadatos y metodología completos',
              ].map((t) => <li data-reveal>{t}</li>)
            }
          </ul>
        </div>
      </div>

      <p class="base-nota muted" data-reveal>
        El Radar sirve para <strong>descubrir, visualizar y entender</strong>. La base
        profesional, para <strong>investigar, comparar, transformar y modelar</strong>.
        Lo que se ve aquí seguirá siendo público y actualizado.
      </p>
    </div>
  </section>

  <Newsletter />
</BaseLayout>

<style>
  /* --- hacia la base profesional ---------------------------------------- */
  .base-grid {
    display: grid;
    gap: clamp(30px, 4vw, 64px);
  }
  @media (min-width: 900px) {
    .base-grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: start; }
  }
  .base-title { margin-top: 14px; max-width: 16ch; }
  .base-text { margin-top: 20px; font-size: 15px; line-height: 1.72; }
  .base-acciones { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }

  /* Sobre plomo el dorado gritaba. El acento pasa al verde del centro, que
     es el color con el que se lee todo lo demás del Radar. */
  .base-eyebrow { color: var(--color-teal-600); }
  .base-h { display: block; margin-bottom: 16px; }
  .base-lista { list-style: none; margin: 0; padding: 0; }
  .base-lista li {
    position: relative;
    padding: 11px 0 11px 22px;
    border-top: 1px solid var(--line, var(--line-dark));
    font-size: 13.5px;
  }
  .base-lista li:last-child { border-bottom: 1px solid var(--line, var(--line-dark)); }
  .base-lista li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.35em;
    width: 8px;
    height: 1px;
    background: var(--color-teal);
  }

  .base-nota {
    margin-top: clamp(28px, 3.5vw, 46px);
    font-size: 13px;
    max-width: 76ch;
  }
  .base-nota strong { color: var(--color-teal-600); font-weight: 600; }

  /* --- cabecera del Radar ---------------------------------------------- */
  .radar-acciones {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    margin-top: 30px;
    width: 100%;
  }

  /* Cada atajo es una ficha mínima: qué mide, cuánto, y de qué período. */
  /* Las seis en un renglón: repartidas por ancho disponible se partían en
     cinco y una, y la huérfana parecía un dato de otra categoría. */
  .radar-tira {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px clamp(14px, 2.2vw, 32px);
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 1180px;
  }
  @media (min-width: 640px) { .radar-tira { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1040px) { .radar-tira { grid-template-columns: repeat(6, minmax(0, 1fr)); } }

  .radar-tira a {
    display: grid;
    align-content: start;
    gap: 5px;
    text-align: center;
    transition: color 200ms ease;
  }
  .radar-tira a:hover { color: var(--color-gold); }

  /* Dos líneas reservadas para el nombre: con nombres de largo distinto, las
     cifras se descolocaban unas respecto de otras. */
  .tira-nombre {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5em;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.13em;
    line-height: 1.25;
    text-transform: uppercase;
    color: color-mix(in srgb, #f5f3ed 62%, transparent);
  }
  .tira-linea {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 6px;
  }
  .tira-valor { font-size: 17px; font-weight: 600; letter-spacing: -0.02em; }
  .tira-unidad { font-size: 10px; color: color-mix(in srgb, #f5f3ed 55%, transparent); }
  .tira-var { font-size: 10.5px; }
  .tira-var.es-bueno { color: var(--color-teal-300); }
  .tira-var.es-malo { color: #e0a06a; }
  .tira-periodo {
    font-size: 10.5px;
    color: color-mix(in srgb, #f5f3ed 52%, transparent);
  }

  /* --- sectores --------------------------------------------------------- */
  .radar-sectores {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: clamp(26px, 3vw, 40px);
  }
  .radar-sector {
    padding: 8px 16px;
    border: 1px solid var(--line, var(--line-light));
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
    transition: transform 260ms cubic-bezier(0.22, 0.61, 0.36, 1),
      border-color 220ms ease, color 220ms ease;
  }
  .radar-sector:hover {
    transform: translateY(-2px);
    border-color: var(--color-gold);
    color: var(--color-gold);
  }
  @media (prefers-reduced-motion: reduce) {
    .radar-sector:hover { transform: none; }
  }

  .radar-sec-head {
    display: grid;
    gap: 18px;
    padding-bottom: 34px;
  }
  @media (min-width: 900px) {
    .radar-sec-head {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
      gap: 48px;
      align-items: end;
    }
  }
  .radar-sec-title { margin-top: 14px; max-width: 20ch; }

  /* La puerta a la base profesional: cierra el tablero y explica por qué hay
     más al otro lado, en vez de un botón suelto sin motivo. */
  .radar-mas {
    display: grid;
    gap: 16px;
    justify-items: start;
    margin-top: clamp(30px, 3.6vw, 48px);
    padding-top: clamp(24px, 3vw, 34px);
    border-top: 1px solid var(--line, var(--line-light));
  }
  @media (min-width: 860px) {
    .radar-mas {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 34px;
    }
  }
  .radar-mas-texto { font-size: 13px; max-width: 72ch; }
  .radar-sec-note { font-size: 13px; max-width: 42ch; }

  .ind-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 258px), 1fr));
  }

  /* --- filtros --- */
  .radar-filters {
    display: grid;
    gap: 18px;
    padding-bottom: 22px;
  }
  .radar-search {
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid var(--line-light);
    padding-bottom: 12px;
    color: var(--muted);
  }
  .radar-input {
    flex: 1;
    background: transparent;
    border: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.4vw, 1.7rem);
    padding: 0;
  }
  .radar-input:focus { outline: none; }
  .radar-input::-webkit-search-cancel-button { display: none; }

  .radar-selects { display: flex; flex-wrap: wrap; gap: 10px; }
  .radar-selects select { flex: 1 1 180px; max-width: 260px; }

  .cat-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-bottom: 26px;
  }
  .cat-chip {
    padding: 6px 14px;
    border: 1px solid var(--line-light);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    transition: border-color 200ms ease, color 200ms ease;
  }
  .cat-chip:hover { border-color: var(--color-teal); color: var(--color-teal-600); }

  .radar-count {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    padding-bottom: 8px;
  }

  /* --- categorías --- */
  .cat-section {
    padding-top: clamp(40px, 5vw, 64px);
    scroll-margin-top: 96px;
  }
  .cat-head {
    display: grid;
    gap: 12px;
    padding-block: 22px 26px;
  }
  @media (min-width: 760px) {
    .cat-head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: baseline;
      gap: 32px;
    }
  }
  .cat-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }
  .cat-badge { font-family: var(--font-sans); }
  .cat-desc { margin-top: 8px; font-size: 13.5px; max-width: 60ch; }
  .cat-count {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .cat-section.is-own {
    border-left: 2px solid var(--color-gold);
    padding-left: clamp(18px, 3vw, 34px);
    margin-top: clamp(24px, 4vw, 48px);
  }

  .own-note {
    margin-bottom: 26px;
    padding: 16px 18px;
    border: 1px solid color-mix(in srgb, #d29a28 40%, transparent);
    background: color-mix(in srgb, #d29a28 7%, transparent);
    border-radius: var(--radius-md);
    font-size: 13px;
    line-height: 1.6;
    max-width: 78ch;
  }
  .own-note strong { font-weight: 600; }

  .radar-empty { padding-block: 52px; font-size: 14px; }
</style>
