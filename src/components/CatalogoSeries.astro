---
import { withBase } from '../lib/url';
import { indicators, categories, SECTORES, ETIQUETA } from '../lib/indicators';

/**
 * El catálogo de la base profesional: las series disponibles, por su nombre.
 *
 * No es el tablero ni la ficha: es el índice. Llevaba seis columnas —tipo de
 * dato, frecuencia, observaciones, último valor, período— y con tres o cuatro
 * series por sector eso era una hoja de cálculo para decir tres nombres. Todo
 * eso vive en la ficha de la serie, que es donde además está el gráfico y el
 * histórico; aquí solo hay que elegir cuál se abre.
 *
 * Con `sector` lista solo ese sector y se apoya en el título de la página que
 * lo contiene; sin él los lista todos, agrupados, que es como abría la base
 * antes de repartirse en una página por sector.
 */

export interface Props {
  sector?: string;
}

const { sector } = Astro.props;

const grupos = SECTORES.filter((id) => id !== 'panorama')
  .filter((id) => !sector || id === sector)
  .map((id) => {
    const cat = categories.find((c) => c.id === id);
    const series = indicators
      .filter((i) => i.category === id)
      .sort((a, b) => a.name.localeCompare(b.name, 'es'));
    return { id, cat, series };
  })
  .filter((g) => g.cat && g.series.length > 0);

const total = grupos.reduce((s, g) => s + g.series.length, 0);
---

{/* Solo el buscador. Los dos desplegables —tipo de dato y frecuencia— se
    retiraron: dentro de un sector hay tres o cuatro series y filtrarlas por
    frecuencia es elegir entre dos opciones para descartar una fila. Con el
    catálogo entero delante tenían sentido; aquí eran dos cajas que pesaban
    más que la tabla que ordenaban. */}
<div class="cat-filtros no-print" data-reveal>
  <div class="cat-buscar">
    <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
      <circle cx="9" cy="9" r="6" />
      <path d="M13.5 13.5 17 17" stroke-linecap="round" />
    </svg>
    <input
      type="search"
      class="cat-input"
      placeholder={sector ? 'Buscar una serie o una fuente' : 'Buscar una serie, una fuente, un sector'}
      aria-label="Buscar en el catálogo"
      data-cat-buscar
    />
  </div>
</div>

<p class="sr-only" role="status" data-cat-cuenta>{total} series disponibles</p>

<div class="cat-grupos">
  {
    grupos.map((g) => (
      <section
        class="cat-grupo"
        id={`seccion-${g.id}`}
        data-grupo
        aria-label={sector ? g.cat!.name : undefined}
        aria-labelledby={sector ? undefined : `t-${g.id}`}
      >
        {/* En la página de un sector el encabezado sobra: lo acaba de decir
            el título de la página, y repetirlo empuja la tabla hacia abajo. */}
        {!sector && (
          <header class="cat-grupo-head">
            <h3 id={`t-${g.id}`} class="cat-grupo-nombre">{g.cat!.name}</h3>
            <p class="cat-grupo-desc muted">{g.cat!.description}</p>
          </header>
        )}

        <div class="cat-tabla">
          {g.series.map((i) => (
            <a
              class="cat-fila cat-serie"
              href={withBase(`/atlas/${i.id}`)}
              target="_blank"
              rel="noopener"
              data-serie
              data-tipo={i.kind}
              data-frecuencia={i.frequency}
              data-texto={`${i.name} ${i.shortName} ${i.source} ${g.cat!.name}`.toLowerCase()}
            >
              <span class="cat-titulo">
                {i.name}
                {/* El sello solo aparece cuando dice algo: en un sector donde
                    todo es oficial, repetirlo en cada línea era escribir la
                    misma palabra tres veces y que lo que sí hay que
                    distinguir —lo que calcula el centro— pasara inadvertido. */}
                {i.kind !== 'oficial' && (
                  <span class:list={['cat-sello', `sello-${i.kind}`]}>{ETIQUETA[i.kind]}</span>
                )}
              </span>
              <span class="cat-arw" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M2 8h11M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </a>
          ))}
        </div>
      </section>
    ))
  }
</div>

<p class="cat-vacio" data-cat-vacio hidden>
  Ninguna serie coincide con esa búsqueda. Prueba con el nombre del indicador
  o con la fuente que lo publica.
</p>

<script>
  /* Filtrado en el navegador: el catálogo entero viene en el HTML, así que
     buscar no pide nada al servidor. Un sector cuyas series se han filtrado
     todas se oculta entero: dejar el encabezado suelto hace creer que el
     sector está vacío. */
  const buscar = document.querySelector<HTMLInputElement>('[data-cat-buscar]');
  const cuenta = document.querySelector<HTMLElement>('[data-cat-cuenta]');
  const vacio = document.querySelector<HTMLElement>('[data-cat-vacio]');
  const grupos = Array.from(document.querySelectorAll<HTMLElement>('[data-grupo]'));

  const normal = (t: string): string =>
    t.toLowerCase().normalize('NFD').replace(/\p{Diacritic}/gu, '');

  const filtrar = () => {
    const q = normal(buscar?.value.trim() ?? '');
    let visibles = 0;

    grupos.forEach((g) => {
      let enGrupo = 0;
      g.querySelectorAll<HTMLElement>('[data-serie]').forEach((fila) => {
        const ok = !q || normal(fila.dataset.texto ?? '').includes(q);
        fila.hidden = !ok;
        if (ok) enGrupo += 1;
      });
      g.hidden = enGrupo === 0;
      visibles += enGrupo;
    });

    if (cuenta) cuenta.textContent = `${visibles} ${visibles === 1 ? 'serie' : 'series'} a la vista`;
    if (vacio) vacio.hidden = visibles > 0;
  };

  buscar?.addEventListener('input', filtrar);
</script>

<style>
  /* --- el buscador --------------------------------------------------------
     Una línea corta y a la izquierda. Ocupando el ancho entero parecía el
     asunto principal de la página, y el asunto es la tabla que hay debajo. */
  .cat-filtros { padding-bottom: clamp(22px, 2.6vw, 32px); }
  .cat-buscar {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 360px;
    border-bottom: 1px solid var(--line, var(--line-light));
    padding-bottom: 8px;
    color: var(--muted);
    transition: border-color 200ms ease;
  }
  .cat-buscar:focus-within { border-bottom-color: color-mix(in srgb, var(--color-ink) 45%, transparent); }
  .cat-input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    color: inherit;
    font-family: inherit;
    font-size: 13px;
    padding: 0;
  }
  .cat-input:focus { outline: none; }
  .cat-input::-webkit-search-cancel-button { display: none; }

  .cat-selects { display: flex; flex-wrap: wrap; gap: 10px; }
  .cat-selects .field { width: auto; min-width: 190px; font-size: 13px; padding: 9px 12px; }

  /* --- grupos ------------------------------------------------------------ */
  .cat-grupo { scroll-margin-top: 96px; }
  .cat-grupo + .cat-grupo { margin-top: clamp(34px, 4vw, 56px); }

  .cat-grupo-head {
    display: grid;
    gap: 6px;
    padding-bottom: 14px;
  }
  @media (min-width: 900px) {
    .cat-grupo-head {
      grid-template-columns: minmax(0, auto) minmax(0, 1fr);
      align-items: baseline;
      gap: 26px;
    }
  }
  .cat-grupo-nombre {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .cat-grupo-desc { font-size: 12.5px; text-align: left; }

  /* --- las líneas ---------------------------------------------------------
     Una línea por serie: el nombre, y el sello cuando lo lleva. La cabecera
     de columnas se fue con las columnas. */
  .cat-fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 15px 10px 15px 12px;
    border-top: 1px solid var(--line, var(--line-light));
  }

  /* La línea entera es el enlace: el nombre no basta como blanco cuando hay
     treinta seguidas. */
  .cat-serie {
    transition: background-color 200ms ease, padding-left 240ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .cat-serie:hover,
  .cat-serie:focus-visible {
    background: color-mix(in srgb, currentColor 4%, transparent);
    padding-left: 18px;
  }
  .cat-serie:last-child { border-bottom: 1px solid var(--line, var(--line-light)); }

  /* El sello va pegado al nombre, no en una columna propia: así solo ocupa
     sitio en las líneas que lo llevan. */
  .cat-titulo {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 10px;
    min-width: 0;
    font-size: 14px;
    font-weight: 500;
  }

  .cat-sello {
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  .sello-estimacion { color: var(--color-teal-600); }
  .sello-proyeccion { color: var(--color-gold); }

  .cat-arw { color: var(--color-teal-600); opacity: 0; transition: opacity 200ms ease, transform 220ms cubic-bezier(0.22, 0.61, 0.36, 1); }
  .cat-serie:hover .cat-arw, .cat-serie:focus-visible .cat-arw { opacity: 1; transform: translateX(3px); }

  @media (max-width: 899px) {
    .cat-titulo { font-size: 13.5px; }
    .cat-sello { font-size: 8px; }
    .cat-arw { display: none; }
  }

  .cat-vacio {
    padding-block: 42px;
    font-size: 13.5px;
    max-width: 52ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .cat-serie:hover, .cat-serie:focus-visible { padding-left: 12px; }
    .cat-serie:hover .cat-arw { transform: none; }
  }
</style>
