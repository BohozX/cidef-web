---
import type { CollectionEntry } from 'astro:content';
import { dayMonth, isFuture } from '../lib/format';
import { withBase } from '../lib/url';

export interface Props {
  item: CollectionEntry<'eventos'>;
}

const { item } = Astro.props;
const d = item.data;
const iso = d.date.toISOString();
const { day, month, year } = dayMonth(iso);
const upcoming = isFuture(iso);
---

<article class="row-item agenda-row" data-reveal>
  <a href={withBase(`/agenda/${item.id}`)} class="agenda-link">
    <div class="agenda-date" aria-hidden="true">
      <span class="agenda-day tnum">{day}</span>
      <span class="agenda-month">{month}</span>
      <span class="agenda-year tnum muted">{year}</span>
    </div>

    <div class="agenda-body">
      <p class="agenda-meta">
        <span class="chip chip-teal">{d.type}</span>
        {!upcoming && <span class="chip">Realizado</span>}
        {d.demo && <span class="chip chip-demo">Ejemplo</span>}
      </p>
      <h3 class="agenda-title">{d.title}</h3>
      <p class="agenda-summary muted">{d.summary}</p>
    </div>

    <div class="agenda-side">
      <p class="agenda-when tnum">
        {d.time && <span>{d.time}</span>}
        <span class="muted">{d.location}</span>
      </p>
      <span class="link-arrow">
        {upcoming ? 'Inscribirse' : 'Ver materiales'}
        <svg class="arw" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
          <path d="M2 8h11M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </div>
  </a>
</article>

<style>
  .agenda-link {
    display: grid;
    grid-template-columns: 62px minmax(0, 1fr);
    gap: 12px 20px;
    padding-block: 24px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .agenda-link {
      grid-template-columns: 84px minmax(0, 1fr) 210px;
      gap: 34px;
      padding-block: 28px;
    }
  }

  .agenda-date {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .agenda-day {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 2.7rem);
    letter-spacing: -0.03em;
  }
  .agenda-month {
    margin-top: 6px;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--color-gold);
  }
  .agenda-year { margin-top: 4px; font-size: 10.5px; letter-spacing: 0.1em; }

  .agenda-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .agenda-title {
    margin-top: 12px;
    font-size: clamp(1.16rem, 1.7vw, 1.46rem);
    line-height: 1.22;
    max-width: 32ch;
  }
  .agenda-summary {
    margin-top: 10px;
    font-size: 13.5px;
    line-height: 1.6;
    max-width: 62ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .agenda-side {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px 18px;
    margin-top: 14px;
    font-size: 12.5px;
  }
  @media (min-width: 900px) {
    .agenda-side {
      grid-column: 3;
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
      margin-top: 0;
      gap: 12px;
    }
  }
  .agenda-when { display: flex; flex-direction: column; gap: 3px; }
  @media (max-width: 899px) {
    .agenda-when { flex-direction: row; gap: 10px; }
  }
</style>
