---
import { slugify } from '../lib/format';

/**
 * Ficha destacada rotativa.
 *
 * Muestra una sola pieza a la vez —portada grande, resumen y datos— y cambia
 * sola cada ocho segundos. Todas las fichas se renderizan en el servidor y
 * ocupan la misma celda de la cuadrícula, así que la altura no salta al
 * cambiar y el contenido es indexable aunque no se ejecute JS.
 *
 * Se detiene al pasar el cursor, al enfocar con teclado, cuando la pestaña
 * pasa a segundo plano y cuando el bloque sale de pantalla.
 *
 * Sirve para publicaciones y para programas: la página le pasa las fichas ya
 * normalizadas.
 */

export type RotatorSlide = {
  href: string;
  /** Ruta de la portada SIN extensión: se sirven .webp y .jpg. */
  cover: string;
  coverAlt: string;
  kicker: string;
  serial?: string;
  flag?: string;
  title: string;
  meta: string;
  summary: string;
  /**
   * Clasificaciones del documento. Se componen como hoja de características:
   * el rótulo encima del valor, a dos columnas. `wide` ocupa el ancho
   * entero —para las listas largas—, `mono` marca lo que es cifra o código.
   */
  facts?: {
    label: string;
    value: string | string[];
    wide?: boolean;
    mono?: boolean;
  }[];
  cta: string;
};

export interface Props {
  slides: RotatorSlide[];
  /** Milisegundos que permanece cada ficha. */
  interval?: number;
  /** `end` coloca la portada a la derecha y anima en sentido contrario. */
  side?: 'start' | 'end';
  label: string;
}

const { slides, interval = 8000, side = 'start', label } = Astro.props;
const uid = slugify(label) || 'rot';
---

<div
  class:list={['rot', side === 'end' && 'is-mirrored']}
  data-reveal
  data-rotator
  data-interval={interval}
  role="region"
  aria-roledescription="carrusel"
  aria-label={label}
>
  {/* Zonas de paso: viven en el margen de la página, fuera del texto, y
      solo asoman una flecha al pasar el cursor. */}
  <button type="button" class="rot-edge is-prev no-print" data-prev aria-label="Ficha anterior">
    <span class="rot-edge-icon" aria-hidden="true">
      <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7">
        <path d="M14 8H3M7 4L3 8l4 4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </button>

  <button type="button" class="rot-edge is-next no-print" data-next aria-label="Ficha siguiente">
    <span class="rot-edge-icon" aria-hidden="true">
      <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7">
        <path d="M2 8h11M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </button>

  <div class="rot-stage">
    {
      slides.map((s, i) => (
        <article
          class:list={['rot-slide', i === 0 && 'is-active']}
          data-slide
          id={`${uid}-${i}`}
          aria-hidden={i === 0 ? undefined : 'true'}
        >
          <a href={s.href} class="rot-link" tabindex={i === 0 ? undefined : -1}>
            <span class="rot-cover">
              <picture>
                <source type="image/webp" srcset={`${s.cover}.webp`} />
                <img
                  src={`${s.cover}.jpg`}
                  alt={s.coverAlt}
                  width="760"
                  height="1074"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </picture>
            </span>

            <span class="rot-body">
              <span class="rot-kicker">
                <span class="rot-tipo">{s.kicker}</span>
                {s.serial && <span class="rot-serial">{s.serial}</span>}
                {s.flag && <span class="rot-flag">{s.flag}</span>}
              </span>

              <span class="rot-title">{s.title}</span>
              <span class="rot-meta">{s.meta}</span>

              {s.facts && s.facts.length > 0 && (
                <span class="rot-facts">
                  {s.facts.map((f) => (
                    <span class:list={['rot-fact', f.wide && 'is-wide']}>
                      <span class="rot-fact-label">{f.label}</span>
                      <span class:list={['rot-fact-value', f.mono && 'is-dato']}>
                        {Array.isArray(f.value)
                          ? f.value.map((v, i) => (
                              <>
                                {i > 0 && <span class="rot-sep" aria-hidden="true"> · </span>}
                                {v}
                              </>
                            ))
                          : f.value}
                      </span>
                    </span>
                  ))}
                </span>
              )}
            </span>

            <span class="rot-aside">
              <span class="rot-abstract">{s.summary}</span>
              <span class="rot-cta">
                {s.cta}
                <svg class="arw" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M2 8h11M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </span>
          </a>
        </article>
      ))
    }
  </div>

  <div class="rot-bar no-print">
    <ol class="rot-dots" role="tablist" aria-label={label}>
      {
        slides.map((s, i) => (
          <li>
            <button
              type="button"
              role="tab"
              class="rot-dot"
              data-goto={i}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`${uid}-${i}`}
              aria-label={s.title}
            >
              <span class="sr-only">{s.title}</span>
              <span class="rot-dot-track"><span class="rot-dot-fill"></span></span>
            </button>
          </li>
        ))
      }
    </ol>
  </div>
</div>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-rotator]').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-goto]'));
    if (slides.length === 0) return;

    const interval = Number(root.dataset.interval ?? '8000');
    let current = 0;
    let timer = 0;
    let paused = false;

    const paintProgress = (run: boolean): void => {
      dots.forEach((dot, k) => {
        const fill = dot.querySelector<HTMLElement>('.rot-dot-fill');
        if (!fill) return;
        fill.style.animation = 'none';
        // Reflujo forzado: sin esto la animación no se reinicia.
        void fill.offsetWidth;
        fill.style.animation =
          run && k === current ? `rotFill ${interval}ms linear forwards` : '';
      });
    };

    function restart(): void {
      window.clearInterval(timer);
      timer = 0;
      if (reduced || slides.length < 2) {
        paintProgress(false);
        return;
      }
      paintProgress(!paused);
      timer = window.setInterval(() => {
        if (!paused) show(current + 1);
      }, interval);
    }

    function show(next: number): void {
      const i = (next + slides.length) % slides.length;
      if (i === current) return;

      /* El que sale se marca: así puede apagarse más deprisa que el que
         entra sin que el cruce parpadee. */
      const saliente = slides[current];
      if (saliente && current !== i) {
        saliente.classList.add('is-leaving');
        window.setTimeout(() => saliente.classList.remove('is-leaving'), 420);
      }

      slides.forEach((slide, k) => {
        const active = k === i;
        slide.classList.toggle('is-active', active);
        if (active) slide.removeAttribute('aria-hidden');
        else slide.setAttribute('aria-hidden', 'true');
        const link = slide.querySelector<HTMLAnchorElement>('.rot-link');
        if (link) link.tabIndex = active ? 0 : -1;
      });

      dots.forEach((dot, k) => dot.setAttribute('aria-selected', String(k === i)));
      current = i;
      restart();
    }

    dots.forEach((dot) =>
      dot.addEventListener('click', () => show(Number(dot.dataset.goto ?? '0'))),
    );
    root.querySelector<HTMLButtonElement>('[data-next]')?.addEventListener('click', () => show(current + 1));
    root.querySelector<HTMLButtonElement>('[data-prev]')?.addEventListener('click', () => show(current - 1));

    const hold = (value: boolean) => (): void => {
      paused = value;
      dots.forEach((dot) => {
        const fill = dot.querySelector<HTMLElement>('.rot-dot-fill');
        if (fill) fill.style.animationPlayState = value ? 'paused' : 'running';
      });
    };

    root.addEventListener('mouseenter', hold(true));
    root.addEventListener('mouseleave', hold(false));
    root.addEventListener('focusin', hold(true));
    root.addEventListener('focusout', hold(false));
    document.addEventListener('visibilitychange', () => hold(document.hidden)());

    /* La ficha entera es un enlace, pero al ser una pieza editorial no se
       lee como tal. La primera vez que aparece se anuncia: la portada da un
       golpe de luz y la llamada se adelanta. Solo una vez, y nunca si el
       sistema pide menos movimiento. */
    let announced = reduced;
    const announce = (): void => {
      if (announced) return;
      announced = true;
      root.classList.add('is-hint');
      window.setTimeout(() => root.classList.remove('is-hint'), 3400);
    };

    new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          hold(!e.isIntersecting)();
          if (e.isIntersecting) announce();
        }),
      { threshold: 0.2 },
    ).observe(root);

    /* --- la portada sigue al cursor ---------------------------------- */
    const fino = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const stage = root.querySelector<HTMLElement>('.rot-stage');

    if (fino && !reduced && stage) {
      /* Base de la sombra: en el bloque espejado cae al otro lado. */
      const base = root.classList.contains('is-mirrored') ? 1 : -1;
      let caja: DOMRect | null = null;
      let frame = 0;

      const seguir = (e: PointerEvent): void => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          if (!caja) caja = stage.getBoundingClientRect();
          const lim = (v: number): number => Math.max(-1, Math.min(1, v));
          const mx = lim(((e.clientX - caja.left) / caja.width) * 2 - 1);
          const my = lim(((e.clientY - caja.top) / caja.height) * 2 - 1);
          root.style.setProperty('--mx', mx.toFixed(3));
          root.style.setProperty('--my', my.toFixed(3));
          root.style.setProperty('--shx', (base - mx * 1.15).toFixed(3));
          root.style.setProperty('--shy', (1 - my * 0.65).toFixed(3));
        });
      };

      const soltar = (): void => {
        if (frame) cancelAnimationFrame(frame);
        frame = 0;
        caja = null;
        root.classList.remove('is-tracking');
        root.style.setProperty('--mx', '0');
        root.style.setProperty('--my', '0');
        root.style.setProperty('--shx', String(base));
        root.style.setProperty('--shy', '1');
      };

      stage.addEventListener('pointerenter', () => {
        caja = stage.getBoundingClientRect();
        root.classList.add('is-tracking');
      });
      stage.addEventListener('pointermove', seguir);
      stage.addEventListener('pointerleave', soltar);
      window.addEventListener('scroll', () => { caja = null; }, { passive: true });
      window.addEventListener('resize', soltar);
    }

    restart();
  });
</script>

<style is:global>
  /* La animación se asigna desde el script: tiene que vivir fuera del ámbito. */
  @keyframes rotFill {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  @keyframes rotHintShine {
    0% { opacity: 0; transform: translateX(0) skewX(-14deg); }
    12% { opacity: 1; }
    78% { opacity: 1; }
    100% { opacity: 0; transform: translateX(420%) skewX(-14deg); }
  }
  @keyframes rotHintCta {
    0%, 100% { opacity: 1; }
    40% { opacity: 0.5; }
  }
  @keyframes rotHintArrow {
    0%, 100% { transform: none; }
    40% { transform: translateX(7px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .rot.is-hint .rot-slide .rot-cover::after,
    .rot.is-hint .rot-slide .rot-cta,
    .rot.is-hint .rot-slide .rot-cta .arw { animation: none !important; }
  }
</style>

<style>
  .rot { position: relative; }
  .rot-stage { display: grid; }

  /* Relevo entre documentos. El que sale se apaga deprisa; el que entra se
     arma por piezas —portada, antetítulo, título, datos, resumen— con un
     retardo pequeño entre ellas. Se lee como un documento que reemplaza a
     otro, no como una diapositiva que se desliza. */
  .rot { --enter: 26px; }
  .rot.is-mirrored { --enter: -26px; }

  .rot-slide {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition: opacity 380ms ease, visibility 380ms;
    pointer-events: none;
  }
  .rot-slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  /* Mientras se va sigue siendo visible: si no, el cruce parpadea. */
  .rot-slide.is-leaving {
    visibility: visible;
    transition-duration: 240ms;
  }

  .rot-body > *,
  .rot-aside > * {
    opacity: 0;
    transform: translate3d(var(--enter), 7px, 0);
    transition: opacity 460ms ease, transform 640ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .rot-slide.is-active .rot-body > *,
  .rot-slide.is-active .rot-aside > * {
    opacity: 1;
    transform: none;
  }
  .rot-slide.is-active .rot-body > *:nth-child(1),
  .rot-slide.is-active .rot-aside > *:nth-child(1) { transition-delay: 90ms; }
  .rot-slide.is-active .rot-body > *:nth-child(2),
  .rot-slide.is-active .rot-aside > *:nth-child(2) { transition-delay: 160ms; }
  .rot-slide.is-active .rot-body > *:nth-child(3) { transition-delay: 230ms; }
  .rot-slide.is-active .rot-body > *:nth-child(4) { transition-delay: 300ms; }

  @media (prefers-reduced-motion: reduce) {
    .rot-body > *,
    .rot-aside > * { transform: none; transition: opacity 200ms ease; }
  }

  /* Portada · datos · resumen. En el bloque espejado el orden se invierte
     para que la portada quede del otro lado. */
  .rot-link {
    display: grid;
    gap: 26px;
    align-items: start;
  }
  @media (min-width: 760px) {
    .rot-link { grid-template-columns: 210px minmax(0, 1fr); gap: 36px; }
    .rot-cover { grid-column: 1; grid-row: 1; }
    .rot-body { grid-column: 2; grid-row: 1; }
    .rot-aside { grid-column: 1 / -1; }
    .is-mirrored .rot-link { grid-template-columns: minmax(0, 1fr) 210px; }
    .is-mirrored .rot-cover { grid-column: 2; grid-row: 1; }
    .is-mirrored .rot-body { grid-column: 1; grid-row: 1; }
  }

  /* En pantalla ancha la portada va al centro, con los datos a un lado y el
     resumen al otro. El bloque espejado intercambia los dos costados. */
  @media (min-width: 1120px) {
    .rot-link {
      grid-template-columns: minmax(0, 1.04fr) 300px minmax(0, 0.96fr);
      gap: 48px;
      /* Alineadas arriba: así la portada cae siempre en el mismo sitio,
         aunque una ficha tenga más clasificaciones que otra. */
      align-items: start;
    }
    .rot-body  { grid-column: 1; grid-row: 1; }
    .rot-cover { grid-column: 2; grid-row: 1; }
    .rot-aside { grid-column: 3; grid-row: 1; }

    .is-mirrored .rot-link {
      grid-template-columns: minmax(0, 0.96fr) 300px minmax(0, 1.04fr);
    }
    .is-mirrored .rot-aside { grid-column: 1; grid-row: 1; }
    .is-mirrored .rot-cover { grid-column: 2; grid-row: 1; }
    .is-mirrored .rot-body  { grid-column: 3; grid-row: 1; }

    /* La llamada se ancla en la esquina inferior del costado del resumen: a
       la derecha en las publicaciones, a la izquierda en los programas. Si
       fuera pegada al texto, cada ficha la dejaría a una altura distinta y el
       bloque parecería saltar al cambiar de documento. */
    /* `.rot-link` delante a propósito: la regla base de `.rot-aside` viene
       más abajo en la hoja y, a igual peso, ganaría ella. */
    .rot-link .rot-aside {
      align-self: stretch;
      align-content: space-between;
    }
    .rot-link .rot-cta { justify-self: end; }
    .is-mirrored .rot-link .rot-cta { justify-self: start; }
  }

  /* Ligero giro en perspectiva y sombra en capas: la portada se lee como un
     documento físico apoyado, no como una imagen pegada. */
  /* El documento sigue al cursor: gira hacia él y la sombra cae al lado
     contrario, como si la luz viniera de donde está el ratón. El script solo
     escribe --mx/--my (posición, de -1 a 1) y --shx/--shy (hacia dónde cae la
     sombra); el resto lo resuelve el navegador aquí. */
  .rot-cover {
    display: block;
    position: relative;
    max-width: 300px;
    overflow: hidden;
    border-radius: 3px 22px 3px 3px;
    background: var(--color-ink);
    aspect-ratio: 760 / 1074;
    opacity: 0;
    --giro-y: -7deg;
    --sombra-x: -1;
    transform: perspective(1400px)
      rotateY(calc(var(--giro-y) + var(--mx, 0) * 7deg))
      rotateX(calc(1.2deg + var(--my, 0) * -5.5deg))
      translate3d(0, var(--alza, 0px), 0);
    transform-origin: right center;
    box-shadow:
      calc(var(--shx, var(--sombra-x)) * 3px) calc(var(--shy, 1) * 4px) 8px rgb(3 26 36 / 0.10),
      calc(var(--shx, var(--sombra-x)) * 13px) calc(var(--shy, 1) * 19px) 32px rgb(3 26 36 / 0.17),
      calc(var(--shx, var(--sombra-x)) * 30px) calc(var(--shy, 1) * 43px) 74px rgb(3 26 36 / 0.21);
    transition: transform 700ms cubic-bezier(0.22, 0.61, 0.36, 1),
      box-shadow 700ms ease, opacity 420ms ease 60ms;
  }
  .rot-slide.is-active .rot-cover { opacity: 1; }

  /* Con el cursor encima la portada tiene que responder al instante; al
     soltarla vuelve despacio a su sitio. */
  .rot.is-tracking .rot-cover {
    transition-duration: 160ms, 160ms, 420ms;
  }
  .rot-link:hover .rot-cover { --alza: -7px; }

  .is-mirrored .rot-cover {
    border-radius: 22px 3px 3px 3px;
    --giro-y: 7deg;
    --sombra-x: 1;
    transform-origin: left center;
  }
  @media (min-width: 1100px) { .rot-cover { max-width: none; } }

  .rot-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .rot-link:hover .rot-cover img { transform: scale(1.035); }

  .rot-body { display: grid; align-content: start; }

  /* Sin recuadros: el tipo de documento y el estado se distinguen por color
     y por caja alta, que ya es suficiente jerarquía sobre un antetítulo. */
  .rot-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
  }
  .rot-tipo,
  .rot-flag {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .rot-tipo { color: var(--color-teal-600); }
  :global(.surface-dark) .rot-tipo,
  :global(.surface-deep) .rot-tipo { color: var(--color-teal-300); }
  .rot-flag { color: var(--color-gold); }

  .rot-serial {
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .rot-title {
    display: block;
    margin-top: 18px;
    font-size: clamp(1.4rem, 2.4vw, 2.05rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.032em;
    max-width: 22ch;
    transition: color 220ms ease;
  }

  .rot-meta {
    display: block;
    margin-top: 14px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-gold);
  }

  /* --- clasificaciones ---------------------------------------------------
     Hoja de características, no tabla. Antes cada dato era una fila de
     etiqueta y valor separadas por un filete: eso se leía como hoja de
     cálculo y dejaba una calle vacía entre las dos columnas. Ahora el rótulo
     va encima de su valor y los datos cortos comparten renglón, así el
     bloque ocupa la mitad de alto y se recorre de un vistazo. */
  .rot-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 32px;
    margin-top: 26px;
  }
  /* Las listas largas —temas, claves— no caben en media columna. */
  .rot-fact.is-wide { grid-column: 1 / -1; }

  .rot-fact { display: grid; gap: 6px; align-content: start; }
  /* La monoespaciada daba peso al rótulo por su propia forma; en la de
     texto hay que pedírselo, o se pierde contra el valor. */
  .rot-fact-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-teal-600);
  }
  :global(.surface-dark) .rot-fact-label,
  :global(.surface-deep) .rot-fact-label { color: var(--color-teal-300); }

  .rot-fact-value { font-size: 13.5px; line-height: 1.5; }

  /* Con una sola tipografía, lo que distingue a un dato de una frase ya no
     es la letra sino el ajuste: cifras de ancho fijo y algo más de aire
     entre caracteres, para que los códigos no se apelmacen. */
  .rot-fact-value.is-dato {
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  /* El separador cede protagonismo a los términos que separa. */
  .rot-sep { color: color-mix(in srgb, currentColor 34%, transparent); }

  /* --- resumen --- */
  .rot-aside {
    display: grid;
    align-content: start;
  }

  .rot-abstract {
    display: -webkit-box;
    -webkit-line-clamp: 9;
    line-clamp: 9;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 14.5px;
    line-height: 1.72;
    color: var(--muted);
    /* Justificado con partición: en castellano, sin guiones, las columnas
       estrechas abren calles enormes entre palabras. */
    text-align: justify;
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  .rot-cta {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 22px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--color-gold);
  }
