---
import { withBase } from '../lib/url';
import type { CollectionEntry } from 'astro:content';
import { dayMonth, isFuture } from '../lib/format';

export interface Props {
  item: CollectionEntry<'eventos'>;
}

const { item } = Astro.props;
const d = item.data;
const iso = d.date.toISOString();
const { day, month, year } = dayMonth(iso);
const upcoming = isFuture(iso);
---

<article class="row-item agenda-row" data-agenda-row>
  <a href={withBase(`/agenda/${item.id}`)} class="agenda-link">
    <div class="agenda-date" aria-hidden="true">
      <span class="agenda-day tnum">{day}</span>
      <span class="agenda-month">{month}</span>
      <span class="agenda-year tnum muted">{year}</span>
    </div>

    <div class="agenda-body">
      <p class="agenda-meta">
        <span class="chip chip-teal">{d.type}</span>
        {!upcoming && <span class="chip">Realizado</span>}
      </p>
      <h3 class="agenda-title">{d.title}</h3>
      <p class="agenda-summary muted">{d.summary}</p>
    </div>

    <div class="agenda-side">
      <p class="agenda-when tnum">
        {d.time && <span>{d.time}</span>}
        <span class="muted">{d.location}</span>
      </p>
      <span class="link-arrow">
        {upcoming ? 'Inscribirse' : 'Ver detalle'}
        <svg class="arw" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
          <path d="M2 8h11M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </div>
  </a>
</article>

<style>
  /* El levantamiento va en la fila entera, no en su interior: la línea
     divisoria pertenece a la fila, y al mover solo el contenido se quedaba
     abajo, como si media pieza no subiera. Al pasar el cursor la línea se
     apaga y el bloque despega completo. */
  .agenda-row {
    padding-inline: 16px;
    margin-inline: -16px;
    border-radius: var(--radius-md);
    transition: transform 340ms cubic-bezier(0.22, 0.61, 0.36, 1),
      box-shadow 340ms ease, background-color 340ms ease, border-color 200ms ease;
  }
  .agenda-row:hover,
  .agenda-row:focus-within {
    transform: translateY(-3px);
    background: color-mix(in srgb, currentColor 3%, transparent);
    box-shadow: 0 22px 46px -28px rgb(3 26 36 / 0.55);
    border-top-color: transparent;
  }
  .agenda-row:hover .agenda-day,
  .agenda-row:focus-within .agenda-day { color: var(--color-gold); }
  .agenda-day { transition: color 300ms ease; }

  @media (prefers-reduced-motion: reduce) {
    .agenda-row:hover, .agenda-row:focus-within { transform: none; }
  }

  .agenda-link {
    display: grid;
    grid-template-columns: 62px minmax(0, 1fr);
    gap: 12px 20px;
    padding-block: 24px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .agenda-link {
      grid-template-columns: 84px minmax(0, 1fr) 210px;
      gap: 34px;
      padding-block: 28px;
    }
  }

  /* Centrada en su columna: el día, el mes y el año forman un bloque y en
     bandera quedaban colgando a distintas anchuras.

     El desplazamiento hacia abajo la sienta a la altura del título y no del
     antetítulo, que es una línea menor: son las dos piezas grandes de la
     fila y deben arrancar juntas. */
  .agenda-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    line-height: 1;
    margin-top: 18px;
  }
  @media (min-width: 900px) {
    .agenda-date { margin-top: 24px; }
  }
  .agenda-day {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 2.7rem);
    letter-spacing: -0.03em;
  }
  .agenda-month {
    margin-top: 6px;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--color-gold);
  }
  .agenda-year { margin-top: 4px; font-size: 10.5px; letter-spacing: 0.1em; }

  .agenda-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .agenda-title {
    margin-top: 12px;
    font-size: clamp(1.16rem, 1.7vw, 1.46rem);
    line-height: 1.22;
    max-width: 32ch;
  }
  .agenda-summary {
    margin-top: 10px;
    font-size: 13.5px;
    line-height: 1.6;
    max-width: 62ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .agenda-side {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px 18px;
    margin-top: 14px;
    font-size: 12.5px;
  }
  @media (min-width: 900px) {
    .agenda-side {
      grid-column: 3;
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
      margin-top: 0;
      gap: 12px;
    }
  }
  .agenda-when { display: flex; flex-direction: column; gap: 3px; }
  @media (max-width: 899px) {
    .agenda-when { flex-direction: row; gap: 10px; }
  }
</style>
