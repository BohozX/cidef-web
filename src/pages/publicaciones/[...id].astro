---
import { withBase, withBaseSrcset } from '../../lib/url';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';

import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchCard from '../../components/ResearchCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { site } from '../../site.config';
import { authorList, longDate, year } from '../../lib/format';

export const getStaticPaths: GetStaticPaths = async () => {
  const items = await getCollection('publicaciones');
  return items.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
};

export interface Props {
  entry: CollectionEntry<'publicaciones'>;
}

const { entry } = Astro.props;
const d = entry.data;

const iso = d.date.toISOString();
const y = year(iso);
const url = new URL(`/analisis/${entry.id}`, Astro.site ?? site.url).toString();

/* ---------------------------------------------------------- relacionados -- */
const all = await getCollection('publicaciones');
const related = all
  .filter((p) => p.id !== entry.id)
  .map((p) => ({
    p,
    score: p.data.topics.filter((t) => d.topics.includes(t)).length,
  }))
  .sort((a, b) => b.score - a.score || b.p.data.date.getTime() - a.p.data.date.getTime())
  .slice(0, 3)
  .map((r) => r.p);

const facts = [
  { label: 'Tipo', value: d.type },
  { label: 'Publicación', value: longDate(iso) },
  ...(d.serial ? [{ label: 'Serie', value: d.serial }] : []),
  ...(d.pages ? [{ label: 'Extensión', value: `${d.pages} pp.` }] : []),
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: d.title,
  abstract: d.abstract,
  datePublished: iso.slice(0, 10),
  inLanguage: 'es',
  keywords: d.keywords.join(', '),
  author: d.authors.map((name) => ({ '@type': 'Person', name })),
  publisher: { '@type': 'Organization', name: site.legalName },
  url,
  ...(d.externalUrl ? { sameAs: d.externalUrl } : {}),
};
---

<BaseLayout
  title={d.title}
  description={d.abstract.slice(0, 175)}
  ogType="article"
  jsonLd={jsonLd}
>
  <!-- Portada del documento -------------------------------------------- -->
  <section class="surface-deep doc-cabecera">
    <div class="wrap doc-cabecera-inner">
      <div class="doc-portada" data-tilt data-reveal>
        <picture>
          <source type="image/webp" srcset={withBase(`/media/portadas/${entry.id}.webp`)} />
          <img
            src={withBase(`/media/portadas/${entry.id}.jpg`)}
            alt={`Portada de ${d.title}`}
            width="760"
            height="1074"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>

      <div class="doc-info">
        <nav class="doc-crumb" aria-label="Ruta de navegación">
          <a href={withBase('/publicaciones')} class="link-arrow">
            <svg class="arw" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
              <path d="M14 8H3M7 4L3 8l4 4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Publicaciones
          </a>
        </nav>

        <p class="doc-kicker">
          <span class="doc-tipo">{d.type}</span>
          {d.serial && <span class="doc-serial">{d.serial}</span>}
          {d.demo && <span class="doc-demo">Ficha de ejemplo</span>}
        </p>

        <h1 class:list={['doc-titulo', d.title.length > 70 && 'is-long']}>{d.title}</h1>

        <p class="doc-autoria">
          {authorList(d.authors)} · <span class="tnum">{longDate(iso)}</span>
        </p>

        <p class="doc-resumen">{d.abstract}</p>

        <dl class="doc-datos">
          {d.topics.length > 0 && (
            <div>
              <dt>Temas</dt>
              <dd>{d.topics.join(' · ')}</dd>
            </div>
          )}
          {d.jel.length > 0 && (
            <div>
              <dt>Códigos JEL</dt>
              <dd class="tnum">{d.jel.join(' · ')}</dd>
            </div>
          )}
          {d.keywords.length > 0 && (
            <div class="is-wide">
              <dt>Palabras clave</dt>
              <dd>{d.keywords.join(' · ')}</dd>
            </div>
          )}
          {d.pages && (
            <div>
              <dt>Extensión</dt>
              <dd class="tnum">{d.pages} páginas</dd>
            </div>
          )}
          {d.doi && (
            <div>
              <dt>DOI</dt>
              <dd class="tnum">{d.doi}</dd>
            </div>
          )}
        </dl>

        {/* Solo la descarga principal: los anexos —series, código— viven en la
            ficha del recurso, y aquí un segundo botón competía con el primero
            sin decir mucho más. */}
        {d.files.length > 0 && (
          <div class="doc-descargas no-print">
            {d.files.slice(0, 1).map((f) => (
              <a href={f.href} class="btn btn-primary" rel="noopener">
                {f.label}
                <svg class="arw" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
                  <path d="M8 2v9M4.5 7.5 8 11l3.5-3.5M3 13.5h10" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="surface-tint section" aria-labelledby="relacionados">
        <div class="wrap">
          <h2 id="relacionados" class="display-3 rel-title" data-reveal>Publicaciones relacionadas</h2>
          <div class="rel-grid" data-reveal-group data-reveal-stagger="0.08">
            {related.map((item) => <ResearchCard item={item} view="grid" />)}
          </div>
        </div>
      </section>
    )
  }

  <Newsletter />
</BaseLayout>

<script>
  /* La portada sigue al cursor, igual que en el listado y en la home. */
  const fino = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const portada = document.querySelector<HTMLElement>('[data-tilt]');

  if (fino && !reducido && portada) {
    let caja: DOMRect | null = null;
    let frame = 0;

    portada.addEventListener('pointerenter', () => {
      caja = portada.getBoundingClientRect();
      portada.classList.add('is-tracking');
    });

    portada.addEventListener('pointermove', (e: PointerEvent) => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        if (!caja) caja = portada.getBoundingClientRect();
        const lim = (v: number): number => Math.max(-1, Math.min(1, v));
        portada.style.setProperty('--mx', lim(((e.clientX - caja.left) / caja.width) * 2 - 1).toFixed(3));
        portada.style.setProperty('--my', lim(((e.clientY - caja.top) / caja.height) * 2 - 1).toFixed(3));
      });
    });

    portada.addEventListener('pointerleave', () => {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
      caja = null;
      portada.classList.remove('is-tracking');
      portada.style.setProperty('--mx', '0');
      portada.style.setProperty('--my', '0');
    });

    window.addEventListener('scroll', () => { caja = null; }, { passive: true });
  }
</script>

<style>
  /* --- portada del documento -------------------------------------------
     La pieza a la izquierda y todo lo que hay que saber a la derecha:
     antetítulo, título, autoría, resumen, datos y descarga. Antes esto vivía
     repartido entre una cabecera alta, una columna de texto y una barra
     lateral, y obligaba a bajar para saber de qué iba el documento. */
  /* Lo justo para librar la cabecera fija y un respiro. Con más aire quedaba
     una franja vacía antes de llegar al documento. */
  .doc-cabecera {
    padding-top: clamp(30px, 3.4vh, 46px);
    padding-bottom: clamp(40px, 4.5vw, 64px);
    border-bottom-left-radius: clamp(48px, 11vw, 168px);
  }
  .doc-cabecera-inner {
    display: grid;
    gap: clamp(32px, 4vw, 64px);
    align-items: start;
  }
  @media (min-width: 900px) {
    .doc-cabecera-inner {
      grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
    }
  }
  @media (min-width: 1200px) {
    .doc-cabecera-inner { grid-template-columns: minmax(0, 360px) minmax(0, 1fr); }
  }

  /* La portada gira hacia el cursor, como en el resto del sitio. */
  .doc-portada {
    display: block;
    max-width: 360px;
    overflow: hidden;
    border-radius: 3px 22px 3px 3px;
    background: var(--color-ink);
    transform: perspective(1400px)
      rotateY(calc(-4deg + var(--mx, 0) * 7deg))
      rotateX(calc(var(--my, 0) * -6deg));
    box-shadow:
      calc(-8px + var(--mx, 0) * -10px) 16px 34px rgb(0 0 0 / 0.3),
      calc(-18px + var(--mx, 0) * -22px) 38px 76px rgb(0 0 0 / 0.34);
    transition: transform 640ms cubic-bezier(0.22, 0.61, 0.36, 1), box-shadow 640ms ease;
  }
  .doc-portada.is-tracking { transition-duration: 160ms; }
  .doc-portada img { width: 100%; height: auto; }

  .doc-crumb { margin-bottom: 24px; }
  .doc-crumb .arw { transition: transform 240ms cubic-bezier(0.22, 0.61, 0.36, 1); }
  .doc-crumb a:hover .arw { transform: translateX(-4px); }

  .doc-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 16px;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .doc-tipo { color: var(--color-teal-300); }
  .doc-serial { color: var(--muted); font-variant-numeric: tabular-nums; }
  .doc-demo { color: var(--color-gold-300); }

  .doc-titulo {
    margin-top: 16px;
    font-size: clamp(1.9rem, 3.4vw, 2.9rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.032em;
    max-width: 22ch;
  }
  .doc-titulo.is-long {
    font-size: clamp(1.6rem, 2.7vw, 2.3rem);
    max-width: 28ch;
  }

  .doc-autoria {
    margin-top: 16px;
    font-size: 13.5px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-gold);
  }

  .doc-resumen {
    margin-top: 22px;
    /* Hasta el margen de la página: la columna ya marca la medida y una
       anchura fija dejaba una franja muerta a la derecha. */
    max-width: none;
    font-size: 14.5px;
    line-height: 1.72;
    color: color-mix(in srgb, #f5f3ed 80%, transparent);
    text-align: justify;
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  .doc-datos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 18px 40px;
    margin-top: 28px;
  }
  .doc-datos .is-wide { grid-column: 1 / -1; }
  .doc-datos dt {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-teal-300);
  }
  .doc-datos dd {
    margin: 6px 0 0;
    font-size: 13.5px;
    line-height: 1.5;
  }

  .doc-descargas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 30px;
  }

  .pub-h { display: block; margin-bottom: 16px; }
  .pub-block { margin-top: clamp(40px, 5vw, 62px); }

  /* --- relacionados --- */
  .rel-title { margin: 26px 0 34px; }
  .rel-grid { display: grid; gap: 16px; }
  @media (min-width: 760px) { .rel-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
