---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ResearcherCard from '../components/ResearcherCard.astro';
import InstitutionalStrip from '../components/InstitutionalStrip.astro';
import Newsletter from '../components/Newsletter.astro';
import { site } from '../site.config';

const [investigadores, publicaciones, formacion] = await Promise.all([
  getCollection('investigadores'),
  getCollection('publicaciones'),
  getCollection('formacion'),
]);

const equipo = investigadores.sort((a, b) => a.data.order - b.data.order);

const areas = [
  {
    name: 'Macroeconomía',
    text: 'Crecimiento, ciclo económico, precios y política monetaria y fiscal.',
  },
  {
    name: 'Sector externo',
    text: 'Balanza de pagos, reservas, régimen cambiario y competitividad.',
  },
  {
    name: 'Finanzas',
    text: 'Sistema financiero, crédito, riesgo y econometría financiera aplicada.',
  },
  {
    name: 'Mercado laboral',
    text: 'Empleo, informalidad, ingresos y calidad del trabajo.',
  },
  {
    name: 'Desarrollo',
    text: 'Productividad, sectores estratégicos y desigualdad territorial.',
  },
  {
    name: 'Política pública',
    text: 'Evaluación de impacto, diseño de política y análisis normativo.',
  },
  {
    name: 'Economía digital',
    text: 'Datos alternativos, activos digitales y medición de alta frecuencia.',
  },
];

const secciones = [
  { n: '01', id: 'quienes', label: 'Quiénes somos' },
  { n: '02', id: 'mision', label: 'Misión' },
  { n: '03', id: 'areas', label: 'Áreas de trabajo' },
  { n: '04', id: 'equipo', label: 'Equipo e investigadores' },
  { n: '05', id: 'formacion', label: 'Formación' },
  { n: '06', id: 'alianzas', label: 'Alianzas' },
  { n: '07', id: 'contacto', label: 'Contacto' },
];

const facts = [
  { label: 'Áreas de trabajo', value: String(areas.length) },
  { label: 'Publicaciones', value: String(publicaciones.length) },
  { label: 'Programas', value: String(formacion.length) },
  { label: 'Sede', value: 'La Paz, Bolivia' },
];
---

<BaseLayout
  title="Nosotros"
  description="El Centro de Inteligencia en Desarrollo Económico y Financiero produce investigación económica aplicada, datos propios y formación de posgrado en Bolivia."
>
  <PageHero
    eyebrow="Nosotros"
    title="Un centro de investigación económica en Bolivia."
    lede="Producimos investigación aplicada, construimos y publicamos datos propios, y formamos profesionales en análisis económico cuantitativo."
    facts={facts}
  />

  <section class="surface-light section">
    <div class="wrap">
      <div class="about-layout">
        <!-- Índice ----------------------------------------------------- -->
        <nav class="about-index no-print" aria-label="Contenido de la página">
          <ol>
            {
              secciones.map((s) => (
                <li>
                  <a href={`#${s.id}`}>
                    <span class="index-num">{s.n}</span>
                    <span>{s.label}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>

        <!-- Contenido -------------------------------------------------- -->
        <div class="about-body">
          <section id="quienes" class="about-sec" aria-labelledby="h-quienes">
            <div class="rule rule-draw"></div>
            <p class="about-kicker"><span class="index-num">01</span><span class="eyebrow">Quiénes somos</span></p>
            <h2 id="h-quienes" class="display-3 about-title" data-reveal>
              Investigación económica producida en Bolivia, sobre Bolivia.
            </h2>
            <div class="about-text" data-reveal>
              <p>
                El {site.legalName} ({site.name}) es un centro dedicado al
                análisis económico aplicado. Trabajamos sobre tres frentes que se
                alimentan entre sí: investigación con estándar académico,
                construcción de datos propios y formación de posgrado.
              </p>
              <p>
                Publicamos documentos con su metodología abierta, sus datos y su
                código, de modo que cualquier resultado pueda replicarse. Cuando
                una estimación se revisa, la versión anterior no se borra: queda
                archivada y sigue siendo citable.
              </p>
            </div>
          </section>

          <section id="mision" class="about-sec" aria-labelledby="h-mision">
            <div class="rule rule-draw"></div>
            <p class="about-kicker"><span class="index-num">02</span><span class="eyebrow">Misión</span></p>
            <h2 id="h-mision" class="display-3 about-title" data-reveal>
              Convertir información en evidencia útil para decidir.
            </h2>
            <div class="about-text" data-reveal>
              <p>
                Buscamos que las decisiones económicas —públicas y privadas— se
                apoyen en evidencia verificable. Eso implica medir bien, declarar
                los supuestos, mostrar la incertidumbre de las estimaciones y
                comunicar los resultados con precisión, sin exagerar lo que los
                datos permiten afirmar.
              </p>
            </div>
          </section>

          <section id="areas" class="about-sec" aria-labelledby="h-areas">
            <div class="rule rule-draw"></div>
            <p class="about-kicker"><span class="index-num">03</span><span class="eyebrow">Áreas de trabajo</span></p>
            <h2 id="h-areas" class="display-3 about-title" data-reveal>Siete líneas de investigación.</h2>

            <ol class="areas" data-reveal-group data-reveal-stagger="0.05">
              {
                areas.map((a, i) => (
                  <li data-reveal>
                    <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
                    <span class="area-name">{a.name}</span>
                    <span class="area-text muted">{a.text}</span>
                  </li>
                ))
              }
            </ol>
          </section>

          <section id="equipo" class="about-sec" aria-labelledby="h-equipo">
            <div class="rule rule-draw"></div>
            <p class="about-kicker"><span class="index-num">04</span><span class="eyebrow">Equipo e investigadores</span></p>
            <h2 id="h-equipo" class="display-3 about-title" data-reveal>Quiénes firman la investigación.</h2>
            <p class="about-note muted" data-reveal>
              Cada investigador publica bajo su nombre, con sus identificadores
              académicos y el listado de sus trabajos dentro del centro.
            </p>

            <div class="team" data-reveal-group data-reveal-stagger="0.07">
              {equipo.map((item) => <ResearcherCard item={item} />)}
            </div>
          </section>

          <section id="formacion" class="about-sec" aria-labelledby="h-formacion">
            <div class="rule rule-draw"></div>
            <p class="about-kicker"><span class="index-num">05</span><span class="eyebrow">Formación</span></p>
            <h2 id="h-formacion" class="display-3 about-title" data-reveal>
              Diplomados de posgrado con certificación universitaria.
            </h2>
            <div class="about-text" data-reveal>
              <p>
                El centro dicta programas de posgrado junto al Colegio de
                Economistas de La Paz y la Escuela de Postgrado MSC, con diploma
                emitido por la Universidad Franz Tamayo. Los docentes provienen
                de la banca central, la regulación sectorial y la academia.
              </p>
            </div>
            <p data-reveal>
              <a href="/formacion" class="link-arrow">
                Ver la oferta académica
                <svg class="arw" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
                  <path d="M2 8h11M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </p>
          </section>

          <section id="alianzas" class="about-sec" aria-labelledby="h-alianzas">
            <div class="rule rule-draw"></div>
            <p class="about-kicker"><span class="index-num">06</span><span class="eyebrow">Alianzas</span></p>
            <h2 id="h-alianzas" class="display-3 about-title" data-reveal>Con quiénes trabajamos.</h2>

            <ul class="allies" data-reveal-group data-reveal-stagger="0.06">
              {
                site.partners.map((p) => (
                  <li data-reveal>
                    <span class="ally-name">{p.name}</span>
                    <span class="ally-role muted">{p.role}</span>
                  </li>
                ))
              }
            </ul>
          </section>

          <section id="contacto" class="about-sec" aria-labelledby="h-contacto">
            <div class="rule rule-draw"></div>
            <p class="about-kicker"><span class="index-num">07</span><span class="eyebrow">Contacto</span></p>
            <h2 id="h-contacto" class="display-3 about-title" data-reveal>Escríbenos.</h2>

            <dl class="contact-dl" data-reveal>
              <div>
                <dt class="eyebrow muted">Correo</dt>
                <dd><a href={`mailto:${site.contact.email}`} class="link-underline">{site.contact.email}</a></dd>
              </div>
              <div>
                <dt class="eyebrow muted">Teléfono / WhatsApp</dt>
                <dd class="tnum">{site.contact.phones.join(' · ')}</dd>
              </div>
              <div>
                <dt class="eyebrow muted">Dirección</dt>
                <dd>{site.contact.address}<br />{site.contact.addressCity}</dd>
              </div>
            </dl>
          </section>
        </div>
      </div>
    </div>
  </section>

  <InstitutionalStrip />
  <Newsletter />
</BaseLayout>

<style>
  .about-layout { display: grid; gap: 40px; }
  @media (min-width: 1040px) {
    .about-layout { grid-template-columns: 232px minmax(0, 1fr); gap: 72px; align-items: start; }
  }

  .about-index { display: none; }
  @media (min-width: 1040px) {
    .about-index { display: block; position: sticky; top: 104px; }
  }
  .about-index ol { list-style: none; margin: 0; padding: 0; }
  .about-index li { border-top: 1px solid var(--line-light); }
  .about-index li:last-child { border-bottom: 1px solid var(--line-light); }
  .about-index a {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr);
    gap: 8px;
    padding-block: 12px;
    font-size: 13px;
    transition: color 200ms ease, transform 200ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .about-index a:hover { color: var(--color-teal-600); transform: translateX(3px); }

  .about-sec { padding-bottom: clamp(52px, 7vw, 92px); scroll-margin-top: 96px; }
  .about-sec:first-child .rule { display: none; }

  .about-kicker {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding-top: 26px;
    margin-bottom: 16px;
  }
  .about-title { max-width: 20ch; }
  .about-text {
    margin-top: 20px;
    max-width: 62ch;
    font-size: 15px;
    line-height: 1.72;
  }
  .about-text p + p { margin-top: 1.1em; }
  .about-note { margin-top: 16px; max-width: 56ch; font-size: 14px; }

  .areas { list-style: none; margin: 30px 0 0; padding: 0; }
  .areas li {
    display: grid;
    grid-template-columns: 34px minmax(0, 200px) minmax(0, 1fr);
    gap: 6px 16px;
    padding-block: 16px;
    border-top: 1px solid var(--line-light);
    align-items: baseline;
  }
  .areas li:last-child { border-bottom: 1px solid var(--line-light); }
  .area-name { font-size: 15px; font-weight: 500; }
  .area-text { font-size: 13.5px; line-height: 1.55; }
  @media (max-width: 700px) {
    .areas li { grid-template-columns: 30px minmax(0, 1fr); }
    .area-text { grid-column: 2; }
  }

  .team {
    display: grid;
    gap: 32px 20px;
    margin-top: 34px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 860px) { .team { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .allies { list-style: none; margin: 28px 0 0; padding: 0; }
  .allies li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 20px;
    padding-block: 16px;
    border-top: 1px solid var(--line-light);
  }
  .allies li:last-child { border-bottom: 1px solid var(--line-light); }
  .ally-name { font-size: 15px; font-weight: 500; }
  .ally-role {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-dl { display: grid; gap: 20px; margin-top: 28px; font-size: 14.5px; }
  @media (min-width: 720px) { .contact-dl { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .contact-dl dt { margin-bottom: 8px; }
  .contact-dl dd { margin: 0; line-height: 1.6; }
</style>
