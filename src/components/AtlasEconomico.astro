---
import SectionHeader from './SectionHeader.astro';
import Tableros from './Tableros.astro';
---

<section class="surface-mist section atlas-section edge-tl edge-br" aria-label="Atlas Económico">
  <div class="wrap">
    <p class="eyebrow eyebrow-gold atlas-eyebrow" data-reveal>Atlas Económico</p>
    <SectionHeader
      title="¿Qué está pasando en la economía boliviana?"
      href="/atlas"
      linkLabel="Abrir el Atlas Económico"
    />

    <Tableros solo="panorama" />
  </div>
</section>

<style>
  .atlas-section { padding-block: clamp(56px, 7vw, 104px); }
  .atlas-eyebrow {
    margin-bottom: 14px;
    text-align: center;
  }
  .atlas-section :global(.sec-title) { max-width: none; }
</style>
