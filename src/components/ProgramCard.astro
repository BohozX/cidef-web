---
import { withBase } from '../lib/url';
import type { CollectionEntry } from 'astro:content';
import { num } from '../lib/format';

/**
 * Tarjeta de un programa de formación.
 *
 * Banda superior con el motivo de datos del programa y el estado de la
 * inscripción; debajo, lo que decide una matrícula: de qué va, cuánto dura,
 * cómo se dicta, con qué herramientas y cuánto cuesta.
 */

export interface Props {
  item: CollectionEntry<'formacion'>;
  featured?: boolean;
  /** La banda superior. Se puede apagar donde la tarjeta va muy estrecha. */
  cover?: boolean;
  /** Solo imagen y título: para listas de «otros programas». */
  compacto?: boolean;
}

const { item, featured = false, cover = true, compacto = false } = Astro.props;
const d = item.data;
const banda = withBase(`/media/portadas/${item.id}-banda`);

const datos = [
  { label: 'Duración', value: `${d.weeks} semanas`, icono: 'calendario' },
  { label: 'Modalidad', value: d.modality, icono: 'pantalla' },
  { label: 'Módulos', value: String(d.modules.length), icono: 'libro' },
  { label: 'Docentes', value: String(d.faculty.length), icono: 'gente' },
];
---

<article class:list={['panel', 'program', featured && 'is-featured', compacto && 'is-compacto']} data-reveal>
  <a href={withBase(`/formacion/${item.id}`)} class="program-link">
    {
      cover && (
        <div class="program-banda">
          <picture>
            <source type="image/webp" srcset={`${banda}.webp`} />
            <img
              src={`${banda}.jpg`}
              alt={`Motivo gráfico del ${d.title}`}
              width="1200"
              height="675"
              loading="lazy"
              decoding="async"
            />
          </picture>

          {d.open && (
            <span class="program-estado">
              <span class="program-punto" aria-hidden="true" />
              Inscripciones abiertas
            </span>
          )}
        </div>
      )
    }

    <div class="program-cuerpo">
      <p class="program-clase">{d.kind}</p>
      <h3 class="program-title">{d.title}</h3>
      {!compacto && <p class="program-summary muted">{d.summary}</p>}

      {!compacto && (
      <ul class="program-datos">
        {datos.map((f) => (
          <li>
            <svg class="program-icono" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4">
                {f.icono === 'calendario' && (
                  <>
                    <rect x="2" y="3.2" width="12" height="10.5" rx="1.4" />
                    <path d="M2 6.4h12M5.2 1.8v2.6M10.8 1.8v2.6" stroke-linecap="round" />
                  </>
                )}
                {f.icono === 'pantalla' && (
                  <>
                    <rect x="2.2" y="3" width="11.6" height="8" rx="1.2" />
                    <path d="M1.2 13.4h13.6" stroke-linecap="round" />
                  </>
                )}
                {f.icono === 'libro' && (
                  <>
                    <path d="M8 4.2C6.8 3.2 5 2.9 2.4 3.1v9.2c2.6-.2 4.4.1 5.6 1.1 1.2-1 3-1.3 5.6-1.1V3.1C11 2.9 9.2 3.2 8 4.2Z" />
                    <path d="M8 4.2v9.2" />
                  </>
                )}
                {f.icono === 'gente' && (
                  <>
                    <circle cx="6" cy="6" r="2.3" />
                    <path d="M1.8 13.2c0-2.2 1.9-3.6 4.2-3.6s4.2 1.4 4.2 3.6" stroke-linecap="round" />
                    <path d="M11 4.2a2.2 2.2 0 0 1 0 4.1M11.4 9.9c1.7.3 2.9 1.5 2.9 3.3" stroke-linecap="round" />
                  </>
                )}
            </svg>
            <span class="program-dato-et">{f.label}</span>
            <span class="program-dato-va">{f.value}</span>
          </li>
        ))}
      </ul>
      )}

      {
        !compacto && d.tools.length > 0 && (
          <p class="program-tools">
            {d.tools.map((t) => (
              <span class="program-tool">{t}</span>
            ))}
          </p>
        )
      }

      {!compacto && (
      <div class="program-foot">
        <p class="program-price tnum">
          {d.price.promo ? (
            <>
              <span class="program-price-now">
                {d.price.currency} {num(d.price.promo, 0)}
              </span>
              <span class="program-price-was muted">
                {d.price.currency} {num(d.price.total, 0)}
              </span>
            </>
          ) : (
            <span class="program-price-now">
              {d.price.currency} {num(d.price.total, 0)}
            </span>
          )}
        </p>

        <span class="btn btn-primary program-cta">
          Ver programa
          <svg class="arw" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M2 8h11M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </div>
      )}
    </div>
  </a>
</article>

<style>
  /* Esquinas redondas y sombra al acercarse, como las tarjetas de
     publicación: la oferta se hojea, y conviene que responda. */
  .program {
    height: 100%;
    overflow: hidden;
    border-radius: 22px;
    transition: transform 320ms cubic-bezier(0.22, 0.61, 0.36, 1),
      box-shadow 320ms ease, border-color 240ms ease;
  }
  .program:hover,
  .program:focus-within {
    transform: translateY(-5px);
    border-color: color-mix(in srgb, #008c85 45%, transparent);
    box-shadow: 0 26px 50px -30px rgb(3 26 36 / 0.55);
  }
  @media (prefers-reduced-motion: reduce) {
    .program:hover, .program:focus-within { transform: none; }
  }

  .program-link { display: flex; flex-direction: column; height: 100%; }
  .program-cuerpo {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 22px 24px 20px;
  }

  /* --- banda superior --- */
  .program-banda {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--color-ink);
  }
  .program-banda img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .program:hover .program-banda img { transform: scale(1.04); }

  .program-estado {
    position: absolute;
    top: 14px;
    left: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, #4fb3ac 45%, transparent);
    background: color-mix(in srgb, #031a24 62%, transparent);
    backdrop-filter: blur(6px);
    color: var(--color-paper);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .program-punto {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--color-teal-300);
  }

  /* --- cuerpo --- */
  /* La clase y el título van centrados: son el encabezado de la tarjeta y
     leen mejor como bloque, con el resto de la ficha alineado a la izquierda. */
  .program-clase {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-align: center;
    color: var(--color-gold);
  }

  .program-title {
    margin-top: 12px;
    text-align: center;
    text-wrap: balance;
    /* Tres líneas reservadas para que los bloques inferiores queden
       alineados entre tarjetas de distinta longitud de título. */
    min-height: 3.6em;
    font-size: clamp(1.16rem, 1.6vw, 1.38rem);
    line-height: 1.2;
  }

  .program-summary {
    margin-top: 10px;
    font-size: 13.5px;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-align: justify;
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  /* --- datos con icono ------------------------------------------------
     Cada dato es un bloque de tres piezas: el icono a la izquierda, y a su
     derecha el rótulo sobre el valor. El icono ocupa su propia columna y se
     centra contra las dos líneas, así los cuatro bloques quedan alineados
     entre sí. Antes el valor colgaba con una sangría fija y el conjunto se
     leía descuadrado. */
  .program-datos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px 22px;
    margin: 20px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--line, var(--line-light));
    list-style: none;
  }
  .program-datos li {
    display: grid;
    grid-template-columns: 17px minmax(0, 1fr);
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: 10px;
  }
  .program-icono {
    grid-column: 1;
    grid-row: 1 / 3;
    align-self: center;
    color: var(--color-teal-600);
  }
  :global(.surface-dark) .program-icono,
  :global(.surface-deep) .program-icono { color: var(--color-teal-300); }

  .program-dato-et {
    grid-column: 2;
    grid-row: 1;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .program-dato-va {
    grid-column: 2;
    grid-row: 2;
    margin-top: 3px;
    font-size: 13px;
    line-height: 1.35;
  }

  /* --- herramientas --- */
  .program-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 18px;
  }
  .program-tool {
    padding: 5px 11px;
    border-radius: 999px;
    background: color-mix(in srgb, #008c85 10%, transparent);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-teal-600);
  }
  :global(.surface-dark) .program-tool,
  :global(.surface-deep) .program-tool {
    background: color-mix(in srgb, #4fb3ac 14%, transparent);
    color: var(--color-teal-300);
  }

  /* --- pie --- */
  .program-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: auto;
    padding-top: 20px;
  }
  .program-price { display: flex; align-items: baseline; gap: 10px; }
  .program-price-now {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .program-price-was {
    font-size: 12.5px;
    text-decoration: line-through;
  }
  .program-cta { padding: 10px 16px; font-size: 12px; }

  /* --- modo compacto: solo la imagen y el título --- */
  .is-compacto .program-cuerpo { padding: 16px 18px 20px; }
  .is-compacto .program-title {
    margin-top: 8px;
    min-height: 0;
    font-size: 1.02rem;
    line-height: 1.25;
  }
  .is-compacto .program-clase { font-size: 9.5px; }
</style>
