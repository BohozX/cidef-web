---
import { site } from '../site.config';
import { withBase, withBaseSrcset } from '../lib/url';

/**
 * Portada.
 *
 * Solo el mensaje del centro, sobre la fotografía nocturna del Illimani.
 * Sin botones, sin publicaciones, sin datos: lo primero que se ve es a qué se
 * dedica este centro y nada más. El texto se apoya abajo, sobre la ciudad,
 * para no taparle la cumbre a la montaña; la imagen deriva muy despacio.
 */
---

<section class="hero" data-parallax-scope aria-labelledby="hero-title">
  <div class="hero-media">
    <picture class="hero-pic" data-hero-backdrop data-parallax="5">
      <source type="image/avif" srcset={withBaseSrcset(site.hero.srcset.avif)} sizes="100vw" />
      <source type="image/webp" srcset={withBaseSrcset(site.hero.srcset.webp)} sizes="100vw" />
      <img
        src={withBase(site.hero.src)}
        srcset={withBaseSrcset(site.hero.srcset.jpg)}
        sizes="100vw"
        alt={site.hero.alt}
        class="hero-img"
        fetchpriority="high"
        decoding="async"
        width={site.hero.width}
        height={site.hero.height}
      />
    </picture>

    <div class="hero-veil" aria-hidden="true"></div>
  </div>

  <div class="wrap hero-inner">
    <h1 id="hero-title" class="display-1 hero-title" data-hero-item>
      Investigamos la economía boliviana desde los datos
    </h1>

    <p class="hero-lede" data-hero-item>
      Estudios, indicadores y análisis independientes para comprender mejor
      sus dinámicas y transformaciones.
    </p>
  </div>

  <div class="hero-scroll" aria-hidden="true" data-hero-item>
    <span class="hero-scroll-line"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 94vh;
    min-height: 94svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* El mensaje va abajo, sobre la ciudad. Centrado se le echaba encima al
       Illimani y el antetítulo dorado se perdía contra la nieve. */
    justify-content: flex-end;
    padding: 140px 0 clamp(112px, 17vh, 178px);
    background: var(--color-ink);
    color: var(--color-paper);
    --line: var(--line-dark);
    overflow: clip;
    border-bottom-left-radius: clamp(48px, 11vw, 168px);
    border-bottom-right-radius: clamp(48px, 11vw, 168px);
  }

  .hero-media { position: absolute; inset: -4% 0; z-index: 0; }

  /* Anclada arriba: lo que sobra se recorta por abajo —la ladera del primer
     plano— y el Illimani se ve entero, con su cielo. */
  .hero-pic,
  .hero-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0%;
  }

  /* Movimiento continuo de la fotografía: acercamiento muy lento con una
     deriva mínima. La animación va en el <img> y el parallax en el
     <picture>, para que las dos transformaciones no compitan. */
  .hero-img {
    transform-origin: 52% 42%;
    animation: illimani 44s ease-in-out infinite alternate;
    will-change: transform;
  }

  /* La escala se queda fija: ampliar por CSS ablanda la nieve del Illimani,
     y lo que da vida a la portada es la deriva, no el zoom. El 1,5 % de más
     existe solo para que haya margen por donde derivar sin descubrir borde. */
  @keyframes illimani {
    from { transform: scale(1.015) translate3d(-0.5%, 0.35%, 0); }
    to   { transform: scale(1.015) translate3d(0.5%, -0.35%, 0); }
  }

  /* Lo que va encima de la fotografía, y solo eso:
     — el cielo, teñido del azul noche del centro (#031A24). Sin esto la
       portada la manda el azul del cielo del Illimani, que es otro azul y no
       es el de la marca. El tinte se apaga antes de llegar a la cumbre, así
       que la nieve y la ciudad siguen tal cual salieron de la cámara.
     — dos sombras localizadas, detrás del texto y al pie donde apoya la
       curva, para que el blanco se lea. */
  .hero-veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        52% 28% at 50% 74%,
        rgba(3, 26, 36, 0.6) 0%,
        rgba(3, 26, 36, 0.26) 58%,
        rgba(3, 26, 36, 0) 100%
      ),
      linear-gradient(
        to bottom,
        rgba(3, 26, 36, 0.92) 0%,
        rgba(3, 26, 36, 0.74) 12%,
        rgba(3, 26, 36, 0.4) 24%,
        rgba(3, 26, 36, 0.12) 33%,
        rgba(3, 26, 36, 0) 42%,
        rgba(3, 26, 36, 0) 74%,
        rgba(3, 26, 36, 0.66) 92%,
        rgba(3, 26, 36, 0.9) 100%
      );
  }

  /* --- contenido, centrado --- */
  .hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-title { max-width: 21ch; }

  .hero-lede {
    margin-top: clamp(20px, 2.4vw, 30px);
    max-width: 52ch;
    font-size: clamp(1.02rem, 1.35vw, 1.2rem);
    line-height: 1.66;
    color: color-mix(in srgb, #f5f3ed 82%, transparent);
  }

  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: clamp(30px, 5vh, 56px);
    translate: -50% 0;
    z-index: 1;
  }
  .hero-scroll-line {
    display: block;
    width: 1px;
    height: 54px;
    background: linear-gradient(
      to bottom,
      rgba(245, 243, 237, 0) 0%,
      rgba(245, 243, 237, 0.5) 45%,
      rgba(245, 243, 237, 0) 100%
    );
    transform-origin: top center;
    animation: scrollHint 3s ease-in-out infinite;
  }

  @keyframes scrollHint {
    0%, 100% { transform: scaleY(0.4); opacity: 0.4; }
    50% { transform: scaleY(1); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-img,
    .hero-scroll-line {
      animation: none;
      transform: none;
    }
  }
</style>
