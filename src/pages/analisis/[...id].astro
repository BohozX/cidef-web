---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ResearchCard from '../../components/ResearchCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { site } from '../../site.config';
import { apaAuthors, authorList, familyName, longDate, year } from '../../lib/format';

export const getStaticPaths: GetStaticPaths = async () => {
  const items = await getCollection('publicaciones');
  return items.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
};

export interface Props {
  entry: CollectionEntry<'publicaciones'>;
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const iso = d.date.toISOString();
const y = year(iso);
const url = new URL(`/analisis/${entry.id}`, Astro.site ?? site.url).toString();

/* ------------------------------------------------------------- citación -- */
const apa = `${apaAuthors(d.authors)} (${y}). ${d.title}${d.serial ? ` (${d.type} ${d.serial})` : ''}. ${site.name}. ${d.externalUrl ?? url}`;

const bibKey = `${familyName(d.authors[0] ?? 'cidef').toLowerCase().replace(/[^a-z]/g, '')}${y}`;
const bibtex = [
  `@techreport{${bibKey},`,
  `  author      = {${d.authors.join(' and ')}},`,
  `  title       = {${d.title}},`,
  `  institution = {${site.legalName}},`,
  `  type        = {${d.type}},`,
  d.serial ? `  number      = {${d.serial.replace(/[^\d]/g, '')}},` : '',
  `  year        = {${y}},`,
  `  address     = {La Paz, Bolivia},`,
  `  url         = {${d.externalUrl ?? url}}`,
  `}`,
]
  .filter(Boolean)
  .join('\n');

const ris = [
  'TY  - RPRT',
  ...d.authors.map((a) => `AU  - ${a}`),
  `TI  - ${d.title}`,
  `PY  - ${y}`,
  `DA  - ${iso.slice(0, 10).replace(/-/g, '/')}`,
  `PB  - ${site.legalName}`,
  `CY  - La Paz, Bolivia`,
  ...d.keywords.map((k) => `KW  - ${k}`),
  `UR  - ${d.externalUrl ?? url}`,
  'ER  -',
].join('\n');

/* ---------------------------------------------------------- relacionados -- */
const all = await getCollection('publicaciones');
const related = all
  .filter((p) => p.id !== entry.id)
  .map((p) => ({
    p,
    score: p.data.topics.filter((t) => d.topics.includes(t)).length,
  }))
  .sort((a, b) => b.score - a.score || b.p.data.date.getTime() - a.p.data.date.getTime())
  .slice(0, 3)
  .map((r) => r.p);

const facts = [
  { label: 'Tipo', value: d.type },
  { label: 'Publicación', value: longDate(iso) },
  ...(d.serial ? [{ label: 'Serie', value: d.serial }] : []),
  ...(d.pages ? [{ label: 'Extensión', value: `${d.pages} pp.` }] : []),
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: d.title,
  abstract: d.abstract,
  datePublished: iso.slice(0, 10),
  inLanguage: 'es',
  keywords: d.keywords.join(', '),
  author: d.authors.map((name) => ({ '@type': 'Person', name })),
  publisher: { '@type': 'Organization', name: site.legalName },
  url,
  ...(d.externalUrl ? { sameAs: d.externalUrl } : {}),
};
---

<BaseLayout
  title={d.title}
  description={d.abstract.slice(0, 175)}
  ogType="article"
  jsonLd={jsonLd}
>
  <PageHero
    eyebrow={`${d.type}${d.serial ? ` · ${d.serial}` : ''}`}
    title={d.title}
    parent={{ label: 'Análisis', href: '/analisis' }}
    facts={facts}
  >
    <div slot="actions" class="pub-authors" data-hero-item>
      <p class="pub-authors-list">{authorList(d.authors)}</p>
      {d.demo && <p class="pub-demo"><span class="chip chip-demo">Ficha de ejemplo</span></p>}
    </div>
  </PageHero>

  <article class="surface-light section">
    <div class="wrap">
      <div class="pub-grid">
        <!-- Columna principal ------------------------------------------- -->
        <div class="pub-main">
          <section aria-labelledby="resumen">
            <h2 id="resumen" class="eyebrow eyebrow-gold pub-h">Resumen</h2>
            <p class="pub-abstract">{d.abstract}</p>
          </section>

          {
            d.findings.length > 0 && (
              <section class="pub-block" aria-labelledby="hallazgos">
                <h2 id="hallazgos" class="eyebrow eyebrow-gold pub-h">Hallazgos principales</h2>
                <ol class="findings" data-reveal-group data-reveal-stagger="0.06">
                  {d.findings.map((f, i) => (
                    <li data-reveal>
                      <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
                      <span>{f}</span>
                    </li>
                  ))}
                </ol>
              </section>
            )
          }

          <section class="pub-block prose-cidef" aria-labelledby="contenido">
            <h2 id="contenido" class="eyebrow eyebrow-gold pub-h">Contenido</h2>
            <Content />
          </section>

          <!-- Citación ---------------------------------------------------- -->
          <section class="pub-block" aria-labelledby="citar">
            <h2 id="citar" class="eyebrow eyebrow-gold pub-h">Citar este trabajo</h2>

            <div class="cite" data-cite>
              <div class="cite-tabs" role="tablist" aria-label="Formato de cita">
                <button type="button" role="tab" class="cite-tab" data-cite-tab="apa" aria-selected="true">APA</button>
                <button type="button" role="tab" class="cite-tab" data-cite-tab="bibtex" aria-selected="false">BibTeX</button>
                <button type="button" role="tab" class="cite-tab" data-cite-tab="ris" aria-selected="false">RIS</button>
              </div>

              <pre class="cite-body" data-cite-panel="apa">{apa}</pre>
              <pre class="cite-body" data-cite-panel="bibtex" hidden>{bibtex}</pre>
              <pre class="cite-body" data-cite-panel="ris" hidden>{ris}</pre>

              <div class="cite-actions no-print">
                <button type="button" class="mini-btn" data-cite-copy>Copiar cita</button>
                <span class="cite-status" data-cite-status role="status" aria-live="polite"></span>
              </div>
            </div>
          </section>
        </div>

        <!-- Columna lateral ---------------------------------------------- -->
        <aside class="pub-side" aria-label="Ficha y descargas">
          {
            d.files.length > 0 && (
              <div class="side-block">
                <h2 class="eyebrow eyebrow-gold">Descargas</h2>
                <ul class="downloads">
                  {d.files.map((f) => (
                    <li>
                      <a href={f.href} class="download" rel="noopener">
                        <span class="download-label">{f.label}</span>
                        <span class="download-kind muted">{f.kind}</span>
                        <svg class="arw" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
                          <path d="M8 2v9M4.5 7.5 8 11l3.5-3.5M3 13.5h10" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </a>
                      {f.note && <p class="download-note muted">{f.note}</p>}
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          <div class="side-block">
            <h2 class="eyebrow eyebrow-gold">Ficha</h2>
            <dl class="side-dl">
              <div>
                <dt class="muted">Autores</dt>
                <dd>{authorList(d.authors)}</dd>
              </div>
              <div>
                <dt class="muted">Fecha</dt>
                <dd class="tnum">{longDate(iso)}</dd>
              </div>
              {d.topics.length > 0 && (
                <div>
                  <dt class="muted">Temas</dt>
                  <dd>{d.topics.join(' · ')}</dd>
                </div>
              )}
              {d.keywords.length > 0 && (
                <div>
                  <dt class="muted">Palabras clave</dt>
                  <dd>{d.keywords.join(' · ')}</dd>
                </div>
              )}
              {d.jel.length > 0 && (
                <div>
                  <dt class="muted">Códigos JEL</dt>
                  <dd class="tnum">{d.jel.join(' · ')}</dd>
                </div>
              )}
              {d.doi && (
                <div>
                  <dt class="muted">DOI</dt>
                  <dd class="tnum">{d.doi}</dd>
                </div>
              )}
            </dl>
          </div>
        </aside>
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="surface-tint section" aria-labelledby="relacionados">
        <div class="wrap">
          <div class="rule rule-draw"></div>
          <h2 id="relacionados" class="display-3 rel-title" data-reveal>Análisis relacionados</h2>
          <div class="rel-grid" data-reveal-group data-reveal-stagger="0.08">
            {related.map((item) => <ResearchCard item={item} view="grid" />)}
          </div>
        </div>
      </section>
    )
  }

  <Newsletter />
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-cite]');
  if (root) {
    const status = root.querySelector<HTMLElement>('[data-cite-status]');

    const activeFormat = (): string =>
      root.querySelector<HTMLButtonElement>('[data-cite-tab][aria-selected="true"]')?.dataset
        .citeTab ?? 'apa';

    root.querySelectorAll<HTMLButtonElement>('[data-cite-tab]').forEach((tab) => {
      tab.addEventListener('click', () => {
        root.querySelectorAll<HTMLButtonElement>('[data-cite-tab]').forEach((t) =>
          t.setAttribute('aria-selected', String(t === tab)),
        );
        root.querySelectorAll<HTMLElement>('[data-cite-panel]').forEach((panel) => {
          panel.hidden = panel.dataset.citePanel !== tab.dataset.citeTab;
        });
      });
    });

    root.querySelector<HTMLButtonElement>('[data-cite-copy]')?.addEventListener('click', async () => {
      const panel = root.querySelector<HTMLElement>(`[data-cite-panel="${activeFormat()}"]`);
      if (!panel || !status) return;
      try {
        await navigator.clipboard.writeText(panel.textContent ?? '');
        status.textContent = 'Cita copiada';
      } catch {
        status.textContent = 'No se pudo copiar. Selecciona el texto manualmente.';
      }
      window.setTimeout(() => (status.textContent = ''), 2600);
    });
  }
</script>

<style>
  .pub-authors { margin-top: 24px; }
  .pub-authors-list {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--color-gold);
  }
  .pub-demo { margin-top: 12px; }

  .pub-grid {
    display: grid;
    gap: 44px;
  }
  @media (min-width: 1000px) {
    .pub-grid {
      grid-template-columns: minmax(0, 1fr) 310px;
      gap: 72px;
      align-items: start;
    }
  }

  .pub-h { display: block; margin-bottom: 16px; }
  .pub-block { margin-top: clamp(40px, 5vw, 62px); }

  .pub-abstract {
    font-family: var(--font-display);
    font-size: clamp(1.12rem, 1.7vw, 1.34rem);
    line-height: 1.55;
    max-width: 60ch;
  }

  .findings { list-style: none; margin: 0; padding: 0; }
  .findings li {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    gap: 14px;
    padding-block: 16px;
    border-top: 1px solid var(--line-light);
    font-size: 15px;
    line-height: 1.6;
  }
  .findings li:last-child { border-bottom: 1px solid var(--line-light); }

  /* --- citación --- */
  .cite { border: 1px solid var(--line-light); border-radius: var(--radius-md); overflow: hidden; }
  .cite-tabs { display: flex; border-bottom: 1px solid var(--line-light); }
  .cite-tab {
    padding: 11px 18px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: transparent;
    border: 0;
    border-right: 1px solid var(--line-light);
    color: inherit;
    cursor: pointer;
    transition: background-color 180ms ease, color 180ms ease;
  }
  .cite-tab[aria-selected='true'] { background: var(--color-ink); color: var(--color-paper); }

  .cite-body {
    margin: 0;
    padding: 20px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.65;
    white-space: pre-wrap;
    word-break: break-word;
    background: color-mix(in srgb, #031a24 3%, transparent);
  }

  .cite-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 20px;
    border-top: 1px solid var(--line-light);
  }
  .mini-btn {
    padding: 6px 12px;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    border: 1px solid var(--line-light);
    border-radius: var(--radius-xs);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .mini-btn:hover { border-color: currentColor; }
  .cite-status { font-size: 12px; color: var(--color-teal-600); }

  /* --- lateral --- */
  .pub-side { display: grid; gap: 34px; }
  @media (min-width: 1000px) {
    .pub-side { position: sticky; top: 96px; }
  }
  .side-block h2 { display: block; margin-bottom: 14px; }

  .downloads { list-style: none; margin: 0; padding: 0; }
  .downloads li { border-top: 1px solid var(--line-light); }
  .downloads li:last-child { border-bottom: 1px solid var(--line-light); }
  .download {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 12px;
    padding-block: 14px;
    transition: transform 200ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .download:hover { transform: translateX(3px); }
  .download-label { font-size: 13.5px; font-weight: 500; }
  .download-kind {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  .download .arw { color: var(--color-gold); }
  .download-note { font-size: 11.5px; padding-bottom: 12px; }

  .side-dl { display: grid; gap: 16px; margin: 0; font-size: 13.5px; }
  .side-dl dt {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    margin-bottom: 5px;
  }
  .side-dl dd { margin: 0; line-height: 1.5; }

  /* --- relacionados --- */
  .rel-title { margin: 26px 0 34px; }
  .rel-grid { display: grid; gap: 16px; }
  @media (min-width: 760px) { .rel-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
