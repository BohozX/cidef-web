---
import { withBase } from '../lib/url';
import { getCollection } from 'astro:content';
import { authorList, longDate } from '../lib/format';

/**
 * Publicación destacada. Se integra editorialmente con la portada:
 * no es una tarjeta suelta, es la continuación del bloque oscuro.
 */

const all = await getCollection('publicaciones');
const item =
  all.find((p) => p.data.featured) ??
  all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];

const abstract = item
  ? `${item.data.abstract.trim().split(/(?<=\.)\s+/).slice(0, 2).join(' ')}`
  : '';
---

{
  item && (
    <section class="surface-deep featured" aria-labelledby="featured-title">
      <div class="wrap">

        <div class="featured-grid">
          <div class="featured-main">
            <p class="featured-kicker" data-reveal>
              <span class="chip chip-gold">{item.data.type}</span>
              {item.data.serial && <span class="eyebrow muted">{item.data.serial}</span>}
              <time class="eyebrow muted" datetime={item.data.date.toISOString()}>
                {longDate(item.data.date.toISOString())}
              </time>
            </p>

            <h2 id="featured-title" class="display-3 featured-title" data-reveal>
              <a href={withBase(`/publicaciones/${item.id}`)}>{item.data.title}</a>
            </h2>

            <p class="featured-authors" data-reveal>{authorList(item.data.authors)}</p>

            <p class="featured-abstract muted" data-reveal>{abstract}</p>

            <div class="featured-actions" data-reveal>
              <a href={withBase(`/publicaciones/${item.id}`)} class="btn btn-primary">
                Leer documento
                <svg class="arw" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M2 8h11M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
              <a href={withBase('/publicaciones')} class="link-arrow">
                Todas las publicaciones
                <svg class="arw" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
                  <path d="M2 8h11M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </div>
          </div>

          <aside class="featured-side" data-reveal aria-label="Ficha de la publicación">
            <dl>
              <div>
                <dt class="eyebrow muted">Temas</dt>
                <dd>{item.data.topics.join(' · ')}</dd>
              </div>
              {item.data.jel.length > 0 && (
                <div>
                  <dt class="eyebrow muted">Códigos JEL</dt>
                  <dd class="tnum">{item.data.jel.join(' · ')}</dd>
                </div>
              )}
              {item.data.pages && (
                <div>
                  <dt class="eyebrow muted">Extensión</dt>
                  <dd class="tnum">{item.data.pages} páginas</dd>
                </div>
              )}
              <div>
                <dt class="eyebrow muted">Palabras clave</dt>
                <dd>{item.data.keywords.slice(0, 4).join(' · ')}</dd>
              </div>
            </dl>
          </aside>
        </div>
      </div>
    </section>
  )
}

<style>
  .featured { padding-block: clamp(40px, 5vw, 68px) clamp(56px, 7vw, 96px); }

  .featured-grid {
    display: grid;
    gap: 34px;
    padding-top: 28px;
  }
  @media (min-width: 980px) {
    .featured-grid {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 0.85fr);
      gap: 64px;
    }
  }

  .featured-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
  }

  .featured-title {
    margin-top: 20px;
    max-width: 26ch;
  }
  .featured-title a {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-repeat: no-repeat;
    background-position: left 100%;
    transition: background-size 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .featured-title a:hover { background-size: 100% 1px; }

  .featured-authors {
    margin-top: 16px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-gold);
  }

  .featured-abstract {
    margin-top: 16px;
    max-width: 62ch;
    font-size: 15px;
    line-height: 1.65;
  }

  .featured-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 30px;
  }

  .featured-side {
    border-top: 1px solid var(--line-dark);
    padding-top: 22px;
  }
  @media (min-width: 980px) {
    .featured-side {
      border-top: 0;
      border-left: 1px solid var(--line-dark);
      padding: 4px 0 4px 34px;
    }
  }
  .featured-side dl { display: grid; gap: 20px; margin: 0; }
  .featured-side dt { margin-bottom: 6px; }
  .featured-side dd { margin: 0; font-size: 13.5px; line-height: 1.5; }
</style>
