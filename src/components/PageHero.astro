---
import type { Cover } from '../site.config';
import { withBase } from '../lib/url';

/**
 * Cabecera de página.
 *
 * Dos registros según lo que se le pase:
 *
 *  — Con `cover`, abre como la portada del sitio: imagen a sangre, mensaje
 *    centrado y el pie curvado. Es el registro de las secciones principales.
 *  — Sin `cover`, la cabecera sobria alineada a la izquierda. Es la de las
 *    fichas —un documento, un programa, un evento—, que llevan título largo
 *    y migas de pan y no deben competir con la sección que las contiene.
 */

export interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  /** Migas de pan opcionales. */
  parent?: { label: string; href: string };
  /** Datos de cabecera: pares etiqueta / valor. */
  facts?: { label: string; value: string }[];
  /** Imagen a sangre. Su ausencia deja la cabecera sobria. */
  cover?: Cover;
  /**
   * La curva del pie descubre el papel de la sección siguiente. Cuando esa
   * sección también es oscura no hay nada que descubrir y el recorte deja una
   * franja clara suelta: ahí conviene apagarla.
   */
  curve?: boolean;
}

const { eyebrow, title, lede, parent, facts = [], cover, curve = true } = Astro.props;
---

<section
  class:list={[
    'page-hero',
    cover ? 'has-cover' : 'surface-deep',
    cover && !curve && 'is-flush',
    /* Con migas de pan es una ficha, no una sección: abre más corta para que
       el contenido no quede a una pantalla entera de distancia. */
    cover && parent && 'is-ficha',
  ]}
  data-parallax-scope={cover ? '' : undefined}
>
  {
    cover && (
      <div class="cover-media">
        <picture class="cover-pic" data-parallax="4">
          <source type="image/avif" srcset={cover.srcset.avif} sizes="100vw" />
          <source type="image/webp" srcset={cover.srcset.webp} sizes="100vw" />
          <img
            src={cover.src}
            srcset={cover.srcset.jpg}
            sizes="100vw"
            alt={cover.alt}
            class="cover-img"
            fetchpriority="high"
            decoding="async"
            width={cover.width}
            height={cover.height}
          />
        </picture>
        <div class="cover-veil" aria-hidden="true" />
      </div>
    )
  }

  <div class="wrap page-hero-inner">
    {
      parent && (
        <nav class="page-crumb" aria-label="Ruta de navegación">
          <a href={withBase(parent.href)} class="link-arrow page-crumb-link">
            <svg class="arw" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
              <path d="M14 8H3M7 4L3 8l4 4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {parent.label}
          </a>
        </nav>
      )
    }

    <p class="eyebrow eyebrow-gold page-eyebrow" data-hero-item>{eyebrow}</p>
    <h1 class:list={['display-1', 'page-title', title.length > 58 && 'is-long']} data-hero-item>{title}</h1>
    {lede && <p class="lede page-lede" data-hero-item>{lede}</p>}

    <slot name="actions" />

    {
      facts.length > 0 && (
        <dl class="page-facts" data-hero-item>
          {facts.map((f) => (
            <div>
              <dt class="eyebrow muted">{f.label}</dt>
              <dd class="tnum">{f.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    padding-top: clamp(104px, 13vh, 158px);
    padding-bottom: 0;
  }

  .page-crumb { margin-bottom: 26px; }
  .page-crumb-link .arw { transition: transform 240ms cubic-bezier(0.22, 0.61, 0.36, 1); }
  .page-crumb-link:hover .arw { transform: translateX(-4px); }

  .page-title {
    margin-top: 20px;
    max-width: 18ch;
  }
  /* Los titulos largos (publicaciones academicas) bajan de escala para no
     dominar la pagina ni romper el ritmo de lectura. */
  .page-title.is-long {
    font-size: clamp(2.1rem, 4.2vw, 3.4rem);
    line-height: 1.08;
    max-width: 24ch;
  }

  .page-lede {
    margin-top: 22px;
    max-width: 56ch;
    color: color-mix(in srgb, #f5f3ed 78%, transparent);
  }

  .page-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px 24px;
    margin-top: 40px;
    max-width: 760px;
  }
  @media (min-width: 720px) {
    .page-facts { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .page-facts dt { margin-bottom: 7px; }
  .page-facts dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.24rem;
    letter-spacing: -0.01em;
  }

  /* --- con imagen a sangre ------------------------------------------------
     Mismo registro que la portada del sitio: la imagen manda, el texto se
     apoya abajo sobre la zona tranquila y el bloque se cierra con la curva. */
  /* El mismo alto que la portada del sitio: las secciones abren con el mismo
     peso que el inicio y el paso de una a otra no da tumbos. */
  .has-cover {
    position: relative;
    min-height: 94vh;
    min-height: 94svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-bottom: clamp(56px, 8vh, 104px);
    background: var(--color-ink);
    color: var(--color-paper);
    --line: var(--line-dark);
    --muted: color-mix(in srgb, #f5f3ed 62%, transparent);
    overflow: clip;
    border-bottom-left-radius: clamp(48px, 11vw, 168px);
    border-bottom-right-radius: clamp(48px, 11vw, 168px);
  }
  .has-cover.is-ficha {
    min-height: 68vh;
    min-height: 68svh;
    padding-top: clamp(118px, 10vh, 138px);
    padding-bottom: clamp(44px, 5vh, 72px);
  }
  .has-cover.is-flush {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    padding-bottom: clamp(48px, 6vh, 84px);
  }
  /* Cabecera sobria: todo alineado al margen izquierdo. El centrado es del
     registro con portada; aquí dejaba el antetítulo y la entradilla flotando
     sobre un título pegado al margen. */
  .page-hero:not(.has-cover) .page-hero-inner p { text-align: left; }

  .has-cover .page-hero-inner {
    position: relative;
    z-index: 1;
    text-align: center;
  }
  .has-cover .page-title,
  .has-cover .page-lede {
    margin-inline: auto;
  }
  /* En fila y centradas: con la retícula de cuatro columnas, dos o tres
     cifras se quedaban apelotonadas a la izquierda. */
  .has-cover .page-facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 22px clamp(36px, 6vw, 84px);
    margin-inline: auto;
    text-align: center;
  }
  .has-cover .page-crumb { display: flex; justify-content: center; }

  .cover-media { position: absolute; inset: -4% 0; z-index: 0; }
  .cover-pic,
  .cover-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  /* Solo lo justo para que el blanco se lea: una sombra bajo el texto y otra
     al pie, donde apoya la curva. La imagen no se tiñe entera. */
  /* La sombra cubre el bloque entero de texto, antetítulo incluido: estas
     fotografías tienen zonas claras justo ahí —una pantalla encendida, una
     pared blanca— y el dorado del antetítulo desaparecía contra ellas. */
  .cover-veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        64% 46% at 50% 70%,
        rgba(3, 26, 36, 0.74) 0%,
        rgba(3, 26, 36, 0.42) 54%,
        rgba(3, 26, 36, 0) 100%
      ),
      linear-gradient(
        to bottom,
        rgba(3, 26, 36, 0.86) 0%,
        rgba(3, 26, 36, 0.44) 22%,
        rgba(3, 26, 36, 0.18) 40%,
        rgba(3, 26, 36, 0.58) 84%,
        rgba(3, 26, 36, 0.9) 100%
      );
  }
</style>
